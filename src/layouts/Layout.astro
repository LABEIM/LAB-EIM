---
import '../styles/globals.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import siteData from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = siteData.defaultTitle,
  description = siteData.defaultDescription,
  keywords = siteData.defaultKeywords,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" data-scroll-behavior="smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {/* Dynamic favicon type helper */}
    {(() => {
      const fav = siteData.favicon;
      let type = 'image/x-icon';
      if (fav.endsWith('.png')) type = 'image/png';
      else if (fav.endsWith('.svg')) type = 'image/svg+xml';
      else if (fav.endsWith('.avif')) type = 'image/avif';
      return <link rel="icon" type={type} href={fav} />;
    })()}
    
    {/* Preconnect to Font origins for early connection establishment */}
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    {/* FontAwesome custom subset icons */}
    <script>
      import '../styles/icons.css';
    </script>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
