---
import type { SelectionStepConfig } from '../../utils/types';

interface Props {
  activeStepIndex?: number;
  activeStage?: string;
  markCurrentAsCompleted?: boolean;
  selectionSteps?: SelectionStepConfig[];
}

const { activeStepIndex, activeStage, markCurrentAsCompleted = false, selectionSteps = [] } = Astro.props;

const enabledCustomSteps = (selectionSteps || []).filter((s) => s.enabled !== false);

let steps: Array<{ id: string; label: string; index: number; icon?: string }> = [];

if (enabledCustomSteps.length > 0) {
  steps.push({ id: 'open', label: '1. Pendaftaran Berkas', index: 1, icon: 'fa-solid fa-file-arrow-up' });

  enabledCustomSteps.forEach((step, idx) => {
    const stepNum = idx + 2;
    steps.push({
      id: step.id,
      label: `${stepNum}. ${step.shortLabel || step.title}`,
      index: stepNum,
      icon: step.icon || 'fa-solid fa-clipboard-list',
    });
  });

  const finalNum = enabledCustomSteps.length + 2;
  steps.push({ id: 'announcement', label: `${finalNum}. Pengumuman Kelulusan`, index: finalNum, icon: 'fa-solid fa-trophy' });
} else {
  steps = [
    { id: 'open', label: "1. Pendaftaran Berkas", index: 1 },
    { id: 'selection', label: "2. Seleksi Berkas", index: 2 },
    { id: 'technical_test', label: "3. Tes Teknikal", index: 3 },
    { id: 'interview', label: "4. Tahap Wawancara", index: 4 },
    { id: 'announcement', label: "5. Pengumuman Kelulusan", index: 5 },
  ];
}

// Compute active step index if activeStage string is provided instead of numeric index
let computedIndex = activeStepIndex || 1;
if (activeStage) {
  if (activeStage === 'upcoming' || activeStage === 'open' || activeStage === 'extended' || activeStage === 'fallback') {
    computedIndex = 1;
  } else if (activeStage === 'announcement') {
    computedIndex = steps.length;
  } else {
    // Match stage against dynamic step IDs (or step_results)
    const matchIdx = steps.findIndex((s) => activeStage === s.id || activeStage === `${s.id}_results`);
    if (matchIdx !== -1) {
      computedIndex = steps[matchIdx].index;
    }
  }
}
---

<div class="timeline-indicator-grid">
  {steps.map((step) => {
    const isCompleted = computedIndex > step.index || (markCurrentAsCompleted && computedIndex === step.index);
    const status = isCompleted
      ? "completed" 
      : computedIndex === step.index 
        ? "active" 
        : "upcoming";
    return (
      <div class={`timeline-step-card ${status}`}>
        <div class={`timeline-step-icon ${status}`}>
          {status === 'completed' && <i class="fa-solid fa-circle-check"></i>}
          {status === 'active' && <i class="fa-solid fa-spinner fa-spin"></i>}
          {status === 'upcoming' && <i class="fa-solid fa-clock"></i>}
        </div>
        <div class={`timeline-step-label ${status === 'upcoming' ? 'muted' : 'primary'}`}>{step.label}</div>
      </div>
    );
  })}
</div>

