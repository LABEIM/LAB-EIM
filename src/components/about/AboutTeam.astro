---
import type { DivisionConfig, Member } from '../../utils/types';
import { getDivisionInfo } from '../../utils/division-mapper';
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  coordinators: Member[];
  divisions: DivisionConfig[];
}

const { coordinators, divisions } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
---

<section id="koordinator" class="py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="about-team-title">
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">{t('about.teamEyebrow', locale)}</p>
        <h2
          id="about-team-title"
          class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
        >
          {t('about.teamTitle', locale)}
        </h2>
      </div>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('about.teamIntro', locale, { n: String(coordinators.length), d: String(divisions.length) })}
      </p>
    </div>

    <ul class="e-reveal-group mt-[clamp(2.5rem,6vh,4.5rem)] list-none border-t border-line">
      {coordinators.map((member, index) => {
        const divisionName = getDivisionInfo(member.division, divisions)?.displayName ?? member.division;
        return (
          <li
            style={`--i:${index}`}
            class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-x-4 gap-y-1 border-b border-line py-6 md:grid-cols-[4rem_minmax(0,1.3fr)_minmax(0,1fr)] md:gap-x-8"
          >
            <span class="font-mono text-xs tracking-[0.08em] text-muted-ink" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="font-display text-[clamp(1.4rem,2.4vw,2rem)] leading-[1.1]">{member.name}</span>
            <span class="col-span-2 font-mono text-xs uppercase tracking-[0.08em] text-muted-ink md:col-span-1 md:justify-self-end">
              {member.role} · {divisionName}
            </span>
          </li>
        );
      })}
    </ul>

    <a href="/structure" class="mt-8 inline-flex items-center gap-2 py-2 font-mono text-xs uppercase tracking-[0.08em] text-brand">
      {t('about.teamLink', locale)} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
