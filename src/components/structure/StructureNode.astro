---
import type { Position } from '../../utils/types';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';

interface Props {
  position: Position;
  locale: Locale;
}

const { position, locale } = Astro.props;

const GROUP_KEYS: Record<string, string> = {
  dosen: 'struct.groupDosen',
  asisten: 'struct.groupAsisten',
  mahasiswa: 'struct.groupMahasiswa',
};
---

<div class="org-node">
  <span class="org-node-kicker">{t(GROUP_KEYS[position.group], locale)}</span>
  <span class="org-node-title">{position.label}</span>
</div>
