---
import { getLocaleFromUrl } from '../../utils/i18n';

interface Props {
  activeStepIndex: number;
  markCurrentAsCompleted?: boolean;
}

const locale = getLocaleFromUrl(Astro.url);
const { activeStepIndex, markCurrentAsCompleted = false } = Astro.props;

const steps = [
  { label: locale === 'en' ? "1. Registration" : "1. Pendaftaran Berkas", index: 1 },
  { label: locale === 'en' ? "2. Document Screening" : "2. Seleksi Berkas", index: 2 },
  { label: locale === 'en' ? "3. Technical Test" : "3. Tes Teknikal", index: 3 },
  { label: locale === 'en' ? "4. Interview Phase" : "4. Tahap Wawancara", index: 4 },
  { label: locale === 'en' ? "5. Final Announcement" : "5. Pengumuman Kelulusan", index: 5 },
];
---

<div class="timeline-indicator-grid">
  {steps.map((step) => {
    const isCompleted = activeStepIndex > step.index || (markCurrentAsCompleted && activeStepIndex === step.index);
    const status = isCompleted
      ? "completed" 
      : activeStepIndex === step.index 
        ? "active" 
        : "upcoming";
    return (
      <div class={`timeline-step-card ${status}`}>
        <div class={`timeline-step-icon ${status}`}>
          {status === 'completed' && <i class="fa-solid fa-circle-check"></i>}
          {status === 'active' && <i class="fa-solid fa-spinner fa-spin"></i>}
          {status === 'upcoming' && <i class="fa-solid fa-clock"></i>}
        </div>
        <div class={`timeline-step-label ${status === 'upcoming' ? 'muted' : 'primary'}`}>{step.label}</div>
      </div>
    );
  })}
</div>
