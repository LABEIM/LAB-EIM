---
import type { Member } from '../../utils/types';

interface Props {
  member: Member;
  variant?: 'default' | 'featured';
  index?: number;
}

const { member, variant = 'default', index } = Astro.props;

const initials = member.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join('')
  .toUpperCase();
---

<article
  class:list={['member-tile', variant === 'featured' && 'member-tile--featured']}
  data-member-id={member.id}
  style={`--i:${index ?? 0}`}
>
  <div class="member-tile-media">
    {member.image ? (
      <img
        src={member.image}
        alt=""
        loading="lazy"
        decoding="async"
        style={`transform: scale(${member.scale ?? '1'}); transform-origin: ${member.position ?? 'center'};`}
      />
    ) : (
      <span class="member-tile-fallback" aria-hidden="true">{initials}</span>
    )}
  </div>
  <div class="member-tile-body">
    <h3 class="member-tile-name">{member.name}</h3>
    <p class="member-tile-role">{member.role}</p>
  </div>
</article>
