---
import { Image } from 'astro:assets';
import siteData from '../data/site.json';
import logoImg from '../../public/image/eim/logo_EIM_crop.avif';

const pathname = Astro.url.pathname;
const cleanPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/structure', label: 'Structure' },
  { href: '/event', label: 'Event' },
  { href: '/news', label: 'News' },
  { href: '/registration', label: 'Registration' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return cleanPath === '/';
  }
  return cleanPath.startsWith(href);
};
---

<nav class="navbar" id="navbar">
  <div class="container">
    <a href="/" class="logo-container">
      <div class="logo-icon">
        <Image src={logoImg} alt={`${siteData.name} Logo`} width={62} height={70} />
      </div>
      <div class="logo-text">
        <span class="text-gradient-dual">{siteData.name}</span>
        <span class="logo-sub">{siteData.subName}</span>
      </div>
    </a>

    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li class={isActive(link.href) ? 'active' : ''}>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav-toggle" id="nav-toggle">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<script>
  import { initNavbar } from '../scripts/components/navbar';
  initNavbar();
</script>
