---
import { getLocaleFromUrl, getLocalizedJsonData } from '../../utils/i18n';
import type { ChromeData } from '../../utils/types';

const locale = getLocaleFromUrl(Astro.url);
const labels = getLocalizedJsonData<ChromeData>('chrome', locale).ui.pagination;
---

<div class="pagination-container" id="pagination-container" style="display: none;">
  <div class="pagination-controls" id="pagination-controls">
    <button
      type="button"
      class="pagination-btn"
      id="pagination-prev"
      disabled
      title={labels.previous}
      aria-label={labels.previousAria}
    >
      <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
    </button>
    <div id="pagination-numbers" style="display: inline-flex; gap: 6px;">
      <!-- Dynamic page buttons inserted by content-filter.ts -->
    </div>
    <button
      type="button"
      class="pagination-btn"
      id="pagination-next"
      disabled
      title={labels.next}
      aria-label={labels.nextAria}
    >
      <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
    </button>
  </div>
  <div class="pagination-info" id="pagination-info" data-template={labels.info}>
    {labels.info.replaceAll('{page}', '1').replaceAll('{total}', '1')}
  </div>
</div>
