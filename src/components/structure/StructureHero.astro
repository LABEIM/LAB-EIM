---
import type { StructurePageData } from '../../utils/types';

interface Props {
  content: StructurePageData['hero'];
  memberCount: number;
  dosenCount: number;
  positionCount: number;
  showPrimary?: boolean;
}

const { content, memberCount, dosenCount, positionCount, showPrimary = true } = Astro.props;
const meta = (content.meta ?? '')
  .replaceAll('{members}', String(memberCount))
  .replaceAll('{dosen}', String(dosenCount))
  .replaceAll('{positions}', String(positionCount));
---

<section class="eim-hero eim-subhero" aria-labelledby="struct-hero-title">
  <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>
  <div class="eim-hero-inner">
    <p class="eim-eyebrow">{content.eyebrow}</p>
    <h1 id="struct-hero-title" class="eim-hero-title">
      {content.lines.map((line, index) => (
        <>
          <span class="eim-hero-title-line">{line}</span>{index < content.lines.length - 1 ? ' ' : ''}
        </>
      ))}
    </h1>
    <p class="eim-hero-desc">{content.description}</p>
    <div class="eim-hero-actions">
      {showPrimary && <a class="eim-hero-cta" href="#struktur">{content.primaryLabel}</a>}
      <a class="eim-hero-secondary" href="/courses">
        {content.secondaryLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="eim-subhero-meta">{meta}</p>
  </div>
</section>

<script>
  import { initTopologyField } from '../../scripts/topology-field';
  initTopologyField();
</script>
