---
import siteData from '../data/site.json';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a href="/" class="logo-container">
          <div class="logo-icon" style="width: 30px; height: 30px;">
            <img src={siteData.logo} alt={`${siteData.name} Logo`} width="30" height="30" />
          </div>
          <div class="logo-text">
            <span class="text-gradient-dual" style="font-size: 1.2rem;">{siteData.name}</span>
            <span class="logo-sub" style="font-size: 0.6rem; letter-spacing: 1px;">{siteData.subName}</span>
          </div>
        </a>
        <p>{siteData.fullName} is part of the Enterprise & Industrial System (EIS) Expertise Group, Bachelor of Information Systems Study Program, Faculty of Industrial Engineering, Telkom University.</p>
      </div>

      <div>
        <h4 class="footer-title">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/event">Event</a></li>
          <li><a href="/structure">Structure</a></li>
          <li><a href="/news">News</a></li>
          <li><a href="/registration">Registration</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-title">Contact & Location</h4>
        <ul class="footer-links" style="margin-bottom: 20px;">
          <li><i class="fa-solid fa-location-dot" style="margin-right: 8px; color: var(--accent-red);"></i> {siteData.contact.location}</li>
          <li><i class="fa-solid fa-university" style="margin-right: 8px; color: var(--accent-red);"></i> {siteData.contact.university}</li>
          <li><i class="fa-solid fa-envelope" style="margin-right: 8px; color: var(--accent-cyan);"></i> {siteData.contact.email}</li>
        </ul>
        <h4 class="footer-title" style="margin-bottom: 12px; font-size: 0.95rem;">Follow Our Social Media</h4>
        <div class="footer-connect-list">
          {siteData.socials.instagram && (
            <a href={siteData.socials.instagram} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="Instagram @eimresearchlab">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
          {siteData.socials.linkedin && (
            <a href={siteData.socials.linkedin} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="LinkedIn EIM Research Lab">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          )}
          {siteData.socials.line && (
            <a href={siteData.socials.line} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="LINE Official Account">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 5.86 2 10.62c0 4.25 3.535 7.82 8.312 8.49.324.07.765.21.876.49.1.25.065.64.032.89-.05.38-.23 1.49-.25 1.81-.03.5.23.68.49.52.26-.16 3.57-2.1 4.88-3.6 1.94-1.28 3.17-3.23 3.17-5.6C19.51 5.86 17.523 2 12 2zm-4.7 11.23h-1.4c-.23 0-.41-.18-.41-.41V8.58c0-.23.18-.41.41-.41s.41.18.41.41v4.42h.99c.23 0 .41.18.41.41s-.18.42-.41.42zm1.62-.41c0 .23-.18.41-.41.41s-.41-.18-.41-.41V8.58c0-.23.18-.41.41-.41s.41.18.41.41v4.24zm3.94 0c0 .19-.13.36-.31.4-.03.01-.07.01-.1.01-.16 0-.31-.09-.37-.24l-1.92-2.88v2.71c0 .23-.18.41-.41.41s-.41-.18-.41-.41V8.58c0-.19.13-.36.31-.4.19-.04.38.04.47.21l1.92 2.88V8.58c0-.23.18-.41.41-.41s.41.18.41.41v4.24zm3.24-2.83h-1.4v.99h1.4c.23 0 .41.18.41.41s-.18.41-.41.41h-1.81c-.23 0-.41-.18-.41-.41V8.58c0-.23.18-.41.41-.41h1.81c.23 0 .41.18.41.41s-.18.41-.41.41h-1.4v.99h1.4c.23 0 .41.18.41.41s-.18.41-.41.41z"/></svg>
            </a>
          )}
          {siteData.socials.youtube && (
            <a href={siteData.socials.youtube} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="YouTube EIM Research Lab">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
            </a>
          )}
        </div>

      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} {siteData.fullName}. All Rights Reserved.</p>
      <p>Designed with <i class="fa-solid fa-heart" style="color: var(--accent-red);"></i> in Telkom University</p>
    </div>
  </div>
</footer>
