---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home-eim.css';
import '../../styles/pages/kegiatan-eim.css';
import EimSectionNav from '../../components/home/EimSectionNav.astro';
import KegiatanHero from '../../components/kegiatan/KegiatanHero.astro';
import KegiatanList from '../../components/kegiatan/KegiatanList.astro';
import {
  getCollectionEntriesForLocale,
  getLocaleFromUrl,
  getLocalizedJsonData,
  t,
} from '../../utils/i18n';
import { filterAuditContent } from '../../utils/content-helpers';
import { compareEventDates, getEventDateMs } from '../../utils/event-helpers';

const locale = getLocaleFromUrl(Astro.url);

const rawEvents = await getCollection('events');
const events = filterAuditContent(getCollectionEntriesForLocale(rawEvents, locale))
  .slice()
  .sort((a, b) => compareEventDates(a, b, 'desc'));

const categories = [...new Set(events.map((event) => event.data.category).filter(Boolean))].sort();

const latestYear =
  events
    .map(getEventDateMs)
    .filter(Boolean)
    .map((ms) => String(new Date(ms).getUTCFullYear()))
    .sort((a, b) => b.localeCompare(a))[0] ?? null;

const sectionItems = [
  { id: 'kegiatan', label: t('nav.event', locale) },
  { id: 'daftar', label: t('events.navDotList', locale) },
];
---

<Layout
  title={`${t('nav.event', locale)} · EIM Research Lab`}
  description={t('events.metaDescription', locale)}
  homeSkin
  skipLink
>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={t('events.sectionNavLabel', locale)} />
    <KegiatanHero
      totalCount={events.length}
      categoryCount={categories.length}
      latestYear={latestYear}
    />
    <KegiatanList events={events} locale={locale} />
  </main>
</Layout>
