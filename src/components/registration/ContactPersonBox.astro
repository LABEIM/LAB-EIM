---
export interface ContactPerson {
  name: string;
  role: string;
  platform: 'whatsapp' | 'line' | 'email' | 'phone' | string;
  contactId: string;
  link: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  contactPersons?: ContactPerson[];
  compact?: boolean;
}

const {
  title = "Need Help or Have Questions?",
  subtitle = "Reach out directly to our recruitment contact persons for any inquiries during the recruitment process.",
  contactPersons = [],
  compact = false
} = Astro.props;

// Platform style mappings
const platformConfig: Record<string, { label: string; iconClass: string; color: string; bgColor: string }> = {
  whatsapp: {
    label: 'WhatsApp',
    iconClass: 'fa-brands fa-whatsapp',
    color: '#25D366',
    bgColor: 'rgba(37, 211, 102, 0.12)'
  },
  line: {
    label: 'LINE',
    iconClass: 'fa-brands fa-line',
    color: '#00C300',
    bgColor: 'rgba(0, 195, 0, 0.12)'
  },
  email: {
    label: 'Email',
    iconClass: 'fa-solid fa-envelope',
    color: '#EA4335',
    bgColor: 'rgba(234, 67, 53, 0.12)'
  },
  phone: {
    label: 'Phone',
    iconClass: 'fa-solid fa-phone',
    color: '#34A853',
    bgColor: 'rgba(52, 168, 83, 0.12)'
  }
};
---

{contactPersons && contactPersons.length > 0 && (
  <div class={`cp-box ${compact ? 'compact' : ''}`}>
    <div class="cp-header">
      <div class="cp-badge">
        <i class="fa-solid fa-headset" style="margin-right: 6px;"></i> Contact Person
      </div>
      <h3 class="cp-title">{title}</h3>
      {subtitle && <p class="cp-subtitle">{subtitle}</p>}
    </div>

    <div class="cp-cards-grid">
      {contactPersons.map((cp) => {
        const platKey = (cp.platform || 'whatsapp').toLowerCase();
        const platInfo = platformConfig[platKey] || platformConfig.whatsapp;

        return (
          <div class="cp-card" style={`--plat-color: ${platInfo.color}; --plat-bg: ${platInfo.bgColor};`}>
            <div class="cp-card-header">
              <span class="cp-role-badge">{cp.role || 'Contact Person'}</span>
              <div class="cp-plat-icon">
                <i class={platInfo.iconClass}></i>
              </div>
            </div>

            <div class="cp-card-body">
              <h4 class="cp-name">{cp.name}</h4>
              <p class="cp-id">{cp.contactId}</p>
            </div>

            {cp.link && (
              <a
                href={cp.link}
                target="_blank"
                rel="noopener noreferrer"
                class="cp-action-btn"
              >
                <span>Contact via {platInfo.label}</span>
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>
)}

<style>
  .cp-box {
    margin-top: 35px;
    padding: 28px 24px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
    border-radius: 12px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cp-box.compact {
    padding: 20px 16px;
    margin-top: 20px;
  }

  .cp-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
  }

  .cp-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin-bottom: 8px;
  }

  .cp-subtitle {
    font-size: 0.92rem;
    color: var(--text-secondary, #94a3b8);
    max-width: 540px;
    margin: 0 auto 22px auto;
    line-height: 1.5;
  }

  .cp-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    max-width: 850px;
    margin: 0 auto;
  }

  .cp-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--bg-card, rgba(20, 20, 25, 0.7));
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
    border-radius: 12px;
    text-align: left;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .cp-card:hover {
    transform: translateY(-4px);
    border-color: var(--plat-color);
    box-shadow: 0 10px 28px -8px var(--plat-bg);
  }

  .cp-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .cp-role-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--plat-bg);
    color: var(--plat-color);
    border: 1px solid var(--plat-bg);
    letter-spacing: 0.3px;
  }

  .cp-plat-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--plat-bg);
    color: var(--plat-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .cp-card-body {
    margin-bottom: 16px;
  }

  .cp-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin-bottom: 4px;
  }

  .cp-id {
    font-size: 0.85rem;
    color: var(--text-secondary, #94a3b8);
    margin: 0;
  }

  .cp-action-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--plat-bg);
    color: var(--plat-color);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    margin-top: auto;
  }

  .cp-action-btn:hover {
    background: var(--plat-color);
    color: #ffffff;
    border-color: var(--plat-color);
  }

  @media (max-width: 640px) {
    .cp-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
