---
import type { Lecturer, Member, PositionSection } from '../../utils/types';
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  sections: PositionSection<Member | Lecturer>[];
}

const { sections } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

const total = sections.reduce((sum, section) => sum + section.people.length, 0);
---

<section id="koordinator" class="py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="about-team-title">
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">{t('about.teamEyebrow', locale)}</p>
        <h2
          id="about-team-title"
          class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
        >
          {t('about.teamTitle', locale)}
        </h2>
      </div>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('about.teamIntro', locale, { n: String(total) })}
      </p>
    </div>

    <div class="e-reveal-group mt-[clamp(2.5rem,6vh,4rem)] border-t border-line">
      {sections.map((section, sectionIndex) => (
        <section class="py-8" aria-labelledby={`about-role-${section.position.id}`}>
          <h3
            id={`about-role-${section.position.id}`}
            class="font-mono text-xs uppercase tracking-[0.08em] text-brand"
          >
            {section.position.label} · {section.people.length}
          </h3>
          <ul class="mt-4 list-none border-t border-line p-0">
            {section.people.map((person, index) => (
              <li
                style={`--i:${sectionIndex + index}`}
                class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-b border-line py-4 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-x-8"
              >
                <span class="font-mono text-xs tracking-[0.08em] text-muted-ink" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="font-display text-[clamp(1.2rem,2vw,1.6rem)] leading-[1.15]">{person.name}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <a href="/structure" class="mt-4 inline-flex items-center gap-2 py-2 font-mono text-xs uppercase tracking-[0.08em] text-brand">
      {t('about.teamLink', locale)} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
