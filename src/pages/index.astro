---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getCurrentRecruitmentStage } from '../utils/recruitment';
import { parseDivisions } from '../utils/division-mapper';
import { STAGE_ACTION_CONFIG, DEFAULT_ACTION_BTN } from '../utils/constants';
import ResearchFocus from '../components/home/ResearchFocus.astro';
import NewsCard from '../components/cards/NewsCard.astro';
import {
  getLocaleFromUrl,
  getLocalizedJsonData,
  getCollectionEntriesForLocale,
  getLocalizedPath,
  t
} from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const divisionsData = await getLocalizedJsonData<any>('divisions', locale);
const registrationConfig = await getLocalizedJsonData<any>('registration', locale);

const divisions = parseDivisions(divisionsData);

// Fetch and filter news for active locale
const rawNews = await getCollection('news');
const localizedNews = getCollectionEntriesForLocale(rawNews, locale);

const latestNews = localizedNews
  .sort((a, b) => new Date(b.data.news_date).getTime() - new Date(a.data.news_date).getTime())
  .slice(0, 3);

// Calculate active recruitment stage
const currentStage = getCurrentRecruitmentStage(registrationConfig);
const actionBtn = STAGE_ACTION_CONFIG[currentStage] || DEFAULT_ACTION_BTN;
---

<Layout title={`EIM Research Lab - ${t('home.heroTag', locale)}`}>
  <header class="hero" id="home">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-tag">
            <span></span> {t('home.heroTag', locale)}
          </div>
          <h1>
            {t('home.heroTitle', locale)}
          </h1>
          <p class="hero-desc">
            {t('home.heroDesc', locale)}
          </p>
          <div class="hero-actions">
            {currentStage !== 'closed' && actionBtn ? (
              <>
                <a href={getLocalizedPath('/registration', locale)} class="btn btn-primary hero-action-primary">
                  {actionBtn.label} <i class={`fa-solid ${actionBtn.icon}`}></i>
                </a>
                <a href={getLocalizedPath('/about', locale)} class="btn btn-secondary">
                  {t('nav.about', locale)} <i class="fa-solid fa-circle-info"></i>
                </a>
              </>
            ) : (
              <>
                <a href={getLocalizedPath('/about', locale)} class="btn btn-primary hero-action-primary">
                  {t('nav.about', locale)} <i class="fa-solid fa-circle-info"></i>
                </a>
                <a href={getLocalizedPath('/structure', locale)} class="btn btn-secondary">
                  {t('nav.structure', locale)} <i class="fa-solid fa-users"></i>
                </a>
              </>
            )}
          </div>
        </div>
        <div class="hero-visual">
          <div class="visual-orbit">
            <div class="visual-core">
              <i class="fa-solid fa-server fa-3x text-gradient-dual"></i>
            </div>
            <div class="visual-node node-1" title="Cloud Computing">
              <i class="fa-solid fa-cloud"></i>
            </div>
            <div class="visual-node node-2" title="Cyber Security">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div class="visual-node node-3" title="Network Infrastructure">
              <i class="fa-solid fa-network-wired"></i>
            </div>
            <div class="visual-node node-4" title="AI & Data Optimization">
              <i class="fa-solid fa-microchip"></i>
            </div>
          </div>
        </div>
      </div>

      {/* Research Focus */}
      <ResearchFocus />

      {/* Lab Divisions */}
      <div class="home-section-wrapper">
        <div class="section-title">
          <h2>{t('struct.divisions', locale)}</h2>
          <p>{t('struct.subtitle', locale)}</p>
        </div>
        <div class="divisions-brief-grid">
          {divisions.map(div => (
            <a href={getLocalizedPath(`/structure?div=${div.id}`, locale)} class="div-brief-card glass-panel division-card-link">
              <h4>{div.displayName}</h4>
              <p>{div.description}</p>
            </a>
          ))}
        </div>
      </div>

      {/* Latest News */}
      <div class="home-section-wrapper latest-news-section">
        <div class="section-title">
          <h2>{t('home.latestNews', locale)}</h2>
          <p>{t('news.subtitle', locale)}</p>
        </div>
        <div class="news-grid">
          {latestNews.length === 0 ? (
            <div class="news-empty-state glass-panel news-empty-full">
              <i class="fa-regular fa-newspaper"></i>
              <p class="text-secondary-muted">No latest news available.</p>
            </div>
          ) : (
            latestNews.map(newsItem => (
              <NewsCard news={newsItem} showButton={false} />
            ))
          )}
        </div>
        <div class="view-all-news-wrapper">
          <a href={getLocalizedPath('/news', locale)} class="btn btn-secondary">
            {t('home.viewAllNews', locale)} <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </header>
</Layout>
