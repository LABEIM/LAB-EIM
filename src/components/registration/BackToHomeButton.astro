---
import { getLocaleFromUrl, getLocalizedPath } from '../../utils/i18n';

interface Props {
  wrapperClass?: string;
  href?: string;
  label?: string;
}

const locale = getLocaleFromUrl(Astro.url);

const {
  wrapperClass = "reg-btn-wrapper",
  href = getLocalizedPath('/', locale),
  label = "Kembali ke Beranda"
} = Astro.props;
---

<div class={wrapperClass}>
  <a href={href} class="btn btn-secondary reg-btn-padded">
    <i class="fa-solid fa-house reg-btn-icon-left"></i>{label}
  </a>
</div>
