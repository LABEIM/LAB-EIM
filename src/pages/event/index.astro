---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home-eim.css';
import '../../styles/pages/kegiatan-eim.css';
import EimSectionNav from '../../components/home/EimSectionNav.astro';
import KegiatanHero from '../../components/kegiatan/KegiatanHero.astro';
import KegiatanList from '../../components/kegiatan/KegiatanList.astro';
import {
  getCollectionEntriesForLocale,
  getLocaleFromUrl,
  getLocalizedJsonData,
} from '../../utils/i18n';
import { filterAuditContent } from '../../utils/content-helpers';
import { compareEventDates, getEventDateMs } from '../../utils/event-helpers';
import { sectionOn } from '../../utils/page-content';
import type { ChromeData, EventsPageData } from '../../utils/types';

const locale = getLocaleFromUrl(Astro.url);
const page = getLocalizedJsonData<EventsPageData>('pages/events', locale);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);

const rawEvents = await getCollection('events');
const events = filterAuditContent(getCollectionEntriesForLocale(rawEvents, locale))
  .slice()
  .sort((a, b) => compareEventDates(a, b, 'desc'));

const categories = [...new Set(events.map((event) => event.data.category).filter(Boolean))].sort();

const latestYear =
  events
    .map(getEventDateMs)
    .filter(Boolean)
    .map((ms) => String(new Date(ms).getUTCFullYear()))
    .sort((a, b) => b.localeCompare(a))[0] ?? null;

// The hero dot has no toggle of its own; the list dot reads the same flag as the section.
// The eyebrow doubles as the hero dot label, so it falls back to the page title.
const eyebrow = page.hero.eyebrow || page.meta.title;
const sectionItems = [
  { id: 'kegiatan', label: eyebrow },
  ...(sectionOn(page.list) ? [{ id: 'daftar', label: page.navDots.list }] : []),
];
---

<Layout title={page.meta.title} description={page.meta.description} homeSkin skipLink>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={chrome.labels.sectionNav} />
    <KegiatanHero
      content={page.hero}
      totalCount={events.length}
      categoryCount={categories.length}
      latestYear={latestYear}
      showPrimary={sectionOn(page.list)}
    />
    {sectionOn(page.list) && (
      <KegiatanList content={page.list} events={events} locale={locale} secondaryLabel={page.hero.secondaryLabel} />
    )}
  </main>
</Layout>
