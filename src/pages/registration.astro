---
import Layout from '../layouts/Layout.astro';
import registrationConfig from '../data/registration.json';
import resultsConfig from '../data/recruitment_results.json';
import divisions from '../data/divisions.json';

import ViewUpcoming from '../components/registration/ViewUpcoming.astro';
import ViewOpenForm from '../components/registration/ViewOpenForm.astro';
import ViewScreening from '../components/registration/ViewScreening.astro';
import ViewScreeningResults from '../components/registration/ViewScreeningResults.astro';
import ViewTechnicalTest from '../components/registration/ViewTechnicalTest.astro';
import ViewTechnicalTestResults from '../components/registration/ViewTechnicalTestResults.astro';
import ViewInterview from '../components/registration/ViewInterview.astro';
import ViewAnnouncement from '../components/registration/ViewAnnouncement.astro';
import ViewClosed from '../components/registration/ViewClosed.astro';

const studentYears = registrationConfig.studentYears || ["2022", "2023", "2024", "2025"];
const docLimits = registrationConfig.documentLimits || {
  ksmMb: 2,
  khsMb: 2,
  mlMb: 2,
  cvMb: 3,
  piMb: 2
};

const piTemplateUrl = (registrationConfig as any).piTemplateUrl || "";

const openDateStr = registrationConfig.openDate || "2026-07-01T00:00:00";
const deadlineStr = registrationConfig.deadline || "2026-07-25T23:59:59";
const extendedDeadlineStr = registrationConfig.extendedDeadline || "";
const selectionEndDateStr = registrationConfig.selectionEndDate || "2026-08-05T23:59:59";
const selectionResultsDateStr = registrationConfig.selectionResultsDate || "2026-08-06T00:00:00";
const technicalTestEndDateStr = registrationConfig.technicalTestEndDate || "2026-08-10T23:59:59";
const technicalTestResultsDateStr = registrationConfig.technicalTestResultsDate || "2026-08-11T00:00:00";
const interviewEndDateStr = registrationConfig.interviewEndDate || "2026-08-15T23:59:59";
const announcementDateStr = registrationConfig.announcementDate || "2026-08-17T00:00:00";

// Config objects with fallbacks
const upcomingCfg = registrationConfig.upcomingConfig || {
  title: "Recruitment Opening Soon!",
  subtitle: "Get your documents ready. Registration will officially open soon.",
  prepNotice: "Prepare the required files in advance so you can apply as soon as registration opens."
};

const extendedCfg = registrationConfig.extendedConfig || {
  bannerTitle: "Pendaftaran Diperpanjang! (Registration Extended)",
  bannerMessage: "Good news! The assistant registration deadline has been extended."
};

const selectionCfg = registrationConfig.selectionConfig || {
  title: "Document Screening In Progress",
  subtitle: "Our team is currently evaluating all submitted administrative documents.",
  message: "Thank you for registering! Document verification and administrative screening are underway.",
  estimatedAnnouncementDate: "06 August 2026"
};

const selectionResultsCfg = (registrationConfig as any).selectionResultsConfig || {
  title: "Pengumuman Seleksi Berkas (Document Screening Results)",
  subtitle: "Check if you passed document screening and qualify for the Technical Test.",
  newsUrl: "/news/pengumuman-rekrutmen-2026",
  documentUrl: ""
};

const technicalTestCfg = (registrationConfig as any).technicalTestConfig || {
  title: "Technical Test Phase In Progress",
  subtitle: "Practical skills assessment and technical challenge in progress.",
  message: "Please check your registered email for your technical test instructions and submission brief.",
  scheduleInfo: "07 - 10 August 2026",
  locationInfo: "EIM Research Lab / Online Submission"
};

const technicalTestResultsCfg = (registrationConfig as any).technicalTestResultsConfig || {
  title: "Pengumuman Tes Teknikal (Technical Test Results)",
  subtitle: "Check if you passed the Technical Test and qualify for the Interview phase.",
  newsUrl: "/news/pengumuman-rekrutmen-2026",
  documentUrl: ""
};

const interviewCfg = (registrationConfig as any).interviewConfig || {
  title: "Interview Phase In Progress",
  subtitle: "Candidate interview sessions in progress with EIM Research Lab team.",
  message: "Please check your registered email for your assigned interview time slot and Zoom call details.",
  scheduleInfo: "12 - 15 August 2026",
  locationInfo: "EIM Research Lab / Online Zoom Room"
};

const announcementCfg = registrationConfig.announcementConfig || {
  title: "Final Selection Announcement",
  subtitle: "Check your final selection status below. Congratulations to all accepted candidates!",
  newsUrl: "/news/pengumuman-rekrutmen-2026",
  documentUrl: ""
};

const closedCfg = registrationConfig.closedConfig || {
  title: "Recruitment Period Ended",
  subtitle: "Assistant recruitment for this batch is officially closed.",
  message: "Thank you to everyone who applied. Follow our social media for future recruitment cycles!",
  nextBatchInfo: "Next recruitment expected in early 2027."
};

// Initial Server-Side Stage Determination
const nowTime = new Date().getTime();
const openTime = new Date(openDateStr).getTime();
const deadlineTime = new Date(deadlineStr).getTime();
const extendedTime = extendedDeadlineStr ? new Date(extendedDeadlineStr).getTime() : 0;
const selectionEndTime = new Date(selectionEndDateStr).getTime();
const selectionResultsTime = new Date(selectionResultsDateStr).getTime();
const technicalTestEndTime = new Date(technicalTestEndDateStr).getTime();
const technicalTestResultsTime = new Date(technicalTestResultsDateStr).getTime();
const interviewEndTime = new Date(interviewEndDateStr).getTime();
const announcementTime = new Date(announcementDateStr).getTime();

let initialStage = registrationConfig.status || "auto";

if (initialStage === "auto") {
  if (nowTime < openTime) {
    initialStage = "upcoming";
  } else if (nowTime < deadlineTime) {
    initialStage = "open";
  } else if (extendedTime > 0 && nowTime < extendedTime) {
    initialStage = "extended";
  } else if (nowTime < selectionEndTime) {
    initialStage = "selection";
  } else if (nowTime < selectionResultsTime) {
    initialStage = "selection_results";
  } else if (nowTime < technicalTestEndTime) {
    initialStage = "technical_test";
  } else if (nowTime < technicalTestResultsTime) {
    initialStage = "technical_test_results";
  } else if (nowTime < interviewEndTime) {
    initialStage = "interview";
  } else if (nowTime >= announcementTime) {
    initialStage = "announcement";
  } else {
    initialStage = "closed";
  }
}

// Group accepted candidates by division for final announcement view
const candidatesList = resultsConfig.candidates || [];
const acceptedCandidates = candidatesList.filter(c => (c as any).finalStatus === 'accepted' || (c as any).status === 'accepted');

const candidatesByDivision: Record<string, typeof candidatesList> = {};
acceptedCandidates.forEach(candidate => {
  if (!candidatesByDivision[candidate.division]) {
    candidatesByDivision[candidate.division] = [];
  }
  candidatesByDivision[candidate.division].push(candidate);
});
---

<Layout title={`${registrationConfig.heroTitle || 'Assistant Lab Registration'} - EIM Research Lab`}>
  <section class="page-header" style="padding-top: 150px; padding-bottom: 50px;">
    <div class="container">
      <div class="page-header-content">
        <div class="hero-tag"><span></span> {registrationConfig.heroTag || 'Assistant Recruitment'}</div>
        <h1 id="page-hero-title">{registrationConfig.heroTitle || 'Assistant Lab Registration'}</h1>
        <p class="hero-desc" id="page-hero-desc">{registrationConfig.heroDescription || 'Join us and become a part of EIM Research Lab.'}</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="registration">
    <div class="container">
      <div 
        class="registration-form-container glass-panel" 
        id="registration-container" 
        data-stage={initialStage}
        data-open-date={openDateStr}
        data-deadline={deadlineStr} 
        data-extended-deadline={extendedDeadlineStr}
        data-medhum-val={registrationConfig.medhumDivisionValue || "Medhum"}
      >
        <ViewUpcoming initialStage={initialStage} upcomingCfg={upcomingCfg} docLimits={docLimits} studentYears={studentYears} piTemplateUrl={piTemplateUrl} />
        <ViewOpenForm initialStage={initialStage} registrationConfig={registrationConfig} extendedCfg={extendedCfg} studentYears={studentYears} docLimits={docLimits} divisions={divisions} piTemplateUrl={piTemplateUrl} />
        <ViewScreening initialStage={initialStage} selectionCfg={selectionCfg} />
        <ViewScreeningResults initialStage={initialStage} selectionResultsCfg={selectionResultsCfg} />
        <ViewTechnicalTest initialStage={initialStage} technicalTestCfg={technicalTestCfg} />
        <ViewTechnicalTestResults initialStage={initialStage} technicalTestResultsCfg={technicalTestResultsCfg} />
        <ViewInterview initialStage={initialStage} interviewCfg={interviewCfg} />
        <ViewAnnouncement initialStage={initialStage} announcementCfg={announcementCfg} acceptedCandidates={acceptedCandidates} candidatesByDivision={candidatesByDivision} />
        <ViewClosed initialStage={initialStage} closedCfg={closedCfg} />
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initRegistrationScript } from '../scripts/registration';
  initRegistrationScript();
</script>
