---
import TimelineSteps from './TimelineSteps.astro';
import StageInfoPanel from './StageInfoPanel.astro';
import BackToHomeButton from './BackToHomeButton.astro';

interface Props {
  initialStage: string;
  technicalTestCfg: {
    title: string;
    subtitle: string;
    message: string;
    scheduleInfo?: string;
    locationInfo?: string;
  };
}

const { initialStage, technicalTestCfg } = Astro.props;
---

<div id="view-technical-test" class={initialStage === 'technical_test' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{technicalTestCfg.title}</h2>
    <p class="registration-hero-subtitle">{technicalTestCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={3} />

  <StageInfoPanel
    iconClass="fa-laptop-code"
    message={technicalTestCfg.message}
    scheduleInfo={technicalTestCfg.scheduleInfo}
    locationInfo={technicalTestCfg.locationInfo}
    locationIconClass="fa-location-dot"
  />

  <BackToHomeButton />
</div>
