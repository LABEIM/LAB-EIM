---
import { getLocaleFromUrl, getLocalizedPath } from '../../utils/i18n';
import FormDescriptionCard from './FormDescriptionCard.astro';

interface Props {
  initialStage: string;
  fallbackCfg: {
    title: string;
    subtitle: string;
    message: string;
    formUrl: string;
    buttonText?: string;
  };
  piTemplateUrl?: string;
  formDescriptionTitle?: string;
  formDescription?: string;
  formDescriptionItems?: string[];
}

const locale = getLocaleFromUrl(Astro.url);
const { 
  initialStage, 
  fallbackCfg, 
  piTemplateUrl,
  formDescriptionTitle,
  formDescription,
  formDescriptionItems,
} = Astro.props;
---

<div id="view-fallback" class={initialStage === 'fallback' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{fallbackCfg.title}</h2>
    <p class="registration-hero-subtitle">{fallbackCfg.subtitle}</p>
  </div>

  <FormDescriptionCard 
    title={formDescriptionTitle} 
    description={formDescription} 
    items={formDescriptionItems} 
  />

  {/* Countdown Timer */}
  <div class="registration-timer reg-timer-mb" id="fallback-registration-timer">
    <div class="timer-block">
      <div id="f-timer-days" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Hari</div>
    </div>
    <div class="timer-block">
      <div id="f-timer-hours" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Jam</div>
    </div>
    <div class="timer-block">
      <div id="f-timer-minutes" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Menit</div>
    </div>
    <div class="timer-block">
      <div id="f-timer-seconds" class="reg-timer-val-red">0</div>
      <div class="reg-timer-label">Detik</div>
    </div>
  </div>

  <div class="info-card-panel">
    <i class="fa-solid fa-triangle-exclamation info-card-icon reg-icon-yellow"></i>
    <p class="reg-msg-p">{fallbackCfg.message}</p>

    <div class="reg-btn-group">
      {piTemplateUrl && (
        <a 
          href={piTemplateUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary reg-btn-action-padded"
        >
          <i class="fa-solid fa-file-pdf reg-btn-icon-abs reg-btn-icon-red"></i>Download Template Pakta Integritas
        </a>
      )}

      <a 
        href={fallbackCfg.formUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-primary reg-btn-action-padded"
      >
        <i class="fa-solid fa-arrow-up-right-from-square reg-btn-icon-abs"></i>{fallbackCfg.buttonText || 'Buka Formulir Pendaftaran Cadangan'}
      </a>
    </div>

    <div class="reg-border-top-box">
      <a href={getLocalizedPath('/', locale)} class="btn btn-secondary reg-btn-padded">
        <i class="fa-solid fa-house reg-btn-icon-abs"></i>Kembali ke Beranda
      </a>
    </div>
  </div>
</div>
