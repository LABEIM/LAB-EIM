---
interface Props {
  initialStage: string;
  closedCfg: {
    title: string;
    subtitle: string;
    message: string;
    nextBatchInfo?: string;
  };
}

const { initialStage, closedCfg } = Astro.props;
---

<div id="view-closed" style={initialStage === 'closed' ? 'display: block;' : 'display: none;'}>
  <div style="text-align: center; padding: 40px 20px; background-color: var(--bg-card); border-radius: 10px; border: 1px solid var(--border-color);">
    <i class="fa-solid fa-lock" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 20px;"></i>
    <h3 style="font-size: 1.8rem; margin-bottom: 12px; color: var(--text-primary);">{closedCfg.title}</h3>
    <p style="color: var(--text-secondary); font-size: 1.05rem; max-width: 550px; margin: 0 auto 20px auto;">{closedCfg.subtitle}</p>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 25px;">{closedCfg.message}</p>

    {closedCfg.nextBatchInfo && (
      <div style="display: inline-block; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); border-radius: 20px; padding: 8px 18px; color: var(--accent-cyan); font-size: 0.85rem; margin-bottom: 30px;">
        <i class="fa-solid fa-circle-info" style="margin-right: 6px;"></i> {closedCfg.nextBatchInfo}
      </div>
    )}

    <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary" style="position: relative; padding-left: 45px; padding-right: 45px;">
        <i class="fa-solid fa-house" style="position: absolute; left: 24px;"></i>Back to Home
      </a>
      <a href="/news" class="btn btn-secondary" style="padding: 10px 24px;">
        <i class="fa-solid fa-newspaper"></i> Lab News & Updates
      </a>
    </div>
  </div>
</div>


