---
import '../../styles/components/status-page.css';

interface Action {
  label: string;
  href: string;
}

interface Props {
  code: string;
  eyebrow: string;
  title: string;
  description: string;
  primary?: Action;
  secondary?: Action;
  standalone?: boolean;
}

const { code, eyebrow, title, description, primary, secondary, standalone = false } = Astro.props;
---

<main
  id="main-content"
  tabindex="-1"
  class:list={[
    'status-page flex flex-col items-center justify-center px-[clamp(1.25rem,4vw,4rem)] text-center',
    standalone ? 'min-h-dvh py-16' : 'pt-[max(clamp(4.5rem,12vh,9rem),calc(var(--site-header-height)_+_2.5rem))] pb-[clamp(4.5rem,12vh,9rem)]',
  ]}
>
  <p class="font-mono text-xs uppercase tracking-[0.08em] text-brand">{code} — {eyebrow}</p>
  <h1
    class="mt-4 max-w-[20ch] text-balance font-display text-[clamp(2rem,5vw,3.75rem)] font-normal leading-[1.05] tracking-[-0.01em]"
  >
    {title}
  </h1>
  <p class="mt-6 max-w-[46ch] text-[15px] leading-[1.6] text-muted-ink">{description}</p>
  {(primary || secondary) && (
    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-3">
      {primary && <a class="eim-hero-cta" href={primary.href}>{primary.label}</a>}
      {secondary && <a class="eim-hero-secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  )}
  <slot />
</main>
