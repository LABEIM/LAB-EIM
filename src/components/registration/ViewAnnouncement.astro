---
import TimelineSteps from './TimelineSteps.astro';

interface Candidate {
  name: string;
  nim: string | number;
  division?: string;
  screeningStatus?: string;
  technicalTestStatus?: string;
  finalStatus?: string;
  status?: string;
  notes?: string;
}

interface Props {
  initialStage: string;
  announcementCfg: {
    title: string;
    subtitle: string;
    newsUrl?: string;
    documentUrl?: string;
  };
  acceptedCandidates: Candidate[];
  candidatesByDivision: Record<string, Candidate[]>;
}

const { initialStage, announcementCfg } = Astro.props;
---

<div id="view-announcement" class={initialStage === 'announcement' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{announcementCfg.title}</h2>
    <p class="registration-hero-subtitle">{announcementCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={5} markCurrentAsCompleted={true} />

  {/* Interactive Final Status Search Lookup */}
  <div class="search-lookup-box reg-timer-mb">
    <h3 class="search-lookup-title">
      <i class="fa-solid fa-magnifying-glass reg-icon-mr-sm"></i> Check Final Selection Result
    </h3>
    <div class="search-lookup-form">
      <input type="text" id="search-nim-input" class="form-control reg-input-bg" placeholder="Enter Student ID (NIM) or Name..." />
      <button id="search-nim-btn" class="btn btn-primary reg-btn-search">
        Check <i class="fa-solid fa-search reg-icon-ml-xs"></i>
      </button>
    </div>
    <div id="search-result-box" class="search-result-display"></div>
  </div>

  <div class="reg-border-top-box">
    <a href="/" class="btn btn-secondary reg-btn-padded">
      <i class="fa-solid fa-house reg-btn-icon-left"></i>Back to Home
    </a>
  </div>
</div>


