---
import TimelineSteps from './TimelineSteps.astro';

interface Props {
  initialStage: string;
  selectionResultsCfg: {
    title: string;
    subtitle: string;
    newsUrl?: string;
    documentUrl?: string;
  };
}

const { initialStage, selectionResultsCfg } = Astro.props;
---

<div id="view-selection-results" class={initialStage === 'selection_results' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{selectionResultsCfg.title}</h2>
    <p class="registration-hero-subtitle">{selectionResultsCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={2} markCurrentAsCompleted={true} />

  {/* NIM Search Box for Screening Results */}
  <div class="search-lookup-box">
    <h3 class="search-lookup-title">
      <i class="fa-solid fa-magnifying-glass reg-icon-mr-sm"></i> Check Document Screening Result
    </h3>
    <div class="search-lookup-form">
      <input type="text" id="search-screening-nim-input" class="form-control reg-input-bg" placeholder="Enter Student ID (NIM)..." />
      <button id="search-screening-nim-btn" class="btn btn-primary reg-btn-search">
        Search <i class="fa-solid fa-search reg-icon-ml-xs"></i>
      </button>
    </div>
    <div id="search-screening-result-box" class="search-result-display"></div>
  </div>

  <div class="reg-btn-wrapper">
    <a href="/" class="btn btn-secondary reg-btn-padded">
      <i class="fa-solid fa-house reg-btn-icon-left"></i>Back to Home
    </a>
  </div>
</div>


