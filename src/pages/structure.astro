---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import '../styles/pages/structure-eim.css';
import EimSectionNav from '../components/home/EimSectionNav.astro';
import EimCTA from '../components/home/EimCTA.astro';
import StructureHero from '../components/structure/StructureHero.astro';
import StructureChart from '../components/structure/StructureChart.astro';
import StructureRoles from '../components/structure/StructureRoles.astro';
import { getCollection } from 'astro:content';
import { buildPositionIndex, countPeopleByGroup, groupPeople, parsePositions } from '../utils/position-mapper';
import { resolveCourses } from '../utils/course-helpers';
import { getLocaleFromUrl, getLocalizedJsonData, t } from '../utils/i18n';
import type { Lecturer, Member } from '../utils/types';

const locale = getLocaleFromUrl(Astro.url);
const membersData = getLocalizedJsonData<{ list: Member[] }>('members', locale);
const positionsData = getLocalizedJsonData<{ list: unknown }>('positions', locale);
const siteData = getLocalizedJsonData<any>('site', locale);
const lecturersData = getLocalizedJsonData<{ list: Lecturer[] }>('lecturers', locale);

const positions = parsePositions(positionsData);
const positionIndex = buildPositionIndex(positions);
const members = membersData?.list ?? [];
const lecturers = lecturersData?.list ?? [];
const people = [...lecturers, ...members];

const courseEntries = await getCollection('courses');
const courses = resolveCourses(courseEntries, lecturers, members);

const sections = groupPeople(people, positions);
const groupCounts = countPeopleByGroup(people, positions);
const dosenCount = groupCounts.dosen;
// "Anggota" excludes dosen, who are counted separately in the hero meta.
const assistantCount = groupCounts.asisten + groupCounts.mahasiswa;

const sectionItems = [
  { id: 'struktur', label: t('struct.navDotChart', locale) },
  ...sections.map(({ position }) => ({ id: `pos-${position.id}`, label: position.label })),
  { id: 'gabung', label: t('struct.navDotJoin', locale) },
];
---

<Layout
  title={`Struktur Organisasi · EIM Research Lab`}
  description={t('struct.metaDescription', locale)}
  homeSkin
  skipLink
>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={t('struct.sectionNavLabel', locale)} />
    <StructureHero
      memberCount={assistantCount}
      dosenCount={dosenCount}
      positionCount={positions.length}
    />
    <StructureChart
      positions={positions}
      members={members}
      lecturers={lecturers}
      courses={courses}
      locale={locale}
    />
    {sections.map((section, index) => (
      <StructureRoles
        section={section}
        index={index}
        positionIndex={positionIndex}
        locale={locale}
      />
    ))}
    <EimCTA site={siteData} />
  </main>
</Layout>
