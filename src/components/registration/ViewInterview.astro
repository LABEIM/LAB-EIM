---
import TimelineSteps from './TimelineSteps.astro';

interface Props {
  initialStage: string;
  interviewCfg: {
    title: string;
    subtitle: string;
    message: string;
    scheduleInfo?: string;
    locationInfo?: string;
  };
}

const { initialStage, interviewCfg } = Astro.props;
---

<div id="view-interview" class={initialStage === 'interview' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{interviewCfg.title}</h2>
    <p class="registration-hero-subtitle">{interviewCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={4} />

  <div class="info-card-panel">
    <i class="fa-solid fa-comments info-card-icon"></i>
    <p class="reg-checklist-notice">{interviewCfg.message}</p>
    
    <div class="reg-btn-group">
      {interviewCfg.scheduleInfo && (
        <div class="badge-date-info">
          <i class="fa-solid fa-calendar-days reg-icon-mr"></i> Schedule: <strong>{interviewCfg.scheduleInfo}</strong>
        </div>
      )}
      {interviewCfg.locationInfo && (
        <div class="badge-location-info">
          <i class="fa-solid fa-video reg-checklist-icon"></i> Location / Room: <strong>{interviewCfg.locationInfo}</strong>
        </div>
      )}
    </div>
  </div>

  <div class="reg-btn-wrapper">
    <a href="/" class="btn btn-secondary reg-btn-padded">
      <i class="fa-solid fa-house reg-btn-icon-left"></i>Back to Home
    </a>
  </div>
</div>


