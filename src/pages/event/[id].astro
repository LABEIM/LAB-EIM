---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home-eim.css';
import '../../styles/pages/kegiatan-eim.css';
import EimCTA from '../../components/home/EimCTA.astro';
import KegiatanDetailHero from '../../components/kegiatan/KegiatanDetailHero.astro';
import KegiatanDetailBody from '../../components/kegiatan/KegiatanDetailBody.astro';
import KegiatanRelated from '../../components/kegiatan/KegiatanRelated.astro';
import {
  getCleanSlug,
  getCollectionEntriesForLocale,
  getLocaleFromUrl,
  getLocalizedJsonData,
} from '../../utils/i18n';
import { filterAuditContent } from '../../utils/content-helpers';
import { compareEventDates } from '../../utils/event-helpers';
import type { EventEntry } from '../../utils/event-helpers';

export async function getStaticPaths() {
  const events = await getCollection('events');
  // Intentionally includes audit content: CI benchmarks this route.
  return events.map((event) => ({
    params: { id: getCleanSlug(event.id) },
    props: { event },
  }));
}

interface Props {
  event: EventEntry;
}

const locale = getLocaleFromUrl(Astro.url);
const { event } = Astro.props;
const { Content } = await render(event);
const siteData = getLocalizedJsonData<any>('site', locale);

const all = filterAuditContent(getCollectionEntriesForLocale(await getCollection('events'), locale));
const pool = all.filter((item) => item.id !== event.id);
const related = [
  ...pool
    .filter((item) => item.data.category === event.data.category)
    .sort((a, b) => compareEventDates(a, b, 'desc')),
  ...pool
    .filter((item) => item.data.category !== event.data.category)
    .sort((a, b) => compareEventDates(a, b, 'desc')),
].slice(0, 3);
---

<Layout
  title={`${event.data.title} - EIM Research Lab`}
  description={event.data.description}
  homeSkin
  skipLink
>
  <main id="main-content" tabindex="-1">
    <KegiatanDetailHero event={event} locale={locale} />
    <KegiatanDetailBody event={event} locale={locale}>
      <Content />
    </KegiatanDetailBody>
    <KegiatanRelated events={related} locale={locale} />
    <EimCTA site={siteData} />
  </main>
</Layout>

<script>
  import { initShareButtons } from '../../scripts/share';
  initShareButtons('Kegiatan');
</script>
