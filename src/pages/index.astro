---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import type { AboutData, ChromeData, HomePageData, Lecturer, Member, RecruitmentConfig } from '../utils/types';
import EventPosterModal from '../components/events/EventPosterModal.astro';
import EimHero from '../components/home/EimHero.astro';
import EimReveal from '../components/home/EimReveal.astro';
import EimFocus from '../components/home/EimFocus.astro';
import EimVisiMisi from '../components/home/EimVisiMisi.astro';
import EimNews from '../components/home/EimNews.astro';
import EimEvents from '../components/home/EimEvents.astro';
import EimCourses from '../components/home/EimCourses.astro';
import EimLabNumbers from '../components/home/EimLabNumbers.astro';
import EimSectionNav from '../components/home/EimSectionNav.astro';
import EimCTA from '../components/home/EimCTA.astro';
import {
  getLocaleFromUrl,
  getLocalizedJsonData,
  getCollectionEntriesForLocale
} from '../utils/i18n';
import { sectionOn } from '../utils/page-content';
import { filterAuditContent } from '../utils/content-helpers';
import { resolveCourses } from '../utils/course-helpers';
import { countPeopleByGroup, parsePositions } from '../utils/position-mapper';
import { getCurrentRecruitmentStage } from '../utils/recruitment';

const locale = getLocaleFromUrl(Astro.url);
const page = getLocalizedJsonData<HomePageData>('pages/home', locale);
const siteData = getLocalizedJsonData<any>('site', locale);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);
const registrationConfig = getLocalizedJsonData<Partial<RecruitmentConfig>>('registration', locale);
const recruitmentStage = getCurrentRecruitmentStage(registrationConfig);
const lecturersData = getLocalizedJsonData<{ list: Lecturer[] }>('lecturers', locale);
const membersData = getLocalizedJsonData<{ list: Member[] }>('members', locale);
const positionsData = getLocalizedJsonData<{ list: unknown }>('positions', locale);
const about = await getLocalizedJsonData<AboutData>('about', locale);

// Fetch and filter news for active locale
const rawNews = await getCollection('news');
const localizedNews = getCollectionEntriesForLocale(rawNews, locale);

const latestNews = filterAuditContent(localizedNews)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) {
      return a.data.featured ? -1 : 1;
    }
    return new Date(b.data.news_date).getTime() - new Date(a.data.news_date).getTime();
  })
  .slice(0, 5);

// Events: upcoming first, then most recent — the section shows the next two as large poster tiles.
const rawEvents = await getCollection('events');
const events = filterAuditContent(rawEvents)
  .slice()
  .sort((a, b) => {
    const aUpcoming = a.data.status === 'upcoming';
    const bUpcoming = b.data.status === 'upcoming';
    if (aUpcoming !== bUpcoming) return aUpcoming ? -1 : 1;
    const dateDiff =
      new Date(a.data.event_date).getTime() - new Date(b.data.event_date).getTime();
    // Upcoming: soonest first. Past: most recent first.
    return aUpcoming ? dateDiff : -dateDiff;
  });

const upcomingEvents = events.filter((event) => event.data.status === 'upcoming');

// Lab numbers, derived — never typed in.
const positions = parsePositions(positionsData);
const members = membersData?.list ?? [];
const people = [...(lecturersData?.list ?? []), ...members];
const groupCounts = countPeopleByGroup(people, positions);

// Beranda course band: first three courses that actually run a practicum.
const courseEntries = await getCollection('courses');
const allCourses = resolveCourses(courseEntries, lecturersData?.list ?? [], members);
const bandCourses = allCourses.filter((course) => course.hasPracticum).slice(0, 3);

// Stat values stay derived from the data unless the editor pins a manual value.
// Labels are shared chrome copy, so they are not duplicated in the page file.
const numberStats = [
  { label: chrome.labels.statsDosen, value: page.numbers.dosenValue ?? groupCounts.dosen },
  { label: chrome.labels.statsMembers, value: page.numbers.membersValue ?? members.length },
  { label: chrome.labels.statsCourses, value: page.numbers.coursesValue ?? allCourses.length },
];

// The dots read the same flags as the sections, so a hidden section drops its dot.
const sectionItems = [
  ...(sectionOn(page.reveal) ? [{ id: 'reveal', label: page.navDots.reveal }] : []),
  ...(sectionOn(page.focus) ? [{ id: 'fokus', label: page.navDots.focus }] : []),
  ...(sectionOn(page.visiMisi) ? [{ id: 'visi-misi', label: page.navDots.vision }] : []),
  ...(sectionOn(page.courses) && bandCourses.length > 0
    ? [{ id: 'mata-kuliah', label: page.navDots.courses }]
    : []),
  ...(sectionOn(page.events) ? [{ id: 'kegiatan', label: page.navDots.events }] : []),
  ...(sectionOn(page.news) ? [{ id: 'berita', label: page.navDots.articles }] : []),
];
---

<Layout
  title={page.meta.title}
  description={page.meta.description || undefined}
  homeSkin
  skipLink
>
  <EventPosterModal upcomingEvents={upcomingEvents} locale={locale} />
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={page.navDots.sectionLabel} />
    <EimHero
      content={page.hero}
      logo={chrome.brand.logoHorizontal}
      primaryHref="#reveal"
      secondaryHref="/about"
    />
    {sectionOn(page.reveal) && <EimReveal content={page.reveal} />}
    {sectionOn(page.focus) && <EimFocus content={page.focus} />}
    {sectionOn(page.visiMisi) && (
      <EimVisiMisi
        content={{
          title: page.visiMisi.title,
          visionLabel: chrome.labels.vision,
          missionLabel: chrome.labels.mission,
          valuesLabel: chrome.labels.values,
        }}
        about={about}
      />
    )}
    {sectionOn(page.numbers) && <EimLabNumbers content={page.numbers} stats={numberStats} />}
    {sectionOn(page.courses) && bandCourses.length > 0 && (
      <EimCourses courses={bandCourses} content={page.courses} />
    )}
    {sectionOn(page.events) && <EimEvents events={events} locale={locale} content={page.events} />}
    {sectionOn(page.news) && <EimNews news={latestNews} locale={locale} content={page.news} />}
    {sectionOn(page.cta) && (
      <EimCTA content={chrome.cta} contact={siteData.contact} stage={recruitmentStage} />
    )}
  </main>
</Layout>

<script>
  import { initGlobalStageSync } from '../scripts/global-stage-sync';

  initGlobalStageSync();
</script>
