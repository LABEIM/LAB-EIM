---
import TimelineSteps from './TimelineSteps.astro';

interface Props {
  initialStage: string;
  selectionCfg: {
    title: string;
    subtitle: string;
    message: string;
    estimatedAnnouncementDate?: string;
  };
}

const { initialStage, selectionCfg } = Astro.props;
---

<div id="view-selection" class={initialStage === 'selection' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{selectionCfg.title}</h2>
    <p class="registration-hero-subtitle">{selectionCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={2} />

  <div class="info-card-panel">
    <i class="fa-solid fa-clipboard-check info-card-icon"></i>
    <p class="reg-checklist-notice">{selectionCfg.message}</p>
    {selectionCfg.estimatedAnnouncementDate && (
      <div class="badge-date-info">
        <i class="fa-solid fa-calendar-day reg-icon-mr"></i> Estimated Announcement: <strong>{selectionCfg.estimatedAnnouncementDate}</strong>
      </div>
    )}
  </div>

  <div class="reg-btn-wrapper">
    <a href="/" class="btn btn-secondary reg-btn-padded">
      <i class="fa-solid fa-house reg-btn-icon-left"></i>Back to Home
    </a>
  </div>
</div>


