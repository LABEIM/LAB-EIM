---
import BackToHomeButton from './BackToHomeButton.astro';
import { getLocaleFromUrl, t } from '../../utils/i18n';
import type { FieldStates } from '../../utils/types';

interface Props {
  initialStage: string;
  upcomingCfg: {
    title: string;
    subtitle: string;
    prepNotice: string;
  };
  docLimits: {
    ksmMb: number;
    khsMb: number;
    mlMb: number;
    cvMb: number;
    piMb: number;
    totalMb?: number;
  };
  studentYears: string[];
  piTemplateUrl?: string;
  fieldStates?: FieldStates;
  allowedFileExtensions?: Record<string, string>;
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, upcomingCfg, docLimits, studentYears, piTemplateUrl, fieldStates = {}, allowedFileExtensions = {} } = Astro.props;

const formatExtsLabel = (extsStr?: string) => (extsStr || "pdf, png, jpg, jpeg")
  .split(',')
  .map((e: string) => e.trim().toUpperCase().replace(/^\./, ''))
  .join(', ');

const ksmExtsDisplay = formatExtsLabel(allowedFileExtensions.ksm);
const khsExtsDisplay = formatExtsLabel(allowedFileExtensions.khs);
const mlExtsDisplay = formatExtsLabel(allowedFileExtensions.ml);
const cvExtsDisplay = formatExtsLabel(allowedFileExtensions.cv);
const piExtsDisplay = formatExtsLabel(allowedFileExtensions.pi);

const isKsmEnabled = fieldStates.ksm !== 'disabled';
const isKhsEnabled = fieldStates.khs !== 'disabled';
const isMlEnabled = fieldStates.ml !== 'disabled';
const isCvEnabled = fieldStates.cv !== 'disabled';
const isPiEnabled = fieldStates.pi !== 'disabled';
const isAngkatanEnabled = fieldStates.angkatan !== 'disabled';
---

<div id="view-upcoming" class={initialStage === 'upcoming' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{upcomingCfg.title}</h2>
    <p class="hero-desc registration-hero-subtitle">{upcomingCfg.subtitle}</p>
  </div>

  <div class="registration-timer reg-timer-mb" id="upcoming-timer">
    <div class="timer-block">
      <div id="u-timer-days" class="reg-timer-days">0</div>
      <div class="reg-timer-label">Hari</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-hours" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Jam</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-minutes" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Menit</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-seconds" class="reg-timer-val-red">0</div>
      <div class="reg-timer-label">Detik</div>
    </div>
  </div>

  <div class="checklist-box">
    <h3 class="checklist-title">
      <i class="fa-solid fa-list-check reg-icon-mr-sm"></i> Daftar Berkas & Persyaratan
    </h3>
    <p class="reg-checklist-notice">{upcomingCfg.prepNotice}</p>
    <ul class="checklist-list">
      {isKsmEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{t('form.ksm', locale)}</strong> ({ksmExtsDisplay}) {fieldStates.ksm === 'optional' ? '(Opsional)' : ''} - Max {docLimits.ksmMb}MB</span>
        </li>
      )}
      {isKhsEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{t('form.khs', locale)}</strong> ({khsExtsDisplay}) {fieldStates.khs === 'optional' ? '(Opsional)' : ''} - Max {docLimits.khsMb}MB</span>
        </li>
      )}
      {isMlEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{t('form.motivationLetter', locale)}</strong> ({mlExtsDisplay}) {fieldStates.ml === 'optional' ? '(Opsional)' : ''} - Max {docLimits.mlMb}MB</span>
        </li>
      )}
      {isCvEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{t('form.cv', locale)}</strong> ({cvExtsDisplay}) {fieldStates.cv === 'optional' ? '(Opsional)' : ''} - Max {docLimits.cvMb}MB</span>
        </li>
      )}
      {isPiEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{t('form.pi', locale)}</strong> ({piExtsDisplay}) {fieldStates.pi === 'optional' ? '(Opsional)' : ''} - Max {docLimits.piMb}MB</span>
          {piTemplateUrl && (
            <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="checklist-download-btn">
              <i class="fa-solid fa-file-arrow-down"></i>
              <span>{t('form.downloadPiTemplate', locale)}</span>
            </a>
          )}
        </li>
      )}
      {isAngkatanEnabled && (
        <li>
          <i class="fa-solid fa-user-graduate reg-checklist-icon"></i>
          <span><strong>Angkatan Mahasiswa:</strong> {studentYears.join(", ")} {fieldStates.angkatan === 'optional' ? '(Opsional)' : ''}</span>
        </li>
      )}
    </ul>
  </div>

  <BackToHomeButton />
</div>
