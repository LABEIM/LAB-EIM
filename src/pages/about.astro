---
import Layout from '../layouts/Layout.astro';
import { getLocaleFromUrl, getLocalizedJsonData, t } from '../utils/i18n';

interface ValueItem {
  title: string;
  description: string;
  icon: string;
  isAccent?: boolean;
}

const locale = getLocaleFromUrl(Astro.url);
const aboutData = await getLocalizedJsonData<any>('about', locale);

const values: ValueItem[] = aboutData.values || [];
---

<Layout title={`${aboutData.title || t('nav.about', locale)} - EIM Research Lab`}>
  <section class="page-header">
    <div class="container">
      <div class="page-header-content">
        <h1>{aboutData.title}</h1>
        <p class="hero-desc">{aboutData.description}</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="about">
    <div class="container">
      <div class="about-overview-grid mb-80">
        <div class="about-content">
          <h2 class="overview-heading">{aboutData.overviewTitle}</h2>
          <p class="hero-desc mb-20 max-w-full">
            {aboutData.overviewContent1}
          </p>
          <p class="text-secondary mb-20">
            {aboutData.overviewContent2}
          </p>
        </div>
        <div class="about-image flex-center">
          <img src={aboutData.overviewImage} alt="EIM Lab" />
        </div>
      </div>

      <div class="about-visionmission-grid glass-panel mb-80">
        <div class="vm-grid">
          <div>
            <h3 class="vision-heading">
              <i class="fa-solid fa-eye"></i> {t('about.vision', locale)}
            </h3>
            <p class="vm-text">
              {aboutData.vision}
            </p>
          </div>
          <div>
            <h3 class="mission-heading">
              <i class="fa-solid fa-bullseye"></i> {t('about.mission', locale)}
            </h3>
            <ul class="mission-list">
              {aboutData.missions?.map((mission: string) => (
                <li class="mission-item">{mission}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div>
        <div class="section-title">
          <h2>{t('about.values', locale)}</h2>
          <p>Nilai-nilai utama yang menjadi pilar dan budaya kerja di EIM Lab.</p>
        </div>

        <div class="focus-grid">
          {values.map((val) => (
            <div class="focus-card glass-panel">
              <div class={`focus-icon ${val.isAccent ? 'text-accent-red' : ''}`}>
                <i class={`fa-solid ${val.icon}`}></i>
              </div>
              <h3>{val.title}</h3>
              <p>{val.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
