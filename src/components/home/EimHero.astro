---
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  primaryLabel: string;
  primaryHref: string;
}

const { primaryLabel, primaryHref } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const titleLines = t('home.heroTitle', locale).split('\n');
---

<section id="hero" class="eim-hero" aria-labelledby="eim-hero-title">
  <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>

  <div class="eim-hero-inner">
    <img
      class="eim-hero-logo"
      src="/assets/brand/eim-logo-horizontal-640.avif"
      alt={t('home.heroKicker', locale)}
      width="640"
      height="116"
      decoding="async"
    />

    <h1 id="eim-hero-title" class="eim-hero-title">
      {titleLines.map((line) => <span class="eim-hero-title-line">{line}</span>)}
    </h1>

    <p class="eim-hero-desc">{t('home.heroDesc', locale)}</p>

    <div class="eim-hero-actions">
      <a
        id="hero-recruitment-btn"
        class="eim-hero-cta"
        href={primaryHref}
        data-join-href={primaryHref}
      ><span class="hero-btn-text">{primaryLabel}</span></a>

      <a class="eim-hero-secondary" href="#fokus">
        {t('home.heroSecondary', locale)} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <span class="eim-hero-scroll" aria-hidden="true"></span>
</section>

<script>
  import { initBinaryField } from '../../scripts/binary-field';

  initBinaryField();
</script>
