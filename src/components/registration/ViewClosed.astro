---
import { getLocaleFromUrl, getLocalizedPath } from '../../utils/i18n';

interface Props {
  initialStage: string;
  closedCfg: {
    title: string;
    subtitle: string;
    message: string;
    nextBatchInfo?: string;
  };
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, closedCfg } = Astro.props;
---

<div id="view-closed" class={initialStage === 'closed' ? '' : 'is-hidden'}>
  <div class="reg-closed-box">
    <i class="fa-solid fa-lock reg-closed-icon"></i>
    <h3 class="reg-closed-title">{closedCfg.title}</h3>
    <p class="reg-closed-subtitle">{closedCfg.subtitle}</p>
    <p class="reg-closed-msg">{closedCfg.message}</p>

    {closedCfg.nextBatchInfo && (
      <div class="reg-next-batch-pill">
        <i class="fa-solid fa-circle-info reg-icon-mr"></i> {closedCfg.nextBatchInfo}
      </div>
    )}

    <div class="reg-btn-group">
      <a href={getLocalizedPath('/', locale)} class="btn btn-primary reg-btn-padded">
        <i class="fa-solid fa-house reg-btn-icon-left"></i>Kembali ke Beranda
      </a>
      <a href={getLocalizedPath('/news', locale)} class="btn btn-secondary reg-btn-px">
        <i class="fa-solid fa-newspaper"></i> Berita & Pengumuman
      </a>
    </div>
  </div>
</div>
