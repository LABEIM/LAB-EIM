---
import fs from 'node:fs';
import { positionLabel } from '../../utils/position-mapper';
import { getInitials } from '../../utils/initials';
import type { Member, Position } from '../../utils/types';

interface Props {
  member: Member;
  positionIndex: Map<string, Position>;
  index?: number;
}

const { member, positionIndex, index } = Astro.props;

// Full-resolution originals are multi-megabyte; prefer the generated thumbnail.
const thumb = member.image?.replace('/image/division/', '/image/division/thumbs/') ?? '';
const mediaSrc =
  thumb && thumb !== member.image && fs.existsSync(`public${thumb}`) ? thumb : member.image;

---

<article
  class="member-tile"
  data-member-id={member.id}
  style={`--i:${index ?? 0}`}
>
  <div class="member-tile-media">
    {mediaSrc ? (
      <img
        src={mediaSrc}
        alt=""
        loading="lazy"
        decoding="async"
        style={`transform: scale(${member.scale ?? '1'}); transform-origin: ${member.position ?? 'center'};`}
      />
    ) : (
      <span class="member-tile-fallback" aria-hidden="true">{getInitials(member.name)}</span>
    )}
  </div>
  <div class="member-tile-body">
    <h3 class="member-tile-name">{member.name}</h3>
    <p class="member-tile-role">{positionLabel(positionIndex, member.role)}</p>
  </div>
</article>
