---
import type { EventEntry } from '../../utils/event-helpers';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import {
  getEventCover,
  getEventDateLabel,
  getEventDateMs,
  getEventStatusLabel,
} from '../../utils/event-helpers';

interface Props {
  event: EventEntry;
  locale: Locale;
}

const { event, locale } = Astro.props;

const cover = getEventCover(event);
const dateMs = getEventDateMs(event);
const dateLabel = getEventDateLabel(event, locale);
const statusLabel = getEventStatusLabel(event, locale);
const statusClass = `kegiatan-status kegiatan-status--${event.data.status}`;

const link = (event.data.link ?? '').trim();
const isExternal = /^https?:\/\//i.test(link);
---

<section id="kegiatan-detail" class="kegiatan-detail-hero" aria-labelledby="kegiatan-detail-title">
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="kegiatan-detail-top">
      <a class="kegiatan-back" href="/event">
        <span aria-hidden="true">←</span> {t('events.backToList', locale)}
      </a>
      <button type="button" class="share-btn kegiatan-share">{t('events.share', locale)}</button>
    </div>

    <div class="kegiatan-detail-grid">
      <div>
        <div class="eim-eyebrow kegiatan-detail-eyebrow">
          <span class={statusClass}>{statusLabel}</span>
          <span aria-hidden="true">·</span>
          {dateMs > 0 ? (
            <time datetime={event.data.event_date}>{dateLabel}</time>
          ) : (
            <span>{dateLabel}</span>
          )}
          <span aria-hidden="true">·</span>
          <span>{event.data.category}</span>
        </div>

        <h1 id="kegiatan-detail-title" class="kegiatan-detail-title">{event.data.title}</h1>
        <p class="kegiatan-detail-lead">{event.data.description}</p>

        <div class="kegiatan-detail-actions">
          {link ? (
            <a
              class="eim-hero-cta"
              href={link}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >
              {t('btn.register', locale)}
            </a>
          ) : (
            <a class="eim-hero-secondary" href="/contact">
              {t('events.contact', locale)} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>

      <div class="kegiatan-detail-cover">
        {cover ? (
          <img
            src={cover}
            alt=""
            width="800"
            height="1000"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <span class="kegiatan-media-fallback">
            <span class="kegiatan-media-fallback-category">{event.data.category}</span>
            <span class="kegiatan-media-fallback-date">{dateLabel}</span>
          </span>
        )}
      </div>
    </div>
  </div>
</section>
