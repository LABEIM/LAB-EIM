---
import { positionLabel } from '../../utils/position-mapper';
import type { Member, Position } from '../../utils/types';

interface Props {
  member: Member;
  positionIndex: Map<string, Position>;
  index?: number;
}

const { member, positionIndex, index } = Astro.props;

const initials = member.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join('')
  .toUpperCase();
---

<article
  class="member-tile"
  data-member-id={member.id}
  style={`--i:${index ?? 0}`}
>
  <div class="member-tile-media">
    {member.image ? (
      <img
        src={member.image}
        alt=""
        loading="lazy"
        decoding="async"
        style={`transform: scale(${member.scale ?? '1'}); transform-origin: ${member.position ?? 'center'};`}
      />
    ) : (
      <span class="member-tile-fallback" aria-hidden="true">{initials}</span>
    )}
  </div>
  <div class="member-tile-body">
    <h3 class="member-tile-name">{member.name}</h3>
    <p class="member-tile-role">{positionLabel(positionIndex, member.role)}</p>
  </div>
</article>
