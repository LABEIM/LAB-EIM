---
import type { HomePageData } from '../../utils/types';

interface Props {
  content: HomePageData['hero'];
  logo: string;
  primaryHref: string;
  secondaryHref: string;
  showPrimary?: boolean;
}

const { content, logo, primaryHref, secondaryHref, showPrimary = true } = Astro.props;
---

<section id="hero" class="eim-hero" aria-labelledby="eim-hero-title">
  <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>

  <div class="eim-hero-inner">
    <img
      class="eim-hero-logo"
      src={logo}
      alt={content.kicker}
      width="640"
      height="116"
      decoding="async"
    />

    <h1 id="eim-hero-title" class="eim-hero-title">
      {content.lines.map((line, index) => (
        <>
          <span class="eim-hero-title-line">{line}</span>{index < content.lines.length - 1 ? ' ' : ''}
        </>
      ))}
    </h1>

    <p class="eim-hero-desc">{content.description}</p>

    <div class="eim-hero-actions">
      {showPrimary && <a class="eim-hero-cta" href={primaryHref}>{content.primaryLabel}</a>}

      <a class="eim-hero-secondary" href={secondaryHref}>
        {content.secondaryLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <span class="eim-hero-scroll" aria-hidden="true"></span>
</section>

<script>
  import { initTopologyField } from '../../scripts/topology-field';

  initTopologyField();
</script>
