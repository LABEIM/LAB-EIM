---
import type { Lecturer, Member, Position } from '../../utils/types';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import { STRUCTURE_TREE, type StructureOutlineNode } from '../../utils/position-mapper';
import StructureNode from './StructureNode.astro';
import StructureOutline from './StructureOutline.astro';

interface Props {
  positions: Position[];
  members: Member[];
  lecturers: Lecturer[];
  locale: Locale;
}

const { positions, members, lecturers, locale } = Astro.props;

const byId = new Map(positions.map((position) => [position.id, position]));
const treeById = new Map(STRUCTURE_TREE.map((node) => [node.id, node]));

const holders = new Map<string, number>();
for (const person of [...lecturers, ...members]) {
  holders.set(person.role, (holders.get(person.role) ?? 0) + 1);
}

const buildOutline = (id: string): StructureOutlineNode | null => {
  const position = byId.get(id);
  if (!position) return null;
  const children = (treeById.get(id)?.children ?? [])
    .map(buildOutline)
    .filter((node): node is StructureOutlineNode => node !== null);
  return { position, count: holders.get(id) ?? 0, children };
};

const root = buildOutline(STRUCTURE_TREE[0].id);
const deputy = root?.children[0] ?? null;
const branch = deputy?.children ?? [];
const praktikum = branch[2]?.children ?? [];
---

<section
  id="struktur"
  class="pt-[clamp(2rem,5vh,3.5rem)] pb-[clamp(4.5rem,10vh,8.75rem)]"
  aria-labelledby="struct-chart-title"
>
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <h2
        id="struct-chart-title"
        class="e-reveal font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
      >
        {t('struct.chartTitle', locale)}
      </h2>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('struct.chartIntro', locale)}
      </p>
    </div>

    {root && (
      <div
        class="mt-[clamp(2.5rem,6vh,4rem)] rounded-media border border-line bg-surface p-[clamp(1.25rem,4vw,3rem)]"
      >
        <div class="org-tree e-reveal" aria-hidden="true">
          <div class="org-tier">
            <StructureNode position={root.position} count={root.count} locale={locale} />
          </div>

          {deputy && (
            <>
              <span class="org-stem"></span>
              <div class="org-tier">
                <StructureNode position={deputy.position} count={deputy.count} locale={locale} />
              </div>
            </>
          )}

          {branch.length > 0 && (
            <>
              <span class="org-stem"></span>
              <div class="org-branch--three"></div>
              <div class="org-tier org-tier--three">
                {branch.slice(0, 2).map((node) => (
                  <StructureNode position={node.position} count={node.count} locale={locale} />
                ))}

                <div class="org-column">
                  {branch[2] && (
                    <StructureNode
                      position={branch[2].position}
                      count={branch[2].count}
                      locale={locale}
                    />
                  )}
                  {praktikum.length > 0 && (
                    <>
                      <span class="org-stem"></span>
                      <div class="org-tier org-tier--stack">
                        {praktikum.map((node) => (
                          <StructureNode
                            position={node.position}
                            count={node.count}
                            locale={locale}
                          />
                        ))}
                      </div>
                    </>
                  )}
                </div>
              </div>
            </>
          )}
        </div>

        <ol class="sr-only">
          <StructureOutline node={root} locale={locale} />
        </ol>
      </div>
    )}
  </div>
</section>
