---
import TimelineSteps from './TimelineSteps.astro';
import NimSearchBox from './NimSearchBox.astro';
import BackToHomeButton from './BackToHomeButton.astro';
import { getLocaleFromUrl, t } from '../../utils/i18n';

import type { SelectionStepConfig } from '../../utils/types';

interface CandidateStepStatus {
  stepId: string;
  status: string;
}

interface Candidate {
  nim: string | number;
  division?: string;
  stageStatuses?: CandidateStepStatus[];
  finalStatus?: string;
  status?: string;
  notes?: string;
}


interface Props {
  initialStage: string;
  announcementCfg: {
    title: string;
    subtitle: string;
    newsUrl?: string;
    documentUrl?: string;
  };
  acceptedCandidates: Candidate[];
  candidatesByDivision: Record<string, Candidate[]>;
  selectionSteps?: SelectionStepConfig[];
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, announcementCfg, selectionSteps = [] } = Astro.props;
---

<div id="view-announcement" class={initialStage === 'announcement' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{announcementCfg.title}</h2>
    <p class="registration-hero-subtitle">{announcementCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStage="announcement" markCurrentAsCompleted={true} selectionSteps={selectionSteps} />


  {/* Interactive Final Status Search Lookup */}
  <NimSearchBox
    title="Cek Hasil Seleksi Akhir"
    inputId="search-nim-input"
    buttonId="search-nim-btn"
    resultBoxId="search-result-box"
    buttonLabel={t('btn.search', locale)}
    containerClass="reg-timer-mb"
  />

  <BackToHomeButton wrapperClass="reg-border-top-box" />
</div>
