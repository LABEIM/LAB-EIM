---
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import type { StructureOutlineNode } from '../../utils/position-mapper';
import StructureOutline from './StructureOutline.astro';

interface Props {
  node: StructureOutlineNode;
  locale: Locale;
}

const { node, locale } = Astro.props;
const count =
  node.count > 0
    ? t('struct.positionCount', locale, { n: String(node.count) })
    : t('struct.emptyPosition', locale);
---

<li>
  {node.position.label} — {count}
  {node.children.length > 0 && (
    <ol>
      {node.children.map((child) => (
        <StructureOutline node={child} locale={locale} />
      ))}
    </ol>
  )}
</li>
