---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/cards/NewsCard.astro';
import { getLocaleFromUrl, getCollectionEntriesForLocale, t } from '../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const rawNews = await getCollection('news');
const news = getCollectionEntriesForLocale(rawNews, locale);

const sortedNews = news.sort((a, b) => {
  const timeA = new Date(a.data.news_date).getTime();
  const timeB = new Date(b.data.news_date).getTime();
  return isNaN(timeA) || isNaN(timeB) ? 0 : timeB - timeA;
});
---

<Layout title={`${t('news.title', locale)} - EIM Research Lab`}>
  <section class="page-header news-page-header">
    <div class="container">
      <div class="page-header-content">
        <h1>{t('news.title', locale)}</h1>
        <p class="news-page-subtitle">{t('news.subtitle', locale)}</p>
      </div>
    </div>
  </section>

  <section class="section-padding news-section-main">
    <div class="container">
      {sortedNews.length === 0 ? (
        <div class="news-empty-state glass-panel empty-state-box">
          <i class="fa-regular fa-newspaper empty-state-icon"></i>
          <h3>No News Yet</h3>
          <p>No articles or news have been published yet.</p>
        </div>
      ) : (
        <div class="news-grid" id="news-grid">
          {sortedNews.map(item => (
            <NewsCard news={item} showButton={true} />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
