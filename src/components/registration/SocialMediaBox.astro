---

<div class={`connect-media-box ${compact ? 'compact' : ''}`}>
  <div class="connect-media-header">
    <div class="connect-media-badge">
      <i class="fa-solid fa-bullhorn" style="margin-right: 6px;"></i> Latest News Channel
    </div>
    <h3 class="connect-media-title">{title}</h3>
    {subtitle && <p class="connect-media-subtitle">{subtitle}</p>}
  </div>

  <div class="connect-cards-grid">
    {items.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="connect-card"
        style={`--social-color: ${item.color}; --social-bg: ${item.bgColor};`}
      >
        <div class="connect-icon-wrapper">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d={item.svgPath} />
          </svg>
        </div>
        <div class="connect-info">
          <span class="connect-platform">{item.label}</span>
          <span class="connect-handle">{item.handle}</span>
        </div>
        <i class="fa-solid fa-arrow-up-right-from-square connect-external-icon"></i>
      </a>
    ))}
  </div>
</div>

<style>
  .connect-media-box {
    margin-top: 30px;
    padding: 28px 24px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .connect-media-box.compact {
    padding: 20px 16px;
    margin-top: 20px;
  }

  .connect-media-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(224, 30, 90, 0.12);
    color: var(--accent-red);
    border: 1px solid rgba(224, 30, 90, 0.3);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
  }

  .connect-media-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .connect-media-subtitle {
    font-size: 0.92rem;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 auto 22px auto;
    line-height: 1.5;
  }

  .connect-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    max-width: 850px;
    margin: 0 auto;
  }

  .connect-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--bg-card, rgba(20, 20, 25, 0.7));
    border: 1px solid var(--border-color);
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .connect-card:hover {
    transform: translateY(-3px);
    border-color: var(--social-color);
    box-shadow: 0 8px 24px -6px var(--social-bg);
  }

  .connect-icon-wrapper {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--social-bg);
    color: var(--social-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .connect-card:hover .connect-icon-wrapper {
    transform: scale(1.1) rotate(-5deg);
  }

  .connect-info {
    display: flex;
    flex-direction: column;
    text-align: left;
    overflow: hidden;
  }

  .connect-platform {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .connect-handle {
    font-size: 0.78rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .connect-external-icon {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-left: auto;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: all 0.2s ease;
  }

    color: var(--social-color);
    opacity: 1;
    transform: translate(2px, -2px);
  }
</style>
