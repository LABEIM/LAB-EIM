---
import { Image } from 'astro:assets';
import type { DivisionPanel } from '../../utils/types';
import { getPortraitImage } from './portrait-assets';
import { t, DEFAULT_LOCALE } from '../../utils/i18n';

interface Props {
  panels: DivisionPanel[];
}

const { panels } = Astro.props;
---

<section id="divisi" class="py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="eim-divisions-title">
  <div class="mx-auto max-w-[1280px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <h2
        id="eim-divisions-title"
        class="e-reveal font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
      >
        {t('struct.divisions')}
      </h2>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('home.divIntro')}
      </p>
    </div>

    <div class="e-reveal-group mt-[clamp(2.5rem,6vh,4.5rem)] grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {panels.map((panel, index) => {
        const coordinator = index === 0 ? panel.coordinator : null;
        const portrait = coordinator ? getPortraitImage(coordinator.image) : undefined;

        return (
          <a
            href={panel.href}
            class:list={[
              'div-card group flex min-h-[15rem] flex-col rounded-card border border-line bg-surface p-6 hover:border-brand hover:bg-surface-strong',
              index === 0 && 'lg:col-span-2 lg:flex-row lg:items-stretch lg:gap-6',
            ]}
            style={`--i:${index}`}
          >
            {coordinator && portrait && (
              <span class="block w-full shrink-0 overflow-hidden rounded-card lg:w-[42%]">
                <Image
                  src={portrait}
                  alt={`Potret ${coordinator.name}`}
                  width={420}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </span>
            )}

            <span class="flex flex-1 flex-col">
              <span class="font-mono text-xs tracking-[0.08em] text-muted-ink">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="mt-4 font-display text-[clamp(1.5rem,2vw,2rem)] leading-[1.1] group-hover:text-brand">
                {panel.displayName}
              </span>
              <span class="mt-3 max-w-[40ch] text-sm leading-[1.55] text-muted-ink">
                {panel.description}
              </span>
              <span class="mt-auto flex items-center justify-between gap-4 pt-6 font-mono text-xs tracking-[0.08em] text-muted-ink">
                {t('home.memberCount', DEFAULT_LOCALE, { n: String(panel.memberCount) })}
                <span class="text-brand" aria-hidden="true">→</span>
              </span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .div-card:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -2px;
  }
</style>
