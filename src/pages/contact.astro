---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import '../styles/pages/contact-eim.css';
import EimSectionNav from '../components/home/EimSectionNav.astro';
import ContactPersonBox from '../components/registration/ContactPersonBox.astro';
import { getLocaleFromUrl, getLocalizedJsonData } from '../utils/i18n';
import { sectionOn } from '../utils/page-content';
import type { ChromeData, ContactData, ContactPerson, SiteData } from '../utils/types';

const locale = getLocaleFromUrl(Astro.url);
const siteData = getLocalizedJsonData<SiteData>('site', locale);
const page = getLocalizedJsonData<ContactData>('contact', locale);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);

const socials = siteData.socials || {};
const siteContact = siteData.contact || {};
const contactPersons: ContactPerson[] = Array.isArray(page.contactPersons) ? page.contactPersons : [];

// site.json is the single home for these three facts; the literals only cover a
// hand-edited site.json that lost them.
const location = siteContact.location || 'Gedung TULT Lantai 8, Ruang TULT.08.09';
const university = siteContact.university || 'Telkom University, Bandung, Indonesia';
const email = siteContact.email || 'lab@eimlab.org';

const pageTitle = page.meta.title;
// The literal stays a fallback for a hand-edited contact.json that lost the field.
const pageDescription = (
  page.meta.description ||
  '{location}, {university}, dan saluran komunikasi Laboratorium Enterprise Infrastructure Management (EIM) Telkom University.'
)
  .replaceAll('{location}', location)
  .replaceAll('{university}', university);

// Only a real Google Maps embed URL may reach the iframe src.
const googleMapsEmbed = /^https:\/\/((www\.)?google\.com|maps\.google\.com)\/maps\/embed\?/;
const mapsEmbedSrc = googleMapsEmbed.test(page.mapsEmbedUrl) ? page.mapsEmbedUrl : '';

const socialEntries = [
  { name: 'Instagram', url: socials.instagram, icon: 'fa-brands fa-instagram' },
  { name: 'LinkedIn', url: socials.linkedin, icon: 'fa-brands fa-linkedin-in' },
  { name: 'GitHub', url: socials.github, icon: 'fa-brands fa-github' },
].filter((entry) => Boolean(entry.url));

const labName = [siteData.name, siteData.subName].filter(Boolean).join(' ') || siteData.fullName || 'EIM Lab';

function getSocialHandle(url: string): string {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, '');
    if (host === 'instagram.com' || host === 'github.com') {
      const segment = parsed.pathname.split('/').filter(Boolean)[0];
      if (segment) return `@${segment}`;
    }
    if (host === 'linkedin.com') return labName;
    return host;
  } catch {
    return '';
  }
}

const showSocials = sectionOn(page.socials) && socialEntries.length > 0;
// The hero dot has no toggle of its own; the other dots follow their section flags.
const sectionItems = [
  { id: 'kontak', label: page.hero.eyebrow },
  ...(sectionOn(page.details) ? [{ id: 'detail', label: page.navDots.detail }] : []),
  ...(sectionOn(page.map) ? [{ id: 'lokasi', label: page.map.navDot }] : []),
  ...(showSocials ? [{ id: 'sosial', label: page.navDots.social }] : []),
];
---

<Layout title={pageTitle} description={pageDescription} homeSkin skipLink>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={chrome.labels.sectionNav} />

    <section id="kontak" class="eim-hero eim-subhero" aria-labelledby="contact-hero-title">
      <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>
      <div class="eim-hero-inner">
        <p class="eim-eyebrow">{page.hero.eyebrow}</p>
        <h1 id="contact-hero-title" class="eim-hero-title">{page.title}</h1>
        <p class="eim-hero-desc">{page.heroDescription}</p>
        <div class="eim-hero-actions">
          {sectionOn(page.details) && (
            <a class="eim-hero-cta" href="#detail">{page.hero.primaryLabel}</a>
          )}
          <a class="eim-hero-secondary" href="/registration">
            {page.hero.secondaryLabel} <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="eim-subhero-meta">{location} · {university}</p>
      </div>
    </section>

    {sectionOn(page.details) && (
    <section id="detail" class="py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="contact-detail-title">
      <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
        <div class="grid gap-[clamp(2.5rem,5vw,5rem)] lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)]">
          <div class="e-reveal lg:sticky lg:top-[calc(var(--site-header-height)+1.5rem)] lg:self-start">
            <p class="font-mono text-xs uppercase tracking-[0.08em] text-brand">01 — {page.details.eyebrow}</p>
            <h2
              id="contact-detail-title"
              class="mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
            >
              {page.details.title}
            </h2>
            <p class="mt-6 max-w-[42ch] text-[15px] leading-[1.6] text-muted-ink">
              {page.details.intro}
            </p>
            <p class="mt-4 max-w-[42ch] text-[14px] leading-[1.6] text-muted-ink">
              {page.details.routingNote}
            </p>
          </div>

          <div>
            <dl class="border-t border-line">
              <div class="grid gap-3 border-b border-line py-6 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-ink">{page.locationTitle}</dt>
                <dd class="text-[15px] leading-[1.6]">
                  <p>{location}</p>
                  <p class="mt-1 text-muted-ink">{university}</p>
                </dd>
              </div>

              <div class="grid gap-3 border-b border-line py-6 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-ink">{page.emailTitle}</dt>
                <dd class="text-[15px] leading-[1.6]">
                  <a class="text-brand underline underline-offset-4" href={`mailto:${email}`}>{email}</a>
                  <div class="contact-action-row">
                    <a class="contact-action" href={`mailto:${email}`}>
                      {page.details.emailAction} <span aria-hidden="true">→</span>
                    </a>
                    <button
                      type="button"
                      class="contact-action contact-copy"
                      id="copy-email-btn"
                      data-email={email}
                      data-copied={page.details.copied}
                      data-failed={page.details.copyFailed}
                      data-status-copied={page.details.copySuccessStatus}
                      data-status-failed={page.details.copyFailedStatus}
                    >
                      {page.details.copyEmail}
                    </button>
                    <span id="copy-email-status" class="sr-only" role="status" aria-live="polite"></span>
                  </div>
                </dd>
              </div>

              <div class="grid gap-3 border-b border-line py-6 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
                <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-ink">{page.hoursTitle}</dt>
                <dd class="text-[15px] leading-[1.6]">
                  <p>{page.hoursText}</p>
                  <p class="mt-1 text-muted-ink">{page.hoursSubtext}</p>
                </dd>
              </div>
            </dl>

            <ContactPersonBox
              contactPersons={contactPersons}
              compact
              title={page.details.picsTitle}
              subtitle={page.details.picsSubtitle}
            />
          </div>
        </div>
      </div>
    </section>
    )}

    {sectionOn(page.map) && (
    <section id="lokasi" class="border-t border-line py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="contact-map-title">
      <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">02 — {page.map.navDot}</p>
            <h2
              id="contact-map-title"
              class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
            >
              {page.map.title}
            </h2>
          </div>
          <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
            {page.map.subtitle}
          </p>
        </div>

        <div class="contact-map-frame e-reveal mt-[clamp(2.5rem,6vh,4rem)]">
          <iframe
            src={mapsEmbedSrc}
            title={page.map.title}
            allowfullscreen=""
            loading="lazy"
            sandbox="allow-scripts allow-same-origin allow-popups"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>
    )}

    {showSocials && (
      <section id="sosial" class="border-t border-line py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="contact-social-title">
        <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
          <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <div>
              <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">03 — {page.socials.eyebrow}</p>
              <h2
                id="contact-social-title"
                class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
              >
                {page.socials.title}
              </h2>
            </div>
            <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
              {page.socials.intro}
            </p>
          </div>

          <ul class="contact-social-list e-reveal-group">
            {socialEntries.map((entry) => (
              <li class="contact-social-item">
                <a class="contact-social-row" href={entry.url} target="_blank" rel="noopener noreferrer">
                  <span class="contact-social-icon">
                    <i class={entry.icon} aria-hidden="true"></i>
                  </span>
                  <span class="contact-social-text">
                    <span class="contact-social-name">{entry.name}</span>
                    <span class="contact-social-handle">{getSocialHandle(entry.url)}</span>
                  </span>
                  <span class="contact-social-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  import { initTopologyField } from '../scripts/topology-field';

  initTopologyField();

  const copyEmailBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
  const copyStatus = document.getElementById('copy-email-status');
  const copyLabel = copyEmailBtn?.textContent ?? '';
  let copyTimer: ReturnType<typeof setTimeout> | undefined;
  let copySeq = 0;

  copyEmailBtn?.addEventListener('click', async () => {
    const email = copyEmailBtn.dataset.email;
    if (!email) return;

    const seq = ++copySeq;
    const copied = await Promise.resolve()
      .then(() => navigator.clipboard.writeText(email))
      .then(() => true, () => false);
    if (seq !== copySeq) return;

    clearTimeout(copyTimer);
    copyEmailBtn.textContent = (copied ? copyEmailBtn.dataset.copied : copyEmailBtn.dataset.failed) ?? '';
    if (copyStatus) {
      copyStatus.textContent = (copied ? copyEmailBtn.dataset.statusCopied : copyEmailBtn.dataset.statusFailed) ?? '';
    }

    copyTimer = setTimeout(() => {
      copyEmailBtn.textContent = copyLabel;
      if (copyStatus) copyStatus.textContent = '';
    }, 2500);
  });
</script>
