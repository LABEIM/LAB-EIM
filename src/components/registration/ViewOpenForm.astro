---
import type { DivisionConfig } from '../../utils/division-mapper';
import { getLocaleFromUrl, t } from '../../utils/i18n';
import type { FieldStates } from '../../utils/types';
import FormDescriptionCard from './FormDescriptionCard.astro';

interface Props {
  initialStage: string;
  registrationConfig: any;
  extendedCfg: {
    bannerTitle: string;
    bannerMessage: string;
  };
  studentYears: string[];
  docLimits: {
    ksmMb: number;
    khsMb: number;
    mlMb: number;
    cvMb: number;
    piMb: number;
    totalMb?: number;
  };
  divisions: DivisionConfig[];
  piTemplateUrl?: string;
  minReasonWords?: number;
  fieldStates?: FieldStates;
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, registrationConfig, extendedCfg, studentYears, docLimits, divisions, piTemplateUrl, minReasonWords = 30, fieldStates = {} } = Astro.props;

const allowedExtsCfg = (registrationConfig as any).allowedFileExtensions || {};
const formatAccept = (extsStr?: string) => (extsStr || "pdf, png, jpg, jpeg")
  .split(',')
  .map((ext: string) => '.' + ext.trim().replace(/^\./, ''))
  .join(',');

const formatExtsLabel = (extsStr?: string) => (extsStr || "pdf, png, jpg, jpeg")
  .split(',')
  .map((e: string) => e.trim().toUpperCase().replace(/^\./, ''))
  .join(', ');

const ksmExts = allowedExtsCfg.ksm || "pdf, png, jpg, jpeg";
const khsExts = allowedExtsCfg.khs || "pdf, png, jpg, jpeg";
const mlExts = allowedExtsCfg.ml || "pdf, png, jpg, jpeg";
const cvExts = allowedExtsCfg.cv || "pdf, png, jpg, jpeg";
const piExts = allowedExtsCfg.pi || "pdf, png, jpg, jpeg";

const ksmExtsDisplay = formatExtsLabel(ksmExts);
const khsExtsDisplay = formatExtsLabel(khsExts);
const mlExtsDisplay = formatExtsLabel(mlExts);
const cvExtsDisplay = formatExtsLabel(cvExts);
const piExtsDisplay = formatExtsLabel(piExts);

const ksmAccept = formatAccept(ksmExts);
const khsAccept = formatAccept(khsExts);
const mlAccept = formatAccept(mlExts);
const cvAccept = formatAccept(cvExts);
const piAccept = formatAccept(piExts);

const ksmState = fieldStates.ksm || 'disabled';
const khsState = fieldStates.khs || 'required';
const mlState = fieldStates.ml || 'required';
const cvState = fieldStates.cv || 'required';
const piState = fieldStates.pi || 'required';

const telpState = fieldStates.nomor_telp || 'required';
const angkatanState = fieldStates.angkatan || 'required';
const div2State = fieldStates.divisi_2 || 'required';
const alasan2State = fieldStates.alasan_divisi_2 || 'required';
const bersediaState = fieldStates.bersedia_dipindah || 'required';
const portoState = fieldStates.portofolio || 'required';

const hasSection3Files = ksmState !== 'disabled' || khsState !== 'disabled' || mlState !== 'disabled' || cvState !== 'disabled' || piState !== 'disabled';

const rawDocs = [
  ksmState !== 'disabled' && {
    id: 'file_ksm',
    label: t('form.ksm', locale),
    maxMb: docLimits.ksmMb,
    accept: ksmAccept,
    exts: ksmExts,
    extsDisplay: ksmExtsDisplay,
    state: ksmState
  },
  khsState !== 'disabled' && {
    id: 'file_khs',
    label: t('form.khs', locale),
    maxMb: docLimits.khsMb,
    accept: khsAccept,
    exts: khsExts,
    extsDisplay: khsExtsDisplay,
    state: khsState
  },
  mlState !== 'disabled' && {
    id: 'file_ml',
    label: t('form.motivationLetter', locale),
    maxMb: docLimits.mlMb,
    accept: mlAccept,
    exts: mlExts,
    extsDisplay: mlExtsDisplay,
    state: mlState
  },
  cvState !== 'disabled' && {
    id: 'file_cv',
    label: t('form.cv', locale),
    maxMb: docLimits.cvMb,
    accept: cvAccept,
    exts: cvExts,
    extsDisplay: cvExtsDisplay,
    state: cvState
  }
];

type DocItem = Exclude<typeof rawDocs[number], false>;
const standardDocs = rawDocs.filter((d): d is DocItem => d !== false);

const docRows: DocItem[][] = [];
for (let i = 0; i < standardDocs.length; i += 2) {
  docRows.push(standardDocs.slice(i, i + 2));
}
---

<div id="view-open" class={(initialStage === 'open' || initialStage === 'extended') ? '' : 'is-hidden'}>
  
  {/* Extended Registration Banner */}
  <div 
    id="extended-banner" 
    class={`extended-banner ${initialStage === 'extended' ? '' : 'is-hidden'}`}
  >
    <h3 class="extended-banner-title">
      <i class="fa-solid fa-bolt"></i> {extendedCfg.bannerTitle}
    </h3>
    <p class="extended-banner-desc">{extendedCfg.bannerMessage}</p>
  </div>

  <div class="registration-header">
    <h2>{registrationConfig.title}</h2>
    <p class="registration-hero-subtitle">{registrationConfig.subtitle}</p>
  </div>

  <FormDescriptionCard 
    title={registrationConfig.formDescriptionTitle} 
    description={registrationConfig.formDescription} 
    items={registrationConfig.formDescriptionItems} 
  />

  {/* Draft Restored Banner */}
  <div id="draft-restored-banner" class="draft-restored-banner is-hidden">
    <div class="draft-restored-content">
      <i class="fa-solid fa-floppy-disk draft-icon"></i>
      <span>Draf formulir dipulihkan dari penyimpanan lokal (<strong id="draft-restored-time"></strong>).</span>
    </div>
    <button type="button" id="banner-clear-draft-btn" class="btn-clear-draft-link">
      <i class="fa-solid fa-trash-can"></i> Hapus Draf
    </button>
  </div>

  {/* Status Alerts */}
  <div id="status-alert-error" class="status-alert-error"></div>
  <div id="status-alert-success" class="status-alert-success"></div>

  {/* Countdown Timer */}
  <div class="registration-timer reg-timer-mb" id="registration-timer">
    <div class="timer-block">
      <div id="timer-days" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Hari</div>
    </div>
    <div class="timer-block">
      <div id="timer-hours" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Jam</div>
    </div>
    <div class="timer-block">
      <div id="timer-minutes" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Menit</div>
    </div>
    <div class="timer-block">
      <div id="timer-seconds" class="reg-timer-val-red">0</div>
      <div class="reg-timer-label">Detik</div>
    </div>
  </div>

  {/* Registration Form */}
  <form id="pendaftaran-form" data-max-total-mb={docLimits.totalMb || 15} data-min-words={minReasonWords} data-locale={locale} data-script-url={import.meta.env.PUBLIC_GOOGLE_SHEET_SCRIPT_URL} data-secret-token={import.meta.env.PUBLIC_RECRUITMENT_SECRET}>
    {/* Anti-bot Honeypot Field */}
    <input type="text" id="website_hp" name="website_hp" class="reg-honeypot-input" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {/* Section 1: Data Diri */}
    <div class="form-section-heading">
      <i class="fa-solid fa-user reg-icon-mr-sm"></i> 1. Data Diri & Akademik
    </div>

    <div class="form-group">
      <label for="nama_lengkap">{t('form.fullName', locale)} <span class="required-asterisk">*</span></label>
      <input type="text" class="form-control" id="nama_lengkap" placeholder={t('form.fullNamePlaceholder', locale)} required />
    </div>

    {angkatanState !== 'disabled' ? (
      <div class="form-row reg-form-row-mt">
        <div class="form-group">
          <label for="nim">{t('form.nim', locale)} <span class="required-asterisk">*</span></label>
          <input type="text" class="form-control" id="nim" placeholder={t('form.nimPlaceholder', locale)} pattern="[0-9]+" required />
        </div>
        <div class="form-group">
          <label for="angkatan">
            {t('form.classYear', locale)}
            {angkatanState === 'required' ? <span class="required-asterisk">*</span> : <span class="reg-file-label-small">(Opsional)</span>}
          </label>
          <select class="form-control" id="angkatan" required={angkatanState === 'required'}>
            <option value="" disabled selected>{t('form.selectClassYear', locale)}</option>
            {studentYears.map(yr => (
              <option value={yr}>{yr}</option>
            ))}
          </select>
        </div>
      </div>
    ) : (
      <div class="form-group reg-form-row-mt">
        <label for="nim">{t('form.nim', locale)} <span class="required-asterisk">*</span></label>
        <input type="text" class="form-control" id="nim" placeholder={t('form.nimPlaceholder', locale)} pattern="[0-9]+" required />
      </div>
    )}

    {telpState !== 'disabled' ? (
      <div class="form-row reg-form-row-mt">
        <div class="form-group">
          <label for="email">{t('form.email', locale)} <span class="required-asterisk">*</span></label>
          <input type="email" class="form-control" id="email" placeholder={t('form.emailPlaceholder', locale)} required />
        </div>
        <div class="form-group">
          <label for="nomor_telp">
            {t('form.phone', locale)}
            {telpState === 'required' ? <span class="required-asterisk">*</span> : <span class="reg-file-label-small">(Opsional)</span>}
          </label>
          <input type="tel" class="form-control" id="nomor_telp" placeholder={t('form.phonePlaceholder', locale)} pattern="[0-9]+" required={telpState === 'required'} />
        </div>
      </div>
    ) : (
      <div class="form-group reg-form-row-mt">
        <label for="email">{t('form.email', locale)} <span class="required-asterisk">*</span></label>
        <input type="email" class="form-control" id="email" placeholder={t('form.emailPlaceholder', locale)} required />
      </div>
    )}

    {/* Section 2: Pemilihan Divisi */}
    <div class="form-section-heading">
      <i class="fa-solid fa-layer-group reg-icon-mr-sm"></i> 2. Pemilihan Divisi & Alasan
    </div>

    {div2State !== 'disabled' ? (
      <div class="form-row">
        <div class="form-group">
          <label for="divisi_1">{t('form.div1', locale)} <span class="required-asterisk">*</span></label>
          <select class="form-control" id="divisi_1" required>
            <option value="" disabled selected>{t('form.selectDiv1', locale)}</option>
            {divisions.map(div => (
              <option value={div.registrationValue || div.id}>{div.registrationLabel || div.name}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label for="divisi_2">
            {t('form.div2', locale)}
            {div2State === 'required' ? <span class="required-asterisk">*</span> : <span class="reg-file-label-small">(Opsional)</span>}
          </label>
          <select class="form-control" id="divisi_2" required={div2State === 'required'}>
            <option value="" disabled selected>{t('form.selectDiv2', locale)}</option>
            {divisions.map(div => (
              <option value={div.registrationValue || div.id}>{div.registrationLabel || div.name}</option>
            ))}
          </select>
        </div>
      </div>
    ) : (
      <div class="form-group">
        <label for="divisi_1">{t('form.div1', locale)} <span class="required-asterisk">*</span></label>
        <select class="form-control" id="divisi_1" required>
          <option value="" disabled selected>{t('form.selectDiv1', locale)}</option>
          {divisions.map(div => (
            <option value={div.registrationValue || div.id}>{div.registrationLabel || div.name}</option>
          ))}
        </select>
      </div>
    )}

    <div class="form-group reg-form-row-mt">
      <label for="alasan_divisi_1">Alasan Memilih Divisi 1 <span class="required-asterisk">*</span></label>
      <textarea class="form-control" id="alasan_divisi_1" rows="3" placeholder={t('form.reasonPlaceholder', locale)} required></textarea>
      <small class="reg-small-desc word-count-info" id="alasan_divisi_1_counter" data-min-words={minReasonWords}>
        Jumlah kata: <span class="word-count-val" id="alasan_divisi_1_count">0</span> / {minReasonWords} kata minimal
      </small>
    </div>

    {alasan2State !== 'disabled' && (
      <div class="form-group reg-form-row-mt">
        <label for="alasan_divisi_2">
          Alasan Memilih Divisi 2
          {alasan2State === 'required' ? <span class="required-asterisk">*</span> : <span class="reg-file-label-small">(Opsional)</span>}
        </label>
        <textarea class="form-control" id="alasan_divisi_2" rows="3" placeholder={t('form.reasonPlaceholder', locale)} required={alasan2State === 'required'}></textarea>
        <small class="reg-small-desc word-count-info" id="alasan_divisi_2_counter" data-min-words={minReasonWords}>
          Jumlah kata: <span class="word-count-val" id="alasan_divisi_2_count">0</span> / {minReasonWords} kata minimal
        </small>
      </div>
    )}

    {/* Dynamic Portfolio Link */}
    {portoState !== 'disabled' && (
      <div
        class="form-group medhum-porto-container"
        id="container-medhum-porto"
        data-porto-state={portoState}
        style={portoState === 'only_trigger' ? 'display: none;' : 'display: block;'}
      >
        <label for="portofolio_medhum" class="medhum-porto-label" id="label-medhum-porto">
          <i class="fa-solid fa-palette reg-icon-mr"></i> {t('form.portfolioLink', locale)}
          <span id="porto-required-indicator">
            <span class="reg-file-label-small">(Opsional)</span>
          </span>
        </label>
        <input type="url" class="form-control" id="portofolio_medhum" placeholder={t('form.portfolioPlaceholder', locale)} required={false} />
        <small class="reg-small-desc" id="porto-help-text">
          {(locale as string) === 'en'
            ? 'Include a link to your public portfolio, best work, or certificates.'
            : 'Sertakan tautan URL publik portofolio, karya terbaik, atau sertifikat pendukung Anda.'}
        </small>
      </div>
    )}

    {bersediaState !== 'disabled' && (
      <div class="form-group reg-form-row-mt">
        <label for="bersedia_dipindah">
          Bersedia dipindahkan ke divisi lain jika diperlukan?
          {bersediaState === 'required' ? <span class="required-asterisk">*</span> : <span class="reg-file-label-small">(Opsional)</span>}
        </label>
        <select class="form-control" id="bersedia_dipindah" required={bersediaState === 'required'}>
          <option value="" disabled selected>-- Pilih Jawaban --</option>
          <option value="Ya">Ya</option>
          <option value="Tidak">Tidak</option>
        </select>
      </div>
    )}

    {/* Section 3: Berkas Pendaftaran */}
    {hasSection3Files && (
      <div class="form-section-heading">
        <i class="fa-solid fa-folder-open reg-icon-mr-sm"></i> 3. Unggah Berkas Pendaftaran
      </div>
    )}

    {docRows.map((row, rIdx) => (
      <div class={`form-row ${rIdx > 0 ? 'reg-form-row-mt' : ''}`}>
        {row.map((doc) => (
          <div class="form-group" style={row.length === 1 ? 'grid-column: 1 / -1;' : ''}>
            <label for={doc.id}>
              {doc.label} <span class="reg-file-label-small">({doc.extsDisplay} • Max {doc.maxMb}MB)</span>
              {doc.state === 'required' ? <span class="required-asterisk">*</span> : <span class="reg-file-label-small">(Opsional)</span>}
            </label>
            <input type="file" class="form-control" id={doc.id} accept={doc.accept} data-allowed-exts={doc.exts} data-max-mb={doc.maxMb} required={doc.state === 'required'} />
          </div>
        ))}
      </div>
    ))}

    {piState !== 'disabled' && (
      <div class="form-group reg-form-row-mt">
        <div class="reg-pi-label-row">
          <label for="file_pi" class="reg-mb-0">
            {t('form.pi', locale)} <span class="reg-file-label-small">({piExtsDisplay} • Max {docLimits.piMb}MB)</span>
            {piState === 'required' ? <span class="required-asterisk">*</span> : <span class="reg-file-label-small">(Opsional)</span>}
          </label>
          {piTemplateUrl && (
            <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="reg-pi-link-inline">
              <i class="fa-solid fa-file-arrow-down"></i>
              <span>{t('form.downloadPiTemplate', locale)}</span>
            </a>
          )}
        </div>
        <input type="file" class="form-control" id="file_pi" accept={piAccept} data-allowed-exts={piExts} data-max-mb={docLimits.piMb} required={piState === 'required'} />
        {piTemplateUrl && (
          <small class="reg-small-desc">
            <span>Belum punya template? <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="reg-pi-sublink">{t('form.downloadPiTemplate', locale)}</a>.</span>
          </small>
        )}
      </div>
    )}

    <div class="form-actions form-actions-submit">
      <button type="submit" id="submit-btn" class="btn btn-primary btn-submit-registration">
        <span id="btn-text">{t('form.submit', locale)} <i class="fa-solid fa-paper-plane reg-icon-ml-xs"></i></span>
      </button>
      <button type="button" id="clear-draft-btn" class="btn btn-clear-draft is-hidden">
        <i class="fa-solid fa-rotate-left"></i> {t('form.saveDraft', locale)}
      </button>
    </div>
  </form>

  <!-- Floating Draft Auto-Save Toast Notification -->
  <div id="draft-toast" class="draft-toast-container is-hidden">
    <i id="draft-toast-icon" class="fa-solid fa-cloud-arrow-up draft-toast-icon"></i>
    <span id="draft-toast-text">{t('form.draftSaved', locale)}</span>
  </div>

  <!-- Clear Draft Confirmation Modal Overlay -->
  <div id="clear-draft-modal" class="progress-modal-overlay is-hidden">
    <div class="progress-modal-card reg-modal-card-sm">
      <div class="progress-modal-header">
        <div class="progress-modal-icon-wrapper reg-modal-icon-red">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h3 class="progress-modal-title">Hapus Draf Pendaftaran?</h3>
        <p class="progress-modal-subtitle reg-modal-subtitle-mt">
          Seluruh isian data yang telah tersimpan di browser ini akan dihapus dan direset.
        </p>
      </div>

      <div class="reg-btn-group reg-form-row-mt">
        <button type="button" id="cancel-clear-draft-btn" class="btn btn-modal-cancel">Batal</button>
        <button type="button" id="confirm-clear-draft-btn" class="btn btn-modal-confirm">Hapus Draf</button>
      </div>
    </div>
  </div>

  <!-- Submission Progress Modal Overlay -->
  <div id="registration-progress-modal" class="progress-modal-overlay is-hidden">
    <div class="progress-modal-card">
      <div class="progress-modal-header">
        <div id="progress-modal-icon" class="progress-modal-icon-wrapper">
          <i class="fa-solid fa-cloud-arrow-up fa-bounce footer-icon-cyan"></i>
        </div>
        <h3 id="progress-modal-title" class="progress-modal-title">{t('form.submitting', locale)}</h3>
        <p id="progress-modal-subtitle" class="progress-modal-subtitle">
          Mohon tetap di halaman ini selagi sistem memproses dokumen dan mengirim data Anda.
        </p>
      </div>

      <!-- Progress Bar & Percentage -->
      <div class="progress-bar-container">
        <div class="progress-bar-header">
          <span id="submit-progress-detail" class="progress-detail-text">Memvalidasi data formulir...</span>
          <span id="submit-progress-percent" class="progress-percent-badge">0%</span>
        </div>
        <div class="progress-bar-track">
          <div id="submit-progress-bar" class="progress-bar-fill"></div>
        </div>
      </div>

      <!-- Stage Checklist -->
      <div class="progress-stages-list">
        <div id="stage-item-1" class="progress-stage-item stage-pending">
          <span id="stage-1-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-1-text" class="stage-label">1. Validasi Berkas & Data</span>
        </div>
        <div id="stage-item-2" class="progress-stage-item stage-pending">
          <span id="stage-2-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-2-text" class="stage-label">2. Mengodekan Dokumen</span>
        </div>
        <div id="stage-item-3" class="progress-stage-item stage-pending">
          <span id="stage-3-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-3-text" class="stage-label">3. Mengirimkan Berkas</span>
        </div>
        <div id="stage-item-4" class="progress-stage-item stage-pending">
          <span id="stage-4-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-4-text" class="stage-label">4. Konfirmasi Server</span>
        </div>
      </div>

      <!-- Modal Action Buttons -->
      <div id="progress-modal-actions" class="progress-modal-actions is-hidden">
        <button type="button" id="modal-close-btn" class="btn btn-primary reg-modal-btn-w">{t('btn.close', locale)}</button>
      </div>
    </div>
  </div>
</div>
