---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/about.json';
---

<Layout title={`${aboutData.title} - EIM Research Lab`}>
  <section class="page-header">
    <div class="container">
      <div class="page-header-content">
        <div class="hero-tag"><span></span> About Us</div>
        <h1>About <span class="text-gradient-red">EIM</span> Research Lab</h1>
        <p class="hero-desc">{aboutData.description}</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="about">
    <div class="container">
      <div class="about-overview-grid mb-80">
        <div class="about-content">
          <h2 class="overview-heading">{aboutData.overviewTitle}</h2>
          <p class="hero-desc mb-20 max-w-full">
            {aboutData.overviewContent1}
          </p>
          <p class="text-secondary mb-20">
            {aboutData.overviewContent2}
          </p>
        </div>
        <div class="about-image flex-center">
          <img src={aboutData.overviewImage} alt="EIM Lab" />
        </div>
      </div>

      <div class="about-visionmission-grid glass-panel mb-80">
        <div class="vm-grid">
          <div>
            <h3 class="vision-heading">
              <i class="fa-solid fa-eye"></i> Vision
            </h3>
            <p class="vm-text">
              {aboutData.vision}
            </p>
          </div>
          <div>
            <h3 class="mission-heading">
              <i class="fa-solid fa-bullseye"></i> Mission
            </h3>
            <ul class="mission-list">
              {aboutData.missions.map((mission) => (
                <li style="margin-bottom: 8px;">{mission}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div>
        <div class="section-title">
          <h2>Our Values</h2>
          <p>Core values that serve as pillars and work culture in EIM Lab.</p>
        </div>

        <div class="focus-grid">
          <div class="focus-card glass-panel">
            <div class="focus-icon text-accent-red">
              <i class="fa-solid fa-handshake"></i>
            </div>
            <h3>Reliability</h3>
            <p>Building trust through a strong and consistent identity in every research and service.</p>
          </div>
          <div class="focus-card glass-panel">
            <div class="focus-icon">
              <i class="fa-solid fa-award"></i>
            </div>
            <h3>Commitment</h3>
            <p>Demonstrating high dedication to creating technology innovations that impact society.</p>
          </div>
          <div class="focus-card glass-panel">
            <div class="focus-icon text-accent-red">
              <i class="fa-solid fa-people-arrows"></i>
            </div>
            <h3>Availability</h3>
            <p>Always present as a platform for collaboration, exchanging ideas, and developing digital science.</p>
          </div>
          <div class="focus-card glass-panel">
            <div class="focus-icon">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <h3>Quality</h3>
            <p>Delivering research work, practical solutions, and training with the highest quality standards.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .mb-80 { margin-bottom: 80px; }
  .mb-20 { margin-bottom: 20px; }
  .max-w-full { max-width: 100%; }
  .text-secondary { color: var(--text-secondary); }
  .text-accent-red { color: var(--accent-red); }
  .flex-center { display: flex; align-items: center; justify-content: center; }
  .overview-heading { font-size: 2rem; margin-bottom: 20px; }
  .vm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; }
  .vision-heading { font-size: 1.8rem; margin-bottom: 16px; color: var(--accent-red); display: flex; align-items: center; gap: 8px; }
  .mission-heading { font-size: 1.8rem; margin-bottom: 16px; color: var(--accent-cyan); display: flex; align-items: center; gap: 8px; }
  .vm-text { color: var(--text-secondary); font-size: 1rem; line-height: 1.6; }
  .mission-list { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; padding-left: 20px; }
</style>
