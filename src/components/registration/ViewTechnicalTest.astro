---
import TimelineSteps from './TimelineSteps.astro';

interface Props {
  initialStage: string;
  technicalTestCfg: {
    title: string;
    subtitle: string;
    message: string;
    scheduleInfo?: string;
    locationInfo?: string;
  };
}

const { initialStage, technicalTestCfg } = Astro.props;
---

<div id="view-technical-test" class={initialStage === 'technical_test' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{technicalTestCfg.title}</h2>
    <p class="registration-hero-subtitle">{technicalTestCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={3} />

  <div class="info-card-panel">
    <i class="fa-solid fa-laptop-code info-card-icon"></i>
    <p class="reg-checklist-notice">{technicalTestCfg.message}</p>
    
    <div class="reg-btn-group">
      {technicalTestCfg.scheduleInfo && (
        <div class="badge-date-info">
          <i class="fa-solid fa-calendar-days reg-icon-mr"></i> Schedule: <strong>{technicalTestCfg.scheduleInfo}</strong>
        </div>
      )}
      {technicalTestCfg.locationInfo && (
        <div class="badge-location-info">
          <i class="fa-solid fa-location-dot reg-checklist-icon"></i> Location: <strong>{technicalTestCfg.locationInfo}</strong>
        </div>
      )}
    </div>
  </div>

  <div class="reg-btn-wrapper">
    <a href="/" class="btn btn-secondary reg-btn-padded">
      <i class="fa-solid fa-house reg-btn-icon-left"></i>Back to Home
    </a>
  </div>
</div>


