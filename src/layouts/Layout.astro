---
import '../styles/globals.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBanner from '../components/common/AnnouncementBanner.astro';
import { getLocaleFromUrl, getLocalizedJsonData } from '../utils/i18n';
import { getCurrentRecruitmentStage } from '../utils/recruitment';
import { applySimulationToConfig } from '../utils/simulation';
import { resolveMediaSrc } from '../utils/media';
import type { ChromeData, SiteData } from '../utils/types';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  homeSkin?: boolean;
  skipLink?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const locale = getLocaleFromUrl(Astro.url);
const siteData = getLocalizedJsonData<SiteData>('site', locale);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = resolveMediaSrc(chrome.brand.logoHorizontal) ?? resolveMediaSrc(siteData.favicon);

const {
  title = siteData.defaultTitle,
  description = siteData.defaultDescription,
  keywords = siteData.defaultKeywords,
  homeSkin = false,
  skipLink = false,
  noindex = false,
  ogType = 'website',
} = Astro.props;
let hasAnnouncement = false;
try {
  const announcementConfig = await getLocalizedJsonData<any>('announcement', locale);
  if (announcementConfig?.enabled !== false) {
    if (announcementConfig?.mode === 'auto_recruitment') {
      // Mirror AnnouncementBanner: a closed recruitment stage suppresses the
      // banner, so the body class (and its 122px header offset) must follow.
      let registrationConfig = await getLocalizedJsonData<any>('registration', locale);
      const simQueryParam = Astro.url.searchParams.get('sim');
      const stageQueryParam =
        Astro.url.searchParams.get('stage') || Astro.url.searchParams.get('sim_stage');
      if ((simQueryParam || stageQueryParam) && registrationConfig) {
        registrationConfig = applySimulationToConfig(
          registrationConfig,
          simQueryParam ? parseInt(simQueryParam, 10) || 30 : 30,
          Date.now(),
          stageQueryParam
        );
      }
      hasAnnouncement = getCurrentRecruitmentStage(registrationConfig) !== 'closed';
    } else {
      hasAnnouncement = true;
    }
  }
} catch (e) {}
---

<!DOCTYPE html>
<html lang="id" data-scroll-behavior="smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteData.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Dynamic favicon type helper */}
    {(() => {
      const fav = resolveMediaSrc(siteData.favicon) ?? 'https://cdn.eimlab.org/1795019785636_eim-favicon.png';
      const pathname = fav.split(/[?#]/)[0].toLowerCase();
      let type = 'image/x-icon';
      if (pathname.endsWith('.png')) type = 'image/png';
      else if (pathname.endsWith('.svg')) type = 'image/svg+xml';
      else if (pathname.endsWith('.avif')) type = 'image/avif';
      return <link rel="icon" type={type} href={fav} referrerpolicy="no-referrer" />;
    })()}
    
    {/* Preconnect to Font origins for early connection establishment */}
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    {/* FontAwesome custom subset icons */}
    <script>
      import '../styles/icons.css';
    </script>
  </head>
  <body
    id="top"
    class:list={[hasAnnouncement && 'has-announcement-banner', homeSkin && 'home-skin']}
  >
    {skipLink && <a class="skip-link" href="#main-content">Lewati ke konten</a>}
    <header class="site-header" id="site-header">
      <AnnouncementBanner />
      <Navbar />
    </header>
    <slot />
    <Footer />
  </body>
</html>
