---
import Layout from '../layouts/Layout.astro';
import membersData from '../data/members.json';
import divisions from '../data/divisions.json';

const initialMembers = membersData.list || [];
const divisionMap = new Map(divisions.map(d => [d.id, d]));
---

<Layout title="Organizational Structure - EIM Research Lab">
  <section class="page-header" style="padding-top: 150px; padding-bottom: 50px;">
    <div class="container">
      <div class="page-header-content">
        <h1>Organizational <span class="text-gradient-cyan">Structure</span></h1>
        <p style="margin-top: 15px; color: var(--text-secondary);">Meet the EIM laboratory assistants in each division.</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="structure">
    <div class="container">
      <div class="filter-container" id="filter-tabs" data-divisions={JSON.stringify(divisions)}>
        <button class="filter-tab active" data-filter="all">All Divisions</button>
        {divisions.map(div => (
          <button class="filter-tab" data-filter={div.id}>{div.name}</button>
        ))}
      </div>

      <div class="member-grid" id="member-grid">
        {initialMembers.map((member, idx) => {
          const divInfo = divisionMap.get(member.division);
          const borderColor = divInfo?.borderColor || 'rgba(255, 255, 255, 0.1)';
          const roleColor = divInfo?.roleColor || 'var(--text-secondary)';
          return (
            <div 
              class={`member-card glass-panel member-card-item div-${member.division}`} 
              data-division={member.division}
              style={`animation-delay: ${idx * 0.04}s; border-color: ${borderColor};`}
            >
              <div class="member-avatar-wrapper">
                <div class="member-avatar" style={member.image ? "background: transparent;" : ""}>
                  {member.image ? (
                    <img
                      src={member.image}
                      alt={member.name}
                      style={`width: 100%; height: 100%; object-fit: cover; border-radius: inherit; display: block; ${member.scale ? `transform: scale(${member.scale});` : ''} ${member.position ? `transform-origin: ${member.position};` : ''}`}
                    />
                  ) : (
                    <i class="fa-solid fa-user" style="font-size: 2.5rem; opacity: 0.5;"></i>
                  )}
                </div>
              </div>
              <div class="member-info">
                <h3>{member.name}</h3>
                <div class="member-role" style={`color: ${roleColor};`}>{member.role}</div>
                <span class="member-div">
                  {divInfo?.displayName || member.division.toUpperCase()}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initStructureFilter } from '../scripts/structure-filter';
  initStructureFilter();
</script>
