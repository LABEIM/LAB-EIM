---
import { getLocaleFromUrl, getLocalizedPath } from '../../utils/i18n';

interface Props {
  initialStage: string;
  fallbackCfg: {
    title: string;
    subtitle: string;
    message: string;
    formUrl: string;
    buttonText?: string;
  };
  piTemplateUrl?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, fallbackCfg, piTemplateUrl } = Astro.props;
---

<div id="view-fallback" class={initialStage === 'fallback' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{fallbackCfg.title}</h2>
    <p class="registration-hero-subtitle">{fallbackCfg.subtitle}</p>
  </div>

  <div class="info-card-panel">
    <i class="fa-solid fa-triangle-exclamation info-card-icon reg-icon-yellow"></i>
    <p class="reg-msg-p">{fallbackCfg.message}</p>

    <div class="reg-btn-group">
      {piTemplateUrl && (
        <a 
          href={piTemplateUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary reg-btn-action-padded"
        >
          <i class="fa-solid fa-file-pdf reg-btn-icon-abs reg-btn-icon-red"></i>{locale === 'en' ? 'Download Integrity Pact Template' : 'Download Template Pakta Integritas'}
        </a>
      )}

      <a 
        href={fallbackCfg.formUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-primary reg-btn-action-padded"
      >
        <i class="fa-solid fa-arrow-up-right-from-square reg-btn-icon-abs"></i>{fallbackCfg.buttonText || (locale === 'en' ? 'Open External Backup Form' : 'Buka Formulir Pendaftaran Cadangan')}
      </a>
    </div>

    <div class="reg-border-top-box">
      <a href={getLocalizedPath('/', locale)} class="btn btn-secondary reg-btn-padded">
        <i class="fa-solid fa-house reg-btn-icon-abs"></i>{locale === 'en' ? 'Back to Home' : 'Kembali ke Beranda'}
      </a>
    </div>
  </div>
</div>
