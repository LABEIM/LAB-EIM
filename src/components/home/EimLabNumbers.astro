---
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  dosen: number;
  anggota: number;
  asisten: number;
}

const { dosen, anggota, asisten } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

const stats = [
  { label: t('home.numbersDosen', locale), value: dosen },
  { label: t('home.numbersAnggota', locale), value: anggota },
  { label: t('home.numbersAsisten', locale), value: asisten },
];
---

<section class="pb-[clamp(3rem,7vh,5rem)]" aria-label={t('home.numbersLabel', locale)}>
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <dl class="e-reveal grid grid-cols-1 border-y border-line sm:grid-cols-3">
      {stats.map((stat) => (
        <div class="flex flex-col-reverse items-center gap-3 border-b border-line py-10 text-center last:border-b-0 sm:border-b-0 sm:border-r sm:px-8 sm:last:border-r-0">
          <dt class="font-mono text-xs uppercase tracking-[0.08em] text-muted-ink">{stat.label}</dt>
          <dd class="font-display text-[clamp(3.5rem,7vw,6rem)] leading-none">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
