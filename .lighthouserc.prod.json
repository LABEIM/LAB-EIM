{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless"
      },
      "urls": [
        "http://localhost:4321/",
        "http://localhost:4321/about/",
        "http://localhost:4321/contact/",
        "http://localhost:4321/structure/",
        "http://localhost:4321/registration/",
        "http://localhost:4321/event/",
        "http://localhost:4321/news/",
        "http://localhost:4321/event/audit-benchmark-event/",
        "http://localhost:4321/news/audit-benchmark-news/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          { "minScore": 0.8 }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.9 }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.9 }
        ],
        "categories:seo": [
          "error",
          { "minScore": 0.9 }
        ],
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
