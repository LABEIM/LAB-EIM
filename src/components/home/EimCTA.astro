---
import { getLocaleFromUrl, t } from '../../utils/i18n';
import { resolveStageCta } from '../../utils/constants';

interface Props {
  site: any;
}

const { site } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const contact = site?.contact ?? {};
const primaryCta = resolveStageCta('closed');
---

<section id="gabung" class="eim-cta" aria-labelledby="eim-cta-title">
  <div class="mx-auto grid max-w-[1200px] items-end gap-10 px-[clamp(1.25rem,4vw,4rem)] py-[clamp(4.5rem,10vh,8.75rem)] lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)]">
    <div>
      <h2 id="eim-cta-title" class="text-background font-display text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.02] tracking-[-0.01em]">
        {t('about.ctaTitle', locale)}
      </h2>
      <p class="mt-5 max-w-[52ch] text-[15px] leading-[1.6] text-surface-strong">{t('about.ctaDesc', locale)}</p>
    </div>
    <div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <a class="eim-cta-primary" href={primaryCta.href} data-stage-primary>{primaryCta.label}</a>
        <a class="eim-cta-secondary" href="/contact" data-stage-secondary>{t('about.ctaContact', locale)} <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-10 border-t border-white/15 pt-4 font-mono text-xs uppercase tracking-[0.08em] text-surface-strong">
        <p>{contact.location}</p>
        <a class="mt-2 inline-block text-brand-bright underline underline-offset-4" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
    </div>
  </div>
</section>
