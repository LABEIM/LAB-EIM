# Peer dependency resolution workaround
# Required because @keystatic/astro and @astrojs/cloudflare have conflicting
# peer dependency requirements on the 'astro' package version range.
# The 'overrides' field in package.json partially addresses this, but npm's
# strict peer dep resolution still flags transitive conflicts.
# TODO: Remove when upstream packages align their peer dep ranges.
legacy-peer-deps=true
