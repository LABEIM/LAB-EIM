---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home-eim.css';
import '../../styles/pages/kegiatan-eim.css';
import KegiatanRecapHero from '../../components/kegiatan/KegiatanRecapHero.astro';
import KegiatanStory from '../../components/kegiatan/KegiatanStory.astro';
import PhotoGallery from '../../components/common/PhotoGallery.astro';
import KegiatanRelated from '../../components/kegiatan/KegiatanRelated.astro';
import {
  getCleanSlug,
  getCollectionEntriesForLocale,
  getLocaleFromUrl,
  getLocalizedJsonData,
} from '../../utils/i18n';
import { filterAuditContent } from '../../utils/content-helpers';
import { sectionOn } from '../../utils/page-content';
import {
  compareEventDates,
  getEventStoryGallery,
} from '../../utils/event-helpers';
import type { ChromeData, EventDetailPageData } from '../../utils/types';
import type { EventEntry } from '../../utils/event-helpers';

export async function getStaticPaths() {
  const events = await getCollection('events');
  // Intentionally includes audit content: CI benchmarks this route.
  return events.map((event) => ({
    params: { id: getCleanSlug(event.id) },
    props: { event },
  }));
}

interface Props {
  event: EventEntry;
}

const locale = getLocaleFromUrl(Astro.url);
const { event } = Astro.props;
const { Content } = await render(event);

const page = getLocalizedJsonData<EventDetailPageData>('pages/event-detail', locale);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);

const all = filterAuditContent(getCollectionEntriesForLocale(await getCollection('events'), locale));
// Sort once, then keep same-category entries first (filters preserve order).
const pool = all
  .filter((item) => item.id !== event.id)
  .sort((a, b) => compareEventDates(a, b, 'desc'));
const related = [
  ...pool.filter((item) => item.data.category === event.data.category),
  ...pool.filter((item) => item.data.category !== event.data.category),
].slice(0, 3);
const gallery = getEventStoryGallery(event);
---

<Layout
  title={`${event.data.title} · ${page.meta.title}`}
  description={event.data.description}
  homeSkin
  skipLink
  noindex={event.data.audit === true}
>
  <main id="main-content" tabindex="-1">
    <KegiatanRecapHero
      event={event}
      locale={locale}
      content={page.hero}
      share={page.share}
      organizerFallback={chrome.labels.organizerFallback}
    />
    {sectionOn(page.story) && (
      <KegiatanStory event={event}>
        <Content />
      </KegiatanStory>
    )}
    {sectionOn(page.gallery) && (
      <PhotoGallery
        images={gallery}
        eyebrow={page.gallery.eyebrow}
        title={page.gallery.title}
        altLabel={event.data.title}
      />
    )}
    {sectionOn(page.gallery) && !event.body?.trim() && gallery.length === 0 && (
      <p class="kegiatan-recap-empty">{page.gallery.empty}</p>
    )}
    {sectionOn(page.related) && (
      <KegiatanRelated events={related} locale={locale} content={page.related} />
    )}
    {sectionOn(page.backLink) && (
      <div class="kegiatan-recap-end">
        <a class="kegiatan-back" href="/event">{page.backLink.label}</a>
      </div>
    )}
  </main>
</Layout>

<script>
  import { initShareButtons } from '../../scripts/share';
  initShareButtons('Kegiatan');
</script>
