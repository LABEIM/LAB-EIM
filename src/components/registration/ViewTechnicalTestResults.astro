---
import TimelineSteps from './TimelineSteps.astro';
import NimSearchBox from './NimSearchBox.astro';
import BackToHomeButton from './BackToHomeButton.astro';
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  initialStage: string;
  technicalTestResultsCfg: {
    title: string;
    subtitle: string;
    newsUrl?: string;
    documentUrl?: string;
  };
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, technicalTestResultsCfg } = Astro.props;
---

<div id="view-technical-test-results" class={initialStage === 'technical_test_results' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{technicalTestResultsCfg.title}</h2>
    <p class="registration-hero-subtitle">{technicalTestResultsCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={3} markCurrentAsCompleted={true} />

  {/* NIM Search Box for Technical Test Results */}
  <NimSearchBox
    title={locale === 'en' ? "Check Technical Test Result" : "Cek Hasil Tes Teknikal"}
    inputId="search-tech-nim-input"
    buttonId="search-tech-nim-btn"
    resultBoxId="search-tech-result-box"
    buttonLabel={t('btn.search', locale)}
  />

  <BackToHomeButton />
</div>
