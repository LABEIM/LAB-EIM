---
import type { DivisionPanel } from '../../utils/types';
import { DIVISION_MEDIA } from './division-media';
import { t, DEFAULT_LOCALE } from '../../utils/i18n';

interface Props {
  panels: DivisionPanel[];
}

const { panels } = Astro.props;
---

<section id="divisi" class="py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="eim-divisions-title">
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <h2
        id="eim-divisions-title"
        class="e-reveal font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
      >
        {t('struct.divisions')}
      </h2>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('home.divIntro')}
      </p>
    </div>

    <div class="e-reveal-group mt-[clamp(2.5rem,6vh,4.5rem)] flex flex-col gap-[clamp(3.5rem,8vh,6rem)]">
      {panels.map((panel, index) => {
        const media = DIVISION_MEDIA[panel.id] ?? [];
        const flip = index % 2 === 1;

        return (
          <article
            class="div-row grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-16"
            style={`--i:${index}`}
          >
            <div class:list={['flex flex-col', flip && 'lg:order-2']}>
              <span class="font-mono text-xs tracking-[0.08em] text-muted-ink">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-[clamp(1.75rem,3vw,2.75rem)] leading-[1.1] tracking-[-0.01em]">
                {panel.displayName}
              </h3>
              <p class="mt-4 max-w-[46ch] text-[15px] leading-[1.6] text-muted-ink">
                {panel.description}
              </p>
              <p class="mt-5 font-mono text-xs tracking-[0.08em] text-muted-ink">
                {t('home.memberCount', DEFAULT_LOCALE, { n: String(panel.memberCount) })}
                {panel.coordinator && <span> · Koordinator: {panel.coordinator.name}</span>}
              </p>
              <a
                href={panel.href}
                class="mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.08em]"
              >
                <span class="text-brand">{t('home.divisionLink')}</span>
                <span class="text-brand" aria-hidden="true">→</span>
              </a>
            </div>

            <div
              class:list={[
                'div-media aspect-[4/3] overflow-hidden rounded-media border border-line bg-surface',
                media.length > 1 ? 'grid grid-cols-2 gap-2' : 'grid',
                flip && 'lg:order-1',
              ]}
            >
              {media.length > 0 ? (
                media.slice(0, 2).map((src) => (
                  <img
                    src={src}
                    alt={`Kegiatan divisi ${panel.displayName}`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                ))
              ) : (
                <span class="flex h-full w-full items-end bg-surface-strong p-5 font-mono text-xs uppercase tracking-[0.08em] text-muted-ink">
                  {t('home.divisionPhoto', DEFAULT_LOCALE, { name: panel.displayName })}
                </span>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
