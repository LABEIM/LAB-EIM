---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getLocaleFromUrl, getCleanSlug, getLocalizedPath, t } from '../../../utils/i18n';

export async function getStaticPaths() {
  const events = await getCollection('events');
  const idEntries = events.filter(e => e.id.startsWith('id/'));
  const allSlugs = new Set([
    ...idEntries.map(e => getCleanSlug(e.id)),
    ...events.map(e => getCleanSlug(e.id))
  ]);

  return Array.from(allSlugs).map((slug) => {
    const enEvent = events.find(e => e.id === `en/${slug}`);
    const idEvent = events.find(e => e.id === `id/${slug}`);
    return {
      params: { id: slug },
      props: { event: enEvent || idEvent! },
    };
  });
}

const locale = getLocaleFromUrl(Astro.url);
const { event } = Astro.props;
const images = event.data.image || [];
const benefits = event.data.benefits || [];
const requirements = event.data.requirements || [];

const isOngoing = event.data.status === 'ongoing';
const isCompleted = event.data.status === 'completed';
const statusColor = isOngoing ? '#ff9800' : '#11B4BD';
const statusIcon = isCompleted ? 'fa-circle-check' : (isOngoing ? 'fa-spinner fa-spin' : 'fa-clock');
const statusLabel = isCompleted ? t('badge.completed', locale) : (isOngoing ? t('badge.ongoing', locale) : t('badge.upcoming', locale));
---

<Layout title={`${event.data.title} - EIM Research Lab`}>
  <div class="page-min-height">
    {/* Top Section */}
    <section class="detail-header-section">
      <div class="container">
        <a href={getLocalizedPath('/event', locale)} class="hover-text-primary back-link">
          <i class="fa-solid fa-arrow-left"></i> {t('btn.back', locale)}
        </a>
        
        <div class="header-title-row">
          <div>
            <h1 class="event-title">{event.data.title}</h1>
            <div class="organizer-badge">
              <i class="fa-solid fa-users"></i> EIM Research Lab
            </div>
          </div>
          
          <button class="hover-bg-light share-btn action-share-btn">
            <i class="fa-solid fa-share-nodes"></i> Share
          </button>
        </div>
      </div>
    </section>

    {/* Main Content Section */}
    <section class="content-section">
      <div class="container responsive-grid">
        
        {/* Left Column */}
        <div class="main-column">
          
          {/* Description */}
          <div>
            <h3 class="section-subheading">
              <i class="fa-solid fa-circle-info"></i> {locale === 'en' ? 'Event Description' : 'Deskripsi Kegiatan'}
            </h3>
            <p class="section-body-text">
              {event.data.description}
            </p>
          </div>

          {/* Benefits */}
          {benefits.length > 0 && (
            <div>
              <h3 class="section-subheading">
                <i class="fa-solid fa-gift"></i> {t('events.benefits', locale)}
              </h3>
              <ul class="section-list">
                {benefits.map(b => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Requirements */}
          {requirements.length > 0 && (
            <div>
              <h3 class="section-subheading">
                <i class="fa-solid fa-circle-check"></i> {t('events.requirements', locale)}
              </h3>
              <ul class="section-list">
                {requirements.map(r => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Documentation */}
          {images.length > 0 && (
            <div>
              <h3 class="section-subheading">
                <i class="fa-solid fa-image"></i> {locale === 'en' ? 'Documentation' : 'Dokumentasi'}
              </h3>
              <div class="doc-images-grid">
                {images.map((img, idx) => (
                  <div class="doc-img-wrapper">
                    <img src={img} alt={`Documentation ${idx + 1}`} class="hover-scale doc-img" />
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

        {/* Right Column (Sidebar) */}
        <div class="glass-panel sidebar-card">
          <h3 class="sidebar-title">
            {locale === 'en' ? 'Key Information' : 'Informasi Utama'}
          </h3>
          
          <div class="sidebar-info-group">
            {/* Date */}
            <div class="info-item">
              <div class="info-icon-box">
                <i class="fa-regular fa-calendar"></i>
              </div>
              <div>
                <div class="info-label">{t('events.date', locale)}</div>
                <div class="info-val">{event.data.event_date || "-"}</div>
              </div>
            </div>

            {/* Status */}
            <div class="info-item">
              <div class="info-icon-box" style={`color: ${statusColor};`}>
                <i class={`fa-solid ${statusIcon}`}></i>
              </div>
              <div>
                <div class="info-label">Status</div>
                <div class="info-val">{statusLabel}</div>
              </div>
            </div>

            {/* Category */}
            <div class="info-item">
              <div class="info-icon-box">
                <i class="fa-solid fa-tag"></i>
              </div>
              <div>
                <div class="info-label">{locale === 'en' ? 'Category' : 'Kategori'}</div>
                <div class="info-val">{event.data.category || "-"}</div>
              </div>
            </div>
          </div>

          {event.data.show_register && event.data.status !== 'completed' && (
            <>
              <a href={getLocalizedPath('/registration', locale)} class="btn btn-primary register-btn">
                {t('btn.register', locale)}
              </a>
            </>
          )}
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { initShareButtons } from '../../../scripts/share';
  initShareButtons('Event');
</script>
