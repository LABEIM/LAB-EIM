---
import { positionLabel } from '../../utils/position-mapper';
import type { Lecturer, Position } from '../../utils/types';

interface Props {
  lecturer: Lecturer;
  positionIndex: Map<string, Position>;
}

const { lecturer, positionIndex } = Astro.props;

const hasImage = Boolean(lecturer.image.trim());
const hasName = Boolean(lecturer.name.trim());
const label = positionLabel(positionIndex, lecturer.role);
---

<article class="lecturer-card">
  <span class="lecturer-card-media">
    <img
      src={hasImage ? lecturer.image : '/image/placeholder-avatar.svg'}
      alt=""
      loading="lazy"
      decoding="async"
      style={hasImage
        ? `transform: scale(${lecturer.scale || '1'}); transform-origin: ${lecturer.position || 'center'};`
        : undefined}
    />
  </span>
  <span class="lecturer-card-body">
    <h3 class="lecturer-card-name">{hasName ? lecturer.name : label}</h3>
    {hasName && <p class="lecturer-card-role">{label}</p>}
  </span>
</article>
