---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/cards/NewsCard.astro';
import { getLocaleFromUrl, getCleanSlug, getLocalizedPath, getCollectionEntriesForLocale, t } from '../../utils/i18n';
import { calculateReadingTime, getRelatedNews } from '../../utils/news-helpers';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item: any) => {
    const slug = getCleanSlug(item.id);
    return {
      params: { id: slug },
      props: { item },
    };
  });
}

const locale = getLocaleFromUrl(Astro.url);
const { item } = Astro.props;
const images = item.data.image || [];
const tags = item.data.tags || [];
const { Content } = await render(item);

const rawAllNews = await getCollection('news');
const allNews = getCollectionEntriesForLocale(rawAllNews, locale);
const relatedNews = getRelatedNews(item.id, allNews, 3);

const formattedDate = new Date(item.data.news_date).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const readTime = calculateReadingTime(item.body);
const metaDesc = item.data.excerpt || `${item.data.title} - EIM Research Lab`;
---

<Layout title={`${item.data.title} - EIM Research Lab`} description={metaDesc}>
  <div class="page-min-height">
    {/* Top Section */}
    <section class="detail-header-section">
      <div class="container">
        <a href={getLocalizedPath('/news', locale)} class="hover-text-primary back-link">
          <i class="fa-solid fa-arrow-left"></i> {t('btn.back', locale)}
        </a>
        
        <div class="header-title-row">
          <div>
            {item.data.featured && (
              <span class="detail-featured-badge">
                <i class="fa-solid fa-thumbtack"></i> Berita Utama
              </span>
            )}
            <h1 class="news-title">{item.data.title}</h1>
            <div class="author-badge-row">
              <span class="author-badge">
                <i class="fa-regular fa-building"></i> {item.data.author}
              </span>
              <span class="meta-dot">•</span>
              <span class="read-time-badge">
                <i class="fa-regular fa-clock"></i> {readTime}
              </span>
            </div>
          </div>
          
          <button class="hover-bg-light share-btn action-share-btn">
            <i class="fa-solid fa-share-nodes"></i> Share
          </button>
        </div>
      </div>
    </section>

    {/* Main Content Section */}
    <section class="content-section">
      <div class="container responsive-grid">
        
        {/* Left Column */}
        <div class="main-column">
          
          {/* Cover Image */}
          {images.length > 0 && (
            <div class="cover-image-wrapper">
              <Image src={images[0]} alt={item.data.title} width={800} height={450} class="cover-image" />
            </div>
          )}

          {/* Excerpt Lead Box */}
          {item.data.excerpt && (
            <div class="news-lead-box glass-panel">
              <p>{item.data.excerpt}</p>
            </div>
          )}

          {/* Content */}
          <div class="news-content-body">
            <Content />
          </div>

          {/* Article Tags */}
          {tags.length > 0 && (
            <div class="article-tags-section">
              <span class="tags-label"><i class="fa-solid fa-tags"></i> Topik:</span>
              <div class="article-tags-list">
                {tags.map((tag: string) => (
                  <span class="article-tag-chip">#{tag}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Right Column (Sidebar) */}
        <div class="glass-panel sidebar-card">
          <h3 class="sidebar-title">
            Informasi Berita
          </h3>
          
          <div class="sidebar-info-group">
            {/* Date */}
            <div class="info-item">
              <div class="info-icon-box">
                <i class="fa-regular fa-calendar-days"></i>
              </div>
              <div>
                <div class="info-label">{t('news.date', locale)}</div>
                <div class="info-val">{formattedDate}</div>
              </div>
            </div>

            {/* Reading Time */}
            <div class="info-item">
              <div class="info-icon-box">
                <i class="fa-regular fa-clock"></i>
              </div>
              <div>
                <div class="info-label">Waktu Baca</div>
                <div class="info-val">{readTime}</div>
              </div>
            </div>

            {/* Category */}
            <div class="info-item">
              <div class="info-icon-box">
                <i class="fa-solid fa-tag"></i>
              </div>
              <div>
                <div class="info-label">Kategori</div>
                <div class="info-val">{item.data.category || "-"}</div>
              </div>
            </div>

            {/* Author */}
            <div class="info-item">
              <div class="info-icon-box">
                <i class="fa-solid fa-pen-nib"></i>
              </div>
              <div>
                <div class="info-label">{t('news.author', locale)}</div>
                <div class="info-val">{item.data.author || "-"}</div>
              </div>
            </div>
          </div>

          <button class="btn btn-secondary share-btn share-sidebar-btn">
            <i class="fa-solid fa-share-nodes"></i> Share News
          </button>
        </div>
      </div>
    </section>

    {/* Related News Section */}
    {relatedNews.length > 0 && (
      <section class="section-padding related-news-section">
        <div class="container">
          <div class="section-title">
            <h2>Berita Terkait</h2>
            <p>Baca juga artikel dan pengumuman menarik lainnya dari EIM Research Lab.</p>
          </div>
          <div class="news-grid">
            {relatedNews.map(relItem => (
              <NewsCard news={relItem} showButton={true} />
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  import { initShareButtons } from '../../scripts/share';
  initShareButtons('News');
</script>
