---
import Layout from '../layouts/Layout.astro';
import StatusPage from '../components/common/StatusPage.astro';
import '../styles/pages/home-eim.css';
import { getLocaleFromUrl, getLocalizedJsonData } from '../utils/i18n';
import type { ChromeData, SiteData } from '../utils/types';

const locale = getLocaleFromUrl(Astro.url);
const site = getLocalizedJsonData<SiteData>('site', locale);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);
const email = site.contact?.email || 'lab@eimlab.org';
const siteName = [site.name, site.subName].filter(Boolean).join(' ') || 'EIM Lab';
---

<Layout
  title={`Pemeliharaan ${chrome.ui.titleSuffix}`}
  description="Situs EIM Lab sedang dalam pemeliharaan."
  homeSkin
  minimal
  noindex
>
  <StatusPage
    code="Pemeliharaan"
    eyebrow={siteName}
    title="Situs sedang dalam pemeliharaan."
    description="Kami sedang memperbarui layanan. Silakan kembali beberapa saat lagi."
    standalone
  >
    <a class="mt-6 text-[15px] text-brand underline underline-offset-4" href={`mailto:${email}`}>
      {email}
    </a>
  </StatusPage>
</Layout>

<style is:global>
  /* The decorative 700px body::after glow starts at 40% and extends past a
     single-screen page, adding a phantom 160px scroll. Keep it in the box. */
  body:has(.status-standalone)::after {
    top: auto;
    bottom: 0;
  }
</style>
