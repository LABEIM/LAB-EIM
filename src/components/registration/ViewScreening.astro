---
import TimelineSteps from './TimelineSteps.astro';
import StageInfoPanel from './StageInfoPanel.astro';
import BackToHomeButton from './BackToHomeButton.astro';

interface Props {
  initialStage: string;
  selectionCfg: {
    title: string;
    subtitle: string;
    message: string;
    estimatedAnnouncementDate?: string;
  };
}

const { initialStage, selectionCfg } = Astro.props;
---

<div id="view-selection" class={initialStage === 'selection' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{selectionCfg.title}</h2>
    <p class="registration-hero-subtitle">{selectionCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={2} />

  <StageInfoPanel
    iconClass="fa-clipboard-check"
    message={selectionCfg.message}
    estimatedAnnouncementDate={selectionCfg.estimatedAnnouncementDate}
  />

  <BackToHomeButton />
</div>
