---
import type { Member } from '../../utils/types';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import MemberTile from './MemberTile.astro';

interface Props {
  members: Member[];
  locale: Locale;
}

const { members, locale } = Astro.props;
---

<section
  id="inti"
  class="border-t border-line py-[clamp(4.5rem,10vh,8.75rem)]"
  aria-labelledby="struct-core-title"
>
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">
          02 — {t('struct.coreEyebrow', locale)}
        </p>
        <h2
          id="struct-core-title"
          class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
        >
          {t('struct.coreTitle', locale)}
        </h2>
      </div>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('struct.coreIntro', locale)}
      </p>
    </div>

    <div class="e-reveal-group mt-[clamp(2.5rem,6vh,4rem)] grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-3">
      {members.map((member, index) => <MemberTile member={member} index={index} />)}
    </div>
  </div>
</section>
