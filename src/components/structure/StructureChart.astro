---
import type { Position } from '../../utils/types';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import StructureNode from './StructureNode.astro';

interface Props {
  positions: Position[];
  locale: Locale;
}

const { positions, locale } = Astro.props;

const byId = new Map(positions.map((position) => [position.id, position]));
const pick = (ids: string[]): Position[] =>
  ids.map((id) => byId.get(id)).filter((position): position is Position => Boolean(position));

const lead = pick(['ketua-lab']);
const deputy = pick(['wakil-ketua-lab']);
const branch = pick(['dosen-anggota', 'koordinator-matkul', 'koordinator-asisten']);
const praktikum = pick([
  'asisten-koordinator-praktikum',
  'mahasiswa-anggota',
  'tim-adhoc',
]);
---

<section
  id="struktur"
  class="pt-[clamp(2rem,5vh,3.5rem)] pb-[clamp(4.5rem,10vh,8.75rem)]"
  aria-labelledby="struct-chart-title"
>
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <h2
        id="struct-chart-title"
        class="e-reveal font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
      >
        {t('struct.chartTitle', locale)}
      </h2>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('struct.chartIntro', locale)}
      </p>
    </div>

    <div
      class="mt-[clamp(2.5rem,6vh,4rem)] rounded-media border border-line bg-surface p-[clamp(1.25rem,4vw,3rem)]"
    >
      <div class="org-tree e-reveal" role="img" aria-label={t('struct.chartLabel', locale)}>
        {lead.map((position) => (
          <div class="org-tier">
            <StructureNode position={position} locale={locale} />
          </div>
        ))}

        <span class="org-stem" aria-hidden="true"></span>

        {deputy.map((position) => (
          <div class="org-tier">
            <StructureNode position={position} locale={locale} />
          </div>
        ))}

        <span class="org-stem" aria-hidden="true"></span>
        <div class="org-branch--three" aria-hidden="true"></div>

        <div class="org-tier org-tier--three">
          {branch.slice(0, 2).map((position) => (
            <StructureNode position={position} locale={locale} />
          ))}

          <div class="org-column">
            {branch[2] && <StructureNode position={branch[2]} locale={locale} />}
            <span class="org-stem" aria-hidden="true"></span>
            <div class="org-tier org-tier--stack">
              {praktikum.map((position) => (
                <StructureNode position={position} locale={locale} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
