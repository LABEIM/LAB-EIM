---
import TimelineSteps from './TimelineSteps.astro';
import NimSearchBox from './NimSearchBox.astro';
import BackToHomeButton from './BackToHomeButton.astro';
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  initialStage: string;
  selectionResultsCfg: {
    title: string;
    subtitle: string;
    newsUrl?: string;
    documentUrl?: string;
  };
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, selectionResultsCfg } = Astro.props;
---

<div id="view-selection-results" class={initialStage === 'selection_results' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{selectionResultsCfg.title}</h2>
    <p class="registration-hero-subtitle">{selectionResultsCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={2} markCurrentAsCompleted={true} />

  {/* NIM Search Box for Screening Results */}
  <NimSearchBox
    title="Cek Hasil Seleksi Berkas"
    inputId="search-screening-nim-input"
    buttonId="search-screening-nim-btn"
    resultBoxId="search-screening-result-box"
    buttonLabel={t('btn.search', locale)}
  />

  <BackToHomeButton />
</div>
