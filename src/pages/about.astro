---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/about.json';

interface ValueItem {
  title: string;
  description: string;
  icon: string;
  isAccent?: boolean;
}

const values: ValueItem[] = aboutData.values || [
  {
    title: "Reliability",
    description: "Building trust through a strong and consistent identity in every research and service.",
    icon: "fa-handshake",
    isAccent: true
  },
  {
    title: "Commitment",
    description: "Demonstrating high dedication to creating technology innovations that impact society.",
    icon: "fa-award",
    isAccent: false
  },
  {
    title: "Availability",
    description: "Always present as a platform for collaboration, exchanging ideas, and developing digital science.",
    icon: "fa-people-arrows",
    isAccent: true
  },
  {
    title: "Quality",
    description: "Delivering research work, practical solutions, and training with the highest quality standards.",
    icon: "fa-circle-check",
    isAccent: false
  }
];
---

<Layout title={`${aboutData.title} - EIM Research Lab`}>
  <section class="page-header">
    <div class="container">
      <div class="page-header-content">
        <div class="hero-tag"><span></span> About Us</div>
        <h1>About <span class="text-gradient-red">EIM</span> Research Lab</h1>
        <p class="hero-desc">{aboutData.description}</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="about">
    <div class="container">
      <div class="about-overview-grid mb-80">
        <div class="about-content">
          <h2 class="overview-heading">{aboutData.overviewTitle}</h2>
          <p class="hero-desc mb-20 max-w-full">
            {aboutData.overviewContent1}
          </p>
          <p class="text-secondary mb-20">
            {aboutData.overviewContent2}
          </p>
        </div>
        <div class="about-image flex-center">
          <img src={aboutData.overviewImage} alt="EIM Lab" />
        </div>
      </div>

      <div class="about-visionmission-grid glass-panel mb-80">
        <div class="vm-grid">
          <div>
            <h3 class="vision-heading">
              <i class="fa-solid fa-eye"></i> Vision
            </h3>
            <p class="vm-text">
              {aboutData.vision}
            </p>
          </div>
          <div>
            <h3 class="mission-heading">
              <i class="fa-solid fa-bullseye"></i> Mission
            </h3>
            <ul class="mission-list">
              {aboutData.missions.map((mission) => (
                <li class="mission-item">{mission}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div>
        <div class="section-title">
          <h2>Our Values</h2>
          <p>Core values that serve as pillars and work culture in EIM Lab.</p>
        </div>

        <div class="focus-grid">
          {values.map((val) => (
            <div class="focus-card glass-panel">
              <div class={`focus-icon ${val.isAccent ? 'text-accent-red' : ''}`}>
                <i class={`fa-solid ${val.icon}`}></i>
              </div>
              <h3>{val.title}</h3>
              <p>{val.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
