---
interface Props {
  initialStage: string;
  registrationConfig: any;
  extendedCfg: {
    bannerTitle: string;
    bannerMessage: string;
  };
  studentYears: string[];
  docLimits: {
    ksmMb: number;
    khsMb: number;
    mlMb: number;
    cvMb: number;
    piMb: number;
  };
  divisions: Array<{
    registrationValue: string;
    registrationLabel: string;
  }>;
  piTemplateUrl?: string;
}

const { initialStage, registrationConfig, extendedCfg, studentYears, docLimits, divisions, piTemplateUrl } = Astro.props;
---

<div id="view-open" style={(initialStage === 'open' || initialStage === 'extended') ? 'display: block;' : 'display: none;'}>
  
  {/* Extended Registration Banner */}
  <div 
    id="extended-banner" 
    class="extended-banner"
    style={`display: ${initialStage === 'extended' ? 'block' : 'none'};`}
  >
    <h3 class="extended-banner-title">
      <i class="fa-solid fa-bolt"></i> {extendedCfg.bannerTitle}
    </h3>
    <p class="extended-banner-desc">{extendedCfg.bannerMessage}</p>
  </div>

  <div class="registration-header">
    <h2>{registrationConfig.title}</h2>
    <p style="color: var(--text-secondary);">{registrationConfig.subtitle}</p>
  </div>

  {/* Status Alerts */}
  <div id="status-alert-error" class="status-alert-error"></div>
  <div id="status-alert-success" class="status-alert-success"></div>

  {/* Countdown Timer */}
  <div class="registration-timer" id="registration-timer" style="margin-bottom: 30px;">
    <div class="timer-block">
      <div id="timer-days" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
      <div style="font-size: 0.8rem; color: var(--text-secondary);">Days</div>
    </div>
    <div class="timer-block">
      <div id="timer-hours" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
      <div style="font-size: 0.8rem; color: var(--text-secondary);">Hours</div>
    </div>
    <div class="timer-block">
      <div id="timer-minutes" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
      <div style="font-size: 0.8rem; color: var(--text-secondary);">Minutes</div>
    </div>
    <div class="timer-block">
      <div id="timer-seconds" style="font-size: 1.5rem; font-weight: bold; color: var(--accent-red);">0</div>
      <div style="font-size: 0.8rem; color: var(--text-secondary);">Seconds</div>
    </div>
  </div>

  {/* Registration Form */}
  <form id="pendaftaran-form">
    {/* Anti-bot Honeypot Field (Hidden from legitimate users) */}
    <input type="text" id="website_hp" name="website_hp" style="display:none !important;" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {/* Section 1: Data Diri */}
    <div class="form-section-heading">
      <i class="fa-solid fa-user" style="margin-right: 8px;"></i> 1. Personal Identity
    </div>

    <div class="form-group">
      <label for="nama_lengkap">Full Name <span class="required-asterisk">*</span></label>
      <input type="text" class="form-control" id="nama_lengkap" placeholder="Your full name" required />
    </div>

    <div class="form-row" style="margin-top: 15px;">
      <div class="form-group">
        <label for="nim">Student ID (NIM) <span class="required-asterisk">*</span></label>
        <input type="text" class="form-control" id="nim" placeholder="Example: 1202210001" pattern="[0-9]+" required />
      </div>
      <div class="form-group">
        <label for="angkatan">Student Year (Angkatan) <span class="required-asterisk">*</span></label>
        <select class="form-control" id="angkatan" required>
          <option value="" disabled selected>Select Year</option>
          {studentYears.map(yr => (
            <option value={yr}>{yr}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-row" style="margin-top: 15px;">
      <div class="form-group">
        <label for="email">Email Address <span class="required-asterisk">*</span></label>
        <input type="email" class="form-control" id="email" placeholder="name@domain.com" required />
      </div>
      <div class="form-group">
        <label for="nomor_telp">Phone / WhatsApp Number <span class="required-asterisk">*</span></label>
        <input type="tel" class="form-control" id="nomor_telp" placeholder="Example: 081234567890" pattern="[0-9]+" required />
      </div>
    </div>

    {/* Section 2: Pemilihan Divisi */}
    <div class="form-section-heading">
      <i class="fa-solid fa-layer-group" style="margin-right: 8px;"></i> 2. Division Selection & Motivation
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="divisi_1">Chosen Division 1 (Primary Choice) <span class="required-asterisk">*</span></label>
        <select class="form-control" id="divisi_1" required>
          <option value="" disabled selected>Select Division 1</option>
          {divisions.map(div => (
            <option value={div.registrationValue}>{div.registrationLabel}</option>
          ))}
        </select>
      </div>
      <div class="form-group">
        <label for="divisi_2">Chosen Division 2 (Secondary Choice) <span class="required-asterisk">*</span></label>
        <select class="form-control" id="divisi_2" required>
          <option value="" disabled selected>Select Division 2</option>
          {divisions.map(div => (
            <option value={div.registrationValue}>{div.registrationLabel}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-group" style="margin-top: 15px;">
      <label for="alasan_divisi_1">Reason for Choosing Division 1 <span class="required-asterisk">*</span></label>
      <textarea class="form-control" id="alasan_divisi_1" rows="3" placeholder="Explain your motivation and skill background for Division 1..." required></textarea>
    </div>

    <div class="form-group" style="margin-top: 15px;">
      <label for="alasan_divisi_2">Reason for Choosing Division 2 <span class="required-asterisk">*</span></label>
      <textarea class="form-control" id="alasan_divisi_2" rows="3" placeholder="Explain your motivation and skill background for Division 2..." required></textarea>
    </div>

    {/* Dynamic Portfolio MedHum Link */}
    <div class="form-group medhum-porto-container" id="container-medhum-porto">
      <label for="portofolio_medhum" class="medhum-porto-label">
        <i class="fa-solid fa-palette" style="margin-right: 6px;"></i> MedHum Portfolio Link <span class="required-asterisk">*</span>
      </label>
      <input type="url" class="form-control" id="portofolio_medhum" placeholder="https://behance.net/username or https://drive.google.com/..." />
      <small style="color: var(--text-secondary); display: block; margin-top: 5px;">Since you selected MedHum, please provide a public URL link to your design / video portfolio.</small>
    </div>

    <div class="form-group" style="margin-top: 15px;">
      <label for="bersedia_dipindah">Willing to be moved to another division if needed? <span class="required-asterisk">*</span></label>
      <select class="form-control" id="bersedia_dipindah" required>
        <option value="" disabled selected>Select Preference</option>
        <option value="Ya">Ya (Yes)</option>
        <option value="Tidak">Tidak (No)</option>
      </select>
    </div>

    {/* Section 3: Berkas Pendaftaran */}
    <div class="form-section-heading">
      <i class="fa-solid fa-folder-open" style="margin-right: 8px;"></i> 3. Document Uploads (PDF / Images)
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="file_ksm">Kartu Studi Mahasiswa (KSM) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.ksmMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_ksm" accept=".pdf,.png,.jpg,.jpeg" required />
      </div>
      <div class="form-group">
        <label for="file_khs">Kartu Hasil Studi (KHS) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.khsMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_khs" accept=".pdf,.png,.jpg,.jpeg" required />
      </div>
    </div>

    <div class="form-row" style="margin-top: 15px;">
      <div class="form-group">
        <label for="file_ml">Motivation Letter (ML) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.mlMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_ml" accept=".pdf,.png,.jpg,.jpeg" required />
      </div>
      <div class="form-group">
        <label for="file_cv">Curriculum Vitae (CV) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.cvMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_cv" accept=".pdf,.png,.jpg,.jpeg" required />
      </div>
    </div>

    <div class="form-group" style="margin-top: 15px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 8px;">
        <label for="file_pi" style="margin-bottom: 0;">Pakta Integritas (PI) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.piMb}MB)</span> <span class="required-asterisk">*</span></label>
        {piTemplateUrl && (
          <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" style="font-size: 0.825rem; color: var(--accent-cyan); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 500;">
            <i class="fa-solid fa-file-arrow-down"></i> Download Template PI
          </a>
        )}
      </div>
      <input type="file" class="form-control" id="file_pi" accept=".pdf,.png,.jpg,.jpeg" required />
      <small style="color: var(--text-secondary); display: block; margin-top: 5px;">
        Upload signed Integrity Pact document.
        {piTemplateUrl && (
          <span style="margin-left: 4px;">Don't have the template yet? <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent-cyan); text-decoration: underline;">Download template here</a>.</span>
        )}
      </small>
    </div>

    <div class="form-actions form-actions-submit">
      <button type="submit" id="submit-btn" class="btn btn-primary btn-submit-registration">
        <span id="btn-text">Submit Registration <i class="fa-solid fa-paper-plane" style="margin-left: 8px;"></i></span>
      </button>
    </div>
  </form>

  <!-- Submission Progress Modal Overlay -->
  <div id="registration-progress-modal" class="progress-modal-overlay" style="display: none;">
    <div class="progress-modal-card">
      <div class="progress-modal-header">
        <div id="progress-modal-icon" class="progress-modal-icon-wrapper">
          <i class="fa-solid fa-cloud-arrow-up fa-bounce" style="color: var(--accent-cyan);"></i>
        </div>
        <h3 id="progress-modal-title" class="progress-modal-title">Submitting Registration</h3>
        <p id="progress-modal-subtitle" class="progress-modal-subtitle">Please stay on this page while we process your documents and transmit data.</p>
      </div>

      <!-- Progress Bar & Percentage -->
      <div class="progress-bar-container">
        <div class="progress-bar-header">
          <span id="submit-progress-detail" class="progress-detail-text">Validating form data...</span>
          <span id="submit-progress-percent" class="progress-percent-badge">0%</span>
        </div>
        <div class="progress-bar-track">
          <div id="submit-progress-bar" class="progress-bar-fill" style="width: 0%;"></div>
        </div>
      </div>

      <!-- Stage Checklist -->
      <div class="progress-stages-list">
        <div id="stage-item-1" class="progress-stage-item stage-pending">
          <span id="stage-1-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-1-text" class="stage-label">1. Document & Field Validation</span>
        </div>
        <div id="stage-item-2" class="progress-stage-item stage-pending">
          <span id="stage-2-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-2-text" class="stage-label">2. Encoding Documents (Base64)</span>
        </div>
        <div id="stage-item-3" class="progress-stage-item stage-pending">
          <span id="stage-3-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-3-text" class="stage-label">3. Transmitting Data Payload</span>
        </div>
        <div id="stage-item-4" class="progress-stage-item stage-pending">
          <span id="stage-4-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-4-text" class="stage-label">4. Server Processing & Confirmation</span>
        </div>
      </div>

      <!-- Modal Action Buttons (Shown on completion or error) -->
      <div id="progress-modal-actions" class="progress-modal-actions" style="display: none;">
        <button type="button" id="modal-close-btn" class="btn btn-primary" style="min-width: 140px;">Close</button>
      </div>
    </div>
  </div>
</div>

<style>
  .progress-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(10, 14, 23, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .progress-modal-card {
    background: rgba(22, 31, 49, 0.95);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 240, 255, 0.15);
    width: 100%;
    max-width: 480px;
    padding: 28px 24px;
    color: var(--text-primary, #ffffff);
    animation: modalSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .progress-modal-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .progress-modal-icon-wrapper {
    font-size: 2.5rem;
    margin-bottom: 12px;
  }

  .progress-modal-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text-primary, #ffffff);
  }

  .progress-modal-subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary, #94a3b8);
    line-height: 1.4;
  }

  .progress-bar-container {
    margin-bottom: 22px;
  }

  .progress-bar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 0.85rem;
  }

  .progress-detail-text {
    color: var(--accent-cyan, #00f0ff);
    font-weight: 500;
    max-width: 78%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .progress-percent-badge {
    font-weight: 700;
    font-size: 0.9rem;
    color: #ffffff;
    background: rgba(0, 240, 255, 0.15);
    border: 1px solid rgba(0, 240, 255, 0.3);
    padding: 2px 8px;
    border-radius: 12px;
  }

  .progress-bar-track {
    width: 100%;
    height: 10px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 99px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-cyan, #00f0ff) 0%, #20c997 100%);
    border-radius: 99px;
    transition: width 0.25s ease-out;
  }

  .progress-stages-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 10px;
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .progress-stage-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .progress-stage-item.stage-pending {
    color: var(--text-secondary, #64748b);
  }

  .progress-stage-item.stage-active {
    color: var(--accent-cyan, #00f0ff);
    font-weight: 600;
  }

  .progress-stage-item.stage-completed {
    color: #20c997;
    font-weight: 500;
  }

  .progress-stage-item.stage-failed {
    color: #ff6b6b;
    font-weight: 600;
  }

  .stage-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    font-size: 0.95rem;
  }

  .progress-modal-actions {
    margin-top: 20px;
    text-align: center;
  }
</style>
