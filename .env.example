# Google Apps Script Web App Deployment URL (Backend Form Submission)
PUBLIC_GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional secret signature token to verify form payload requests in code.gs
PUBLIC_RECRUITMENT_SECRET=your_optional_secret_token_here

# Canonical origin Astro uses for `site` (canonical and Open Graph URLs)
PUBLIC_SITE_URL=https://eimlab.org

# Keystatic CMS (Keystatic Cloud in production, local storage in development)
# Project slug is configured in keystatic.config.ts (eimlab/lab-eim).
# Required in production by Keystatic Cloud; minimum 32 characters.
KEYSTATIC_SECRET=your_random_long_session_secret_string_here

