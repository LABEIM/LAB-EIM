---
import { getLocaleFromUrl, t } from '../../utils/i18n';
import type { ContactPerson } from '../../utils/types';

interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  contactPersons?: ContactPerson[];
  compact?: boolean;
}

const locale = getLocaleFromUrl(Astro.url);

const {
  title = 'Butuh Bantuan atau Memiliki Pertanyaan?',
  subtitle = 'Hubungi langsung narahubung rekrutmen kami untuk pertanyaan apapun selama proses rekrutmen.',
  badge = t('reg.contactPerson', locale),
  contactPersons = [],
  compact = false
} = Astro.props;

// Platform style mappings
const platformConfig: Record<string, { label: string; iconClass: string }> = {
  whatsapp: {
    label: 'WhatsApp',
    iconClass: 'fa-brands fa-whatsapp'
  },
  line: {
    label: 'LINE',
    iconClass: 'fa-brands fa-line'
  },
  email: {
    label: 'Email',
    iconClass: 'fa-solid fa-envelope'
  },
  phone: {
    label: 'Phone',
    iconClass: 'fa-solid fa-phone'
  }
};

// CMS-editable: only allow link schemes that cannot execute script.
const isSafeLink = (link?: string): link is string =>
  Boolean(link && /^(https?:|mailto:|tel:)/i.test(link));
---

{contactPersons.length > 0 && (
  <div class={compact ? 'cp-box compact' : 'cp-box'}>
    <div class="cp-header">
      <div class="cp-badge">
        <i class="fa-solid fa-headset"></i> {badge}
      </div>
      <h3 class="cp-title">{title}</h3>
      {subtitle && <p class="cp-subtitle">{subtitle}</p>}
    </div>

    <div class="cp-cards-grid">
      {contactPersons.map((cp) => {
        const platKey = (cp.platform || 'whatsapp').toLowerCase();
        const platInfo = platformConfig[platKey] || platformConfig.whatsapp;
        const link = isSafeLink(cp.link) ? cp.link : undefined;

        return (
          <div class={`cp-card cp-${platKey}${link ? ' cp-card--linked' : ''}`}>
            <div class="cp-card-header">
              <span class="cp-role-badge">{cp.role || t('reg.contactPerson', locale)}</span>
              <div class="cp-plat-icon">
                <i class={platInfo.iconClass}></i>
              </div>
            </div>

            <div class="cp-card-body">
              <h4 class="cp-name">{cp.name}</h4>
              <p class="cp-id">{cp.contactId}</p>
            </div>

            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="cp-action-btn"
              >
                <span>{`Hubungi via ${platInfo.label}`}</span>
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>
)}
