---
import type { AboutData } from '../../utils/types';

interface Props {
  content: AboutData['sections']['hero'];
}

const { content } = Astro.props;
---

<section class="eim-hero eim-subhero" aria-labelledby="eim-subhero-title">
  <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>
  <div class="eim-hero-inner">
    <p class="eim-eyebrow">{content.eyebrow}</p>
    <h1 id="eim-subhero-title" class="eim-hero-title">
      {content.lines.map((line) => <span class="eim-hero-title-line">{line}</span>)}
    </h1>
    <p class="eim-hero-desc">{content.description}</p>
    <div class="eim-hero-actions">
      <a class="eim-hero-cta" href="#profil">{content.primaryLabel}</a>
      <a class="eim-hero-secondary" href="/structure">
        {content.secondaryLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="eim-subhero-meta">{content.meta}</p>
  </div>
</section>

<script>
  import { initTopologyField } from '../../scripts/topology-field';
  initTopologyField();
</script>
