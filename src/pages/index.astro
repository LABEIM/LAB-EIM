---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import divisionsData from '../data/divisions.json';
import registrationConfig from '../data/registration.json';
import { getCurrentRecruitmentStage } from '../utils/recruitment';
import { parseDivisions } from '../utils/division-mapper';
import { STAGE_ACTION_CONFIG, DEFAULT_ACTION_BTN } from '../utils/constants';
import ResearchFocus from '../components/home/ResearchFocus.astro';
import NewsCard from '../components/cards/NewsCard.astro';

const divisions = parseDivisions(divisionsData);

// Fetch and sort news
const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => new Date(b.data.news_date).getTime() - new Date(a.data.news_date).getTime())
  .slice(0, 3);

// Calculate active recruitment stage
const currentStage = getCurrentRecruitmentStage(registrationConfig);
const actionBtn = STAGE_ACTION_CONFIG[currentStage] || DEFAULT_ACTION_BTN;
---

<Layout title="EIM Research Lab - Enterprise Infrastructure Management">
  <header class="hero" id="home">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-tag">
            <span></span> Enterprise Infrastructure Management Lab
          </div>
          <h1>
            Building <span class="text-gradient-red">Digital Infrastructure</span> of the Future with <span class="text-gradient-cyan">Research & AI</span>
          </h1>
          <p class="hero-desc">
            We conduct research, in-depth studies, and training in enterprise network technology, data center optimization, cloud computing, and infrastructure automation.
          </p>
          <div class="hero-actions">
            {actionBtn && (
              <a href="/registration" class="btn btn-primary hero-action-primary">
                {actionBtn.label} <i class={`fa-solid ${actionBtn.icon}`}></i>
              </a>
            )}
            <a href="/structure" class="btn btn-secondary">
              View Assistant Structure <i class="fa-solid fa-users"></i>
            </a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="visual-orbit">
            <div class="visual-core">
              <i class="fa-solid fa-server fa-3x text-gradient-dual"></i>
            </div>
            <div class="visual-node node-1" title="Cloud Computing">
              <i class="fa-solid fa-cloud"></i>
            </div>
            <div class="visual-node node-2" title="Cyber Security">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div class="visual-node node-3" title="Network Infrastructure">
              <i class="fa-solid fa-network-wired"></i>
            </div>
            <div class="visual-node node-4" title="AI & Data Optimization">
              <i class="fa-solid fa-microchip"></i>
            </div>
          </div>
        </div>
      </div>

      {/* Research Focus */}
      <ResearchFocus />

      {/* Lab Divisions */}
      <div class="home-section-wrapper">
        <div class="section-title">
          <h2>EIM Laboratory Divisions</h2>
          <p>EIM Laboratory consists of 6 main divisions collaborating in integrated research and operations.</p>
        </div>
        <div class="divisions-brief-grid">
          {divisions.map(div => (
            <a href={`/structure?div=${div.id}`} class="div-brief-card glass-panel division-card-link">
              <h4>{div.displayName}</h4>
              <p>{div.description}</p>
            </a>
          ))}
        </div>
      </div>

      {/* Latest News */}
      <div class="home-section-wrapper latest-news-section">
        <div class="section-title">
          <h2>Latest News</h2>
          <p>Latest news and article releases from EIM Research Lab.</p>
        </div>
        <div class="news-grid">
          {latestNews.length === 0 ? (
            <div class="news-empty-state glass-panel news-empty-full">
              <i class="fa-regular fa-newspaper"></i>
              <p class="text-secondary-muted">No latest news available.</p>
            </div>
          ) : (
            latestNews.map(newsItem => (
              <NewsCard news={newsItem} showButton={false} />
            ))
          )}
        </div>
        <div class="view-all-news-wrapper">
          <a href="/news" class="btn btn-secondary">
            View All News <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </header>
</Layout>
