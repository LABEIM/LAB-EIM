---
import type { EventEntry } from '../../utils/event-helpers';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import FilterControlBar from '../common/FilterControlBar.astro';
import Pagination from '../common/Pagination.astro';
import KegiatanCard from './KegiatanCard.astro';

interface Props {
  events: EventEntry[];
  locale: Locale;
}

const { events, locale } = Astro.props;
const categories = [...new Set(events.map((event) => event.data.category).filter(Boolean))].sort();
---

<section
  id="daftar"
  class="py-[clamp(4.5rem,10vh,8.75rem)]"
  aria-labelledby="kegiatan-list-title"
>
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">
          01 — {t('events.listEyebrow', locale)}
        </p>
        <h2
          id="kegiatan-list-title"
          class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
        >
          {t('events.listTitle', locale)}
        </h2>
      </div>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('events.listIntro', locale)}
      </p>
    </div>

    {events.length === 0 ? (
      <div class="kegiatan-empty e-reveal mt-[clamp(2.5rem,6vh,4rem)]">
        <p class="kegiatan-empty-title">{t('events.listEmptyTitle', locale)}</p>
        <p class="kegiatan-empty-desc">{t('events.listEmptyDesc', locale)}</p>
        <div class="kegiatan-empty-actions">
          <a class="eim-hero-cta" href="/registration">{t('events.heroSecondary', locale)}</a>
          <a class="eim-hero-secondary" href="/contact">
            {t('events.contact', locale)} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    ) : (
      <div class="eim-list-filter">
        <FilterControlBar
          categories={categories}
          searchPlaceholder={t('events.searchPlaceholder', locale)}
          totalCount={events.length}
        />

        <div id="kegiatan-list-empty" class="kegiatan-list-empty" style="display: none;">
          <p class="kegiatan-empty-title">{t('events.listNoMatchTitle', locale)}</p>
          <p class="kegiatan-empty-desc">{t('events.listNoMatchDesc', locale)}</p>
        </div>

        <ul id="kegiatan-list-grid" class="kegiatan-list-grid e-reveal-group">
          {events.map((event, index) => (
            <KegiatanCard event={event} locale={locale} filterable index={index} />
          ))}
        </ul>

        <Pagination />
      </div>
    )}
  </div>
</section>

<script>
  import { initContentFilter } from '../../scripts/content-filter';

  initContentFilter({
    gridId: 'kegiatan-list-grid',
    cardClass: 'grid-card-item',
    itemsPerPage: 6,
    emptyStateId: 'kegiatan-list-empty',
    itemName: 'Kegiatan',
  });
</script>
