---
import { Image } from 'astro:assets';
import logoImg from '../../public/image/eim/logo_EIM_crop.avif';
import { getLocaleFromUrl, getLocalizedPath, getLocalizedJsonData, t } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const siteData = await getLocalizedJsonData<any>('site', locale);

const pathname = Astro.url.pathname;
let baseCleanPath = pathname;
if (baseCleanPath === '/en' || baseCleanPath.startsWith('/en/')) {
  baseCleanPath = baseCleanPath.slice(3) || '/';
}
if (baseCleanPath.endsWith('/') && baseCleanPath.length > 1) {
  baseCleanPath = baseCleanPath.slice(0, -1);
}

const rawLinks = [
  { href: '/', key: 'nav.home' },
  { href: '/about', key: 'nav.about' },
  { href: '/structure', key: 'nav.structure' },
  { href: '/event', key: 'nav.event' },
  { href: '/news', key: 'nav.news' },
];

const links = rawLinks.map((link) => ({
  href: getLocalizedPath(link.href, locale),
  rawHref: link.href,
  label: t(link.key, locale),
}));

const isActive = (rawHref: string) => {
  if (rawHref === '/') {
    return baseCleanPath === '/';
  }
  return baseCleanPath.startsWith(rawHref);
};

const idPath = getLocalizedPath(pathname, 'id');
const enPath = getLocalizedPath(pathname, 'en');
---

<nav class="navbar" id="navbar">
  <div class="container">
    <a href={getLocalizedPath('/', locale)} class="logo-container">
      <div class="logo-icon">
        <Image src={logoImg} alt={`${siteData.name} Logo`} width={62} height={70} />
      </div>
      <div class="logo-text">
        <span class="text-gradient-dual">{siteData.name}</span>
        <span class="logo-sub">{siteData.subName}</span>
      </div>
    </a>

    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li class={isActive(link.rawHref) ? 'active' : ''}>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    {/* Language Switcher Pill */}
    <div class="lang-switcher" id="lang-switcher">
      <span class="lang-globe-icon" aria-hidden="true" title="Language / Bahasa">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
          <path d="M2 12h20"/>
        </svg>
      </span>
      <a
        href={idPath}
        data-lang="id"
        class={`lang-btn ${locale === 'id' ? 'active' : ''}`}
        title="Bahasa Indonesia"
      >
        ID
      </a>
      <a
        href={enPath}
        data-lang="en"
        class={`lang-btn ${locale === 'en' ? 'active' : ''}`}
        title="English"
      >
        EN
      </a>
    </div>

    <div class="nav-toggle" id="nav-toggle">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<script>
  import { initNavbar } from '../scripts/components/navbar';
  initNavbar();

  // Handle language persistence on click
  document.addEventListener('DOMContentLoaded', () => {
    const langBtns = document.querySelectorAll('.lang-btn');
    langBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          try {
            localStorage.setItem('eim_preferred_lang', lang);
          } catch (err) {}
        }
      });
    });
  });
</script>
