---
import type { EventEntry } from '../../utils/event-helpers';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import { getEventDateLabel, getEventDateMs, getEventHref } from '../../utils/event-helpers';

interface Props {
  events: EventEntry[];
  locale: Locale;
}

const { events, locale } = Astro.props;
---

{events.length > 0 && (
  <section
    id="kegiatan-terkait"
    class="border-t border-line py-[clamp(4.5rem,10vh,8.75rem)]"
    aria-labelledby="kegiatan-related-title"
  >
    <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
      <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">
        {t('events.relatedEyebrow', locale)}
      </p>
      <h2
        id="kegiatan-related-title"
        class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
      >
        {t('events.relatedTitle', locale)}
      </h2>
      <p class="e-reveal mt-4 max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink">
        {t('events.relatedIntro', locale)}
      </p>

      <ul class="kegiatan-related-list e-reveal-group">
        {events.map((event, index) => {
          const dateLabel = getEventDateLabel(event, locale);
          return (
            <li class="kegiatan-related-row" style={`--i:${index}`}>
              <a href={getEventHref(event, locale)}>
                <span class="kegiatan-related-meta">
                  {getEventDateMs(event) > 0 ? (
                    <time datetime={event.data.event_date}>{dateLabel}</time>
                  ) : (
                    <span>{dateLabel}</span>
                  )}
                  <span aria-hidden="true">·</span>
                  <span>{event.data.category}</span>
                </span>
                <h3 class="kegiatan-related-title">{event.data.title}</h3>
                <span class="kegiatan-related-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
