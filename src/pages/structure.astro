---
import Layout from '../layouts/Layout.astro';
import { getDivisionInfo, parseDivisions } from '../utils/division-mapper';
import { getLocaleFromUrl, getLocalizedJsonData, t } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const membersData = await getLocalizedJsonData<any>('members', locale);
const divisionsData = await getLocalizedJsonData<any>('divisions', locale);

const initialMembers = membersData.list || [];
const divisions = parseDivisions(divisionsData);
---

<Layout title={`${t('struct.title', locale)} - EIM Research Lab`}>
  <section class="page-header structure-page-header">
    <div class="container">
      <div class="page-header-content">
        <h1>{t('struct.title', locale)}</h1>
        <p class="structure-page-subtitle">{t('struct.subtitle', locale)}</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="structure">
    <div class="container">
      <div class="filter-container" id="filter-tabs" data-divisions={JSON.stringify(divisions)}>
        <button class="filter-tab active" data-filter="all">{t('struct.allDivisions', locale)}</button>
        {divisions.map(div => (
          <button class="filter-tab" data-filter={div.id}>{div.name}</button>
        ))}
      </div>

      <!-- Division Summary Banner -->
      <div class="division-banner-panel" id="division-banner">
        <div class="banner-header-row">
          <div class="banner-title-group">
            <h2 id="banner-title">{t('struct.allDivisions', locale)}</h2>
            <span class="division-badge-tag" id="banner-badge">OVERVIEW</span>
          </div>
          <span class="banner-member-count" id="banner-count">{initialMembers.length} {t('struct.members', locale)}</span>
        </div>
        <p class="banner-description" id="banner-desc">
          Mengenal asisten laboratorium kami yang berdedikasi dalam bidang riset, jaringan, media & humas, kompetisi, dan pengabdian masyarakat.
        </p>
      </div>

      <!-- Empty State Notice (hidden by default) -->
      <div class="empty-state-panel" id="empty-state-notice">
        <div class="empty-state-icon">
          <i class="fa-solid fa-users-slash"></i>
        </div>
        <h4>Anggota Tidak Ditemukan</h4>
        <p>Belum ada anggota yang terdaftar di divisi ini.</p>
      </div>

      <div class="member-grid" id="member-grid">
        {initialMembers.map((member: any, idx: number) => {
          const divInfo = getDivisionInfo(member.division, divisions);
          const borderColor = divInfo?.borderColor || 'rgba(255, 255, 255, 0.1)';
          const roleColor = divInfo?.roleColor || 'var(--text-secondary)';
          // Build comprehensive division data attribute (combines member.division, canonical id, and aliases)
          const matchedAliases = divInfo?.aliases ? divInfo.aliases.join(' ') : '';
          const canonicalId = divInfo?.id || member.division;
          const divisionDataAttr = Array.from(new Set([member.division, canonicalId, ...matchedAliases.split(' ')]))
            .filter(Boolean)
            .join(' ');

          const avatarBgStyle = member.image ? 'background: transparent;' : '';
          const imageTransformStyle = member.scale ? `transform: scale(${member.scale});` : '';
          const imageOriginStyle = member.position ? `transform-origin: ${member.position};` : '';

          return (
            <div 
              class={`member-card glass-panel member-card-item div-${canonicalId}`} 
              data-division={divisionDataAttr}
              style={`animation-delay: ${idx * 0.04}s; border-color: ${borderColor};`}
            >
              <div class="member-avatar-wrapper">
                <div class="member-avatar" style={avatarBgStyle}>
                  {member.image ? (
                    <img
                      src={member.image}
                      alt={member.name}
                      class="member-avatar-img"
                      style={`${imageTransformStyle} ${imageOriginStyle}`}
                    />
                  ) : (
                    <i class="fa-solid fa-user default-avatar-icon"></i>
                  )}
                </div>
              </div>
              <div class="member-info">
                <h3>{member.name}</h3>
                <div class="member-role" style={`color: ${roleColor};`}>{member.role}</div>
                <span class="member-div">
                  {divInfo?.displayName || member.division.toUpperCase()}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initStructureFilter } from '../scripts/structure-filter';
  initStructureFilter();
</script>
