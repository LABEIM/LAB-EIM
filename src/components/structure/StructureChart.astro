---
import type { CourseView, Lecturer, Member, Position } from '../../utils/types';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import {
  PRACTICUM_ASSISTANT_ID,
  STRUCTURE_TREE,
  type ChartNode,
} from '../../utils/position-mapper';
import { summarizePracticumAssistants } from '../../utils/course-helpers';
import ChartBranch from './ChartBranch.astro';

interface Props {
  positions: Position[];
  members: Member[];
  lecturers: Lecturer[];
  courses: CourseView[];
  locale: Locale;
}

const { positions, members, lecturers, courses, locale } = Astro.props;

const byId = new Map(positions.map((position) => [position.id, position]));
const treeById = new Map(STRUCTURE_TREE.map((node) => [node.id, node]));

const holders = new Map<string, number>();
for (const person of [...lecturers, ...members]) {
  holders.set(person.role, (holders.get(person.role) ?? 0) + 1);
}

const students = holders.get('mahasiswa-anggota') ?? 0;
const assistantSummary = summarizePracticumAssistants(courses, members);

const notesFor = (id: string): string | undefined => {
  if (assistantSummary.memberCount === 0) return undefined;
  if (id === 'mahasiswa-anggota') {
    return t('struct.memberAssistantNote', locale, {
      n: String(assistantSummary.memberCount),
      total: String(students),
    });
  }
  if (id === PRACTICUM_ASSISTANT_ID) {
    return t('struct.assistantMemberNote', locale, {
      n: String(assistantSummary.memberCount),
    });
  }
  return undefined;
};

const practicumAssistant: ChartNode = {
  label: t('struct.practicumAssistant', locale),
  group: 'asisten',
  count: assistantSummary.distinctCount,
  note: notesFor(PRACTICUM_ASSISTANT_ID),
  children: [],
};

const buildNode = (id: string): ChartNode | null => {
  if (id === PRACTICUM_ASSISTANT_ID) return practicumAssistant;

  const position = byId.get(id);
  if (!position) return null;

  const childIds = [...(treeById.get(id)?.children ?? [])];
  if (id === 'asisten-koordinator-praktikum') childIds.push(PRACTICUM_ASSISTANT_ID);

  const children = childIds
    .map(buildNode)
    .filter((child): child is ChartNode => child !== null);

  return {
    label: position.label,
    group: position.group,
    count: holders.get(id) ?? 0,
    note: notesFor(id),
    children,
  };
};

const root = buildNode(STRUCTURE_TREE[0].id);

---

<section
  id="struktur"
  class="pt-[clamp(2rem,5vh,3.5rem)] pb-[clamp(4.5rem,10vh,8.75rem)]"
  aria-labelledby="struct-chart-title"
>
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <h2
        id="struct-chart-title"
        class="e-reveal font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
      >
        {t('struct.chartTitle', locale)}
      </h2>
      <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
        {t('struct.chartIntro', locale)}
      </p>
    </div>

    {root && (
      <div
        class="mt-[clamp(2.5rem,6vh,4rem)] rounded-media border border-line bg-surface p-[clamp(1.25rem,4vw,2.5rem)]"
      >
        <ol class="chart-tree e-reveal" role="list">
          <ChartBranch node={root} locale={locale} />
        </ol>
      </div>
    )}
  </div>
</section>
