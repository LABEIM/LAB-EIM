---
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  memberCount: number;
  dosenCount: number;
  positionCount: number;
}

const { memberCount, dosenCount, positionCount } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const titleLines = t('struct.heroTitle', locale).split('\n');
---

<section class="eim-hero eim-subhero" aria-labelledby="struct-hero-title">
  <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>
  <div class="eim-hero-inner">
    <p class="eim-eyebrow">{t('struct.heroEyebrow', locale)}</p>
    <h1 id="struct-hero-title" class="eim-hero-title">
      {titleLines.map((line) => <span class="eim-hero-title-line">{line}</span>)}
    </h1>
    <p class="eim-hero-desc">{t('struct.heroDesc', locale)}</p>
    <div class="eim-hero-actions">
      <a class="eim-hero-cta" href="#struktur">{t('struct.heroPrimary', locale)}</a>
      <a class="eim-hero-secondary" href="/registration">
        {t('struct.heroSecondary', locale)} <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="eim-subhero-meta">
      {t('struct.heroMeta', locale, {
        members: String(memberCount),
        dosen: String(dosenCount),
        positions: String(positionCount),
      })}
    </p>
  </div>
</section>

<script>
  import { initTopologyField } from '../../scripts/topology-field';
  initTopologyField();
</script>
