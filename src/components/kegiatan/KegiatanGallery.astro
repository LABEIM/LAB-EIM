---
import type { EventEntry } from '../../utils/event-helpers';
import type { Locale } from '../../utils/i18n';
import { t } from '../../utils/i18n';
import { getEventStoryGallery } from '../../utils/event-helpers';

interface Props {
  event: EventEntry;
  locale: Locale;
}

const { event, locale } = Astro.props;
const gallery = getEventStoryGallery(event);
---

{
  gallery.length > 0 && (
    <section id="dokumentasi" class="kegiatan-gallery" aria-labelledby="kegiatan-gallery-title">
      <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
        <div class="kegiatan-gallery-head">
          <p class="kegiatan-recap-eyebrow">{t('events.galleryEyebrow', locale)}</p>
          <h2 id="kegiatan-gallery-title" class="kegiatan-gallery-title">
            {t('events.galleryTitle', locale)}
          </h2>
        </div>

        <ul class="kegiatan-gallery-grid e-reveal-group">
          {gallery.map((src, index) => (
            <li class="kegiatan-gallery-item" style={`--i:${index}`}>
              <img
                src={src}
                alt={t('events.galleryAlt', locale, {
                  title: event.data.title,
                  n: String(index + 1),
                })}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
