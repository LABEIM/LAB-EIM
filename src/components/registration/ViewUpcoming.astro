---
import BackToHomeButton from './BackToHomeButton.astro';
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  initialStage: string;
  upcomingCfg: {
    title: string;
    subtitle: string;
    prepNotice: string;
  };
  docLimits: {
    ksmMb: number;
    khsMb: number;
    mlMb: number;
    cvMb: number;
    piMb: number;
    totalMb?: number;
  };
  studentYears: string[];
  piTemplateUrl?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const { initialStage, upcomingCfg, docLimits, studentYears, piTemplateUrl } = Astro.props;
---

<div id="view-upcoming" class={initialStage === 'upcoming' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{upcomingCfg.title}</h2>
    <p class="hero-desc registration-hero-subtitle">{upcomingCfg.subtitle}</p>
  </div>

  <div class="registration-timer reg-timer-mb" id="upcoming-timer">
    <div class="timer-block">
      <div id="u-timer-days" class="reg-timer-days">0</div>
      <div class="reg-timer-label">{locale === 'en' ? 'Days' : 'Hari'}</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-hours" class="reg-timer-val">0</div>
      <div class="reg-timer-label">{locale === 'en' ? 'Hours' : 'Jam'}</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-minutes" class="reg-timer-val">0</div>
      <div class="reg-timer-label">{locale === 'en' ? 'Minutes' : 'Menit'}</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-seconds" class="reg-timer-val-red">0</div>
      <div class="reg-timer-label">{locale === 'en' ? 'Seconds' : 'Detik'}</div>
    </div>
  </div>

  <div class="checklist-box">
    <h3 class="checklist-title">
      <i class="fa-solid fa-list-check reg-icon-mr-sm"></i> {locale === 'en' ? 'Document Checklist & Requirements' : 'Daftar Berkas & Persyaratan'}
    </h3>
    <p class="reg-checklist-notice">{upcomingCfg.prepNotice}</p>
    <ul class="checklist-list">
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>{t('form.ksm', locale)}</strong> - Max {docLimits.ksmMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>{t('form.khs', locale)}</strong> - Max {docLimits.khsMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>{t('form.motivationLetter', locale)}</strong> - Max {docLimits.mlMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>{t('form.cv', locale)}</strong> - Max {docLimits.cvMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>{t('form.pi', locale)}</strong> - Max {docLimits.piMb}MB</span>
        {piTemplateUrl && (
          <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="checklist-download-btn">
            <i class="fa-solid fa-file-arrow-down"></i>
            <span>{t('form.downloadPiTemplate', locale)}</span>
          </a>
        )}
      </li>
      <li>
        <i class="fa-solid fa-user-graduate reg-checklist-icon"></i>
        <span><strong>{locale === 'en' ? 'Eligible Student Years:' : 'Angkatan Mahasiswa:'}</strong> {studentYears.join(", ")}</span>
      </li>
    </ul>
  </div>

  <BackToHomeButton />
</div>
