---
import BackToHomeButton from './BackToHomeButton.astro';
import { getLocaleFromUrl, getLocalizedJsonData } from '../../utils/i18n';
import type { ChromeData, FieldStates, RecruitmentLabels } from '../../utils/types';
import FormDescriptionCard from './FormDescriptionCard.astro';

interface Props {
  initialStage: string;
  upcomingCfg: {
    title: string;
    subtitle: string;
    prepNotice: string;
  };
  docLimits: {
    ksmMb: number;
    khsMb: number;
    mlMb: number;
    cvMb: number;
    piMb: number;
    totalMb?: number;
  };
  studentYears: string[];
  piTemplateUrl?: string;
  fieldStates?: FieldStates;
  labels: RecruitmentLabels;
  allowedFileExtensions?: Record<string, string>;
  formDescriptionTitle?: string;
  formDescription?: string;
  formDescriptionItems?: string[];
}

const { 
  initialStage, 
  upcomingCfg, 
  docLimits, 
  studentYears, 
  piTemplateUrl, 
  fieldStates = {}, 
  labels,
  allowedFileExtensions = {},
  formDescriptionTitle,
  formDescription,
  formDescriptionItems,
} = Astro.props;

const ui = getLocalizedJsonData<ChromeData>('chrome', getLocaleFromUrl(Astro.url)).ui.registration;

const formatExtsLabel = (extsStr?: string) => (extsStr || "pdf, png, jpg, jpeg")
  .split(',')
  .map((e: string) => e.trim().toUpperCase().replace(/^\./, ''))
  .join(', ');

const ksmExtsDisplay = formatExtsLabel(allowedFileExtensions.ksm);
const khsExtsDisplay = formatExtsLabel(allowedFileExtensions.khs);
const mlExtsDisplay = formatExtsLabel(allowedFileExtensions.ml);
const cvExtsDisplay = formatExtsLabel(allowedFileExtensions.cv);
const piExtsDisplay = formatExtsLabel(allowedFileExtensions.pi);

const isKsmEnabled = fieldStates.ksm !== 'disabled';
const isKhsEnabled = fieldStates.khs !== 'disabled';
const isMlEnabled = fieldStates.ml !== 'disabled';
const isCvEnabled = fieldStates.cv !== 'disabled';
const isPiEnabled = fieldStates.pi !== 'disabled';
const isAngkatanEnabled = fieldStates.angkatan !== 'disabled';
---

<div id="view-upcoming" class={initialStage === 'upcoming' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{upcomingCfg.title}</h2>
    <p class="hero-desc registration-hero-subtitle">{upcomingCfg.subtitle}</p>
  </div>

  <FormDescriptionCard 
    title={formDescriptionTitle} 
    description={formDescription} 
    items={formDescriptionItems} 
  />

  <div class="registration-timer reg-timer-mb" id="upcoming-timer">
    <div class="timer-block">
      <div id="u-timer-days" class="reg-timer-days">0</div>
      <div class="reg-timer-label">{labels.timerDays}</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-hours" class="reg-timer-val">0</div>
      <div class="reg-timer-label">{labels.timerHours}</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-minutes" class="reg-timer-val">0</div>
      <div class="reg-timer-label">{labels.timerMinutes}</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-seconds" class="reg-timer-val-red">0</div>
      <div class="reg-timer-label">{labels.timerSeconds}</div>
    </div>
  </div>

  <div class="checklist-box">
    <h3 class="checklist-title">
      <i class="fa-solid fa-list-check reg-icon-mr-sm"></i> Daftar Berkas & Persyaratan
    </h3>
    <p class="reg-checklist-notice">{upcomingCfg.prepNotice}</p>
    <ul class="checklist-list">
      {isKsmEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{labels.ksm}</strong> ({ksmExtsDisplay}) {fieldStates.ksm === 'optional' ? ui.optional : ''} - Max {docLimits.ksmMb}MB</span>
        </li>
      )}
      {isKhsEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{labels.khs}</strong> ({khsExtsDisplay}) {fieldStates.khs === 'optional' ? ui.optional : ''} - Max {docLimits.khsMb}MB</span>
        </li>
      )}
      {isMlEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{labels.ml}</strong> ({mlExtsDisplay}) {fieldStates.ml === 'optional' ? ui.optional : ''} - Max {docLimits.mlMb}MB</span>
        </li>
      )}
      {isCvEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{labels.cv}</strong> ({cvExtsDisplay}) {fieldStates.cv === 'optional' ? ui.optional : ''} - Max {docLimits.cvMb}MB</span>
        </li>
      )}
      {isPiEnabled && (
        <li>
          <i class="fa-solid fa-check reg-checklist-icon"></i>
          <span><strong>{labels.pi}</strong> ({piExtsDisplay}) {fieldStates.pi === 'optional' ? ui.optional : ''} - Max {docLimits.piMb}MB</span>
          {piTemplateUrl && (
            <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="checklist-download-btn">
              <i class="fa-solid fa-file-arrow-down"></i>
              <span>{labels.downloadPiTemplate}</span>
            </a>
          )}
        </li>
      )}
      {isAngkatanEnabled && (
        <li>
          <i class="fa-solid fa-user-graduate reg-checklist-icon"></i>
          <span><strong>Angkatan Mahasiswa:</strong> {studentYears.join(", ")} {fieldStates.angkatan === 'optional' ? ui.optional : ''}</span>
        </li>
      )}
    </ul>
  </div>

  <BackToHomeButton />
</div>
