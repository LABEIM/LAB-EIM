---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import { getLocaleFromUrl, getLocalizedJsonData, t } from '../utils/i18n';
import { countPeopleByGroup, parsePositions } from '../utils/position-mapper';
import { getCurrentRecruitmentStage } from '../utils/recruitment';
import type { AboutData, GalleryData, Lecturer, Member, RecruitmentConfig } from '../utils/types';
import AboutHero from '../components/about/AboutHero.astro';
import AboutProfile from '../components/about/AboutProfile.astro';
import EimVisiMisi from '../components/home/EimVisiMisi.astro';
import EimLabNumbers from '../components/home/EimLabNumbers.astro';
import EimCTA from '../components/home/EimCTA.astro';
import GalleryBand from '../components/about/GalleryBand.astro';
import AboutGallery from '../components/about/AboutGallery.astro';
import EimSectionNav from '../components/home/EimSectionNav.astro';

const locale = getLocaleFromUrl(Astro.url);
const aboutData = getLocalizedJsonData<AboutData>('about', locale);
const siteData = getLocalizedJsonData<any>('site', locale);
const membersData = getLocalizedJsonData<{ list: Member[] }>('members', locale);
const lecturersData = getLocalizedJsonData<{ list: Lecturer[] }>('lecturers', locale);
const positionsData = getLocalizedJsonData<{ list: unknown }>('positions', locale);
const registrationConfig = getLocalizedJsonData<Partial<RecruitmentConfig>>('registration', locale);
const gallery = getLocalizedJsonData<GalleryData>('gallery', locale);
const recruitmentStage = getCurrentRecruitmentStage(registrationConfig);

const positions = parsePositions(positionsData);
const members: Member[] = membersData?.list ?? [];
const lecturers: Lecturer[] = lecturersData?.list ?? [];
const people = [...lecturers, ...members];
const groupCounts = countPeopleByGroup(people, positions);
const courses = await getCollection('courses');

const sectionItems = [
  { id: 'profil', label: t('about.navDotProfile', locale) },
  { id: 'angka', label: t('about.navDotStats', locale) },
  ...(gallery.photos?.length ? [{ id: 'galeri', label: t('about.galleryNavDot', locale) }] : []),
  { id: 'visi-misi', label: t('home.navDotVision', locale) },
  { id: 'gabung', label: t('about.navDotCta', locale) },
];
---

<Layout title={`${t('nav.about', locale)} · EIM Lab`} description={aboutData.description} homeSkin skipLink>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={t('about.sectionNavLabel', locale)} />
    <AboutHero />
    <AboutProfile about={aboutData} site={siteData} />
    <EimLabNumbers
      id="angka"
      label={t('about.statsLabel', locale)}
      stats={[
        { label: t('stats.members', locale), value: members.length },
        { label: t('stats.courses', locale), value: courses.length },
        { label: t('stats.dosen', locale), value: groupCounts.dosen },
      ]}
    />
    <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
      <a
        href="/structure"
        class="e-reveal inline-flex items-center gap-2 pb-[clamp(2rem,4vh,3rem)] font-mono text-xs uppercase tracking-[0.08em] text-brand"
      >
        {t('about.teamLink', locale)} <span aria-hidden="true">→</span>
      </a>
    </div>
    {gallery.featured?.image && (
      <GalleryBand
        image={gallery.featured.image}
        alt={gallery.featured.alt}
        caption={gallery.featured.caption}
        label={t('about.galleryNavDot', locale)}
      />
    )}
    <EimVisiMisi about={aboutData} />
    <AboutGallery photos={gallery.photos ?? []} />
    <EimCTA site={siteData} stage={recruitmentStage} />
  </main>
</Layout>
