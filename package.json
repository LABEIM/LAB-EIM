{
  "name": "website-eim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npx -y tsx src/scripts/sync-recruitment-results.ts && astro build",
    "sync:results": "npx -y tsx src/scripts/sync-recruitment-results.ts",
    "sync:results:replace": "npx -y tsx src/scripts/sync-recruitment-results.ts --replace",
    "clear:results": "npx -y tsx src/scripts/sync-recruitment-results.ts --clear",
    "generate:assets": "npx -y tsx src/scripts/generate-assets.ts",
    "test": "npx tsx src/scripts/test-registration.ts",
    "preview": "astro preview",
    "astro": "astro"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.12.0",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.3.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/vercel": "^11.0.3",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/montserrat": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@astrojs/cloudflare": {
      "astro": "$astro"
    }
  }
}