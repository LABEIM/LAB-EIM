---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import '../styles/pages/structure-eim.css';
import EimSectionNav from '../components/home/EimSectionNav.astro';
import EimCTA from '../components/home/EimCTA.astro';
import StructureHero from '../components/structure/StructureHero.astro';
import StructureChart from '../components/structure/StructureChart.astro';
import StructurePembina from '../components/structure/StructurePembina.astro';
import StructureCore from '../components/structure/StructureCore.astro';
import StructureDivision from '../components/structure/StructureDivision.astro';
import { buildDivisionMap, getDivisionInfo, parseDivisions } from '../utils/division-mapper';
import { getLocaleFromUrl, getLocalizedJsonData, t } from '../utils/i18n';
import type { DivisionConfig, DivisionSection, Member } from '../utils/types';

const locale = getLocaleFromUrl(Astro.url);
const membersData = getLocalizedJsonData<{ list: Member[] }>('members', locale);
const divisionsData = getLocalizedJsonData<any>('divisions', locale);
const siteData = getLocalizedJsonData<any>('site', locale);

const divisions = parseDivisions(divisionsData);
const members = membersData?.list ?? [];
const divisionMap = buildDivisionMap(divisions);

const divisionMembers = (division: DivisionConfig): Member[] =>
  members.filter((member) => {
    const info = getDivisionInfo(member.division, divisionMap);
    return info?.id.trim().toLowerCase() === division.id.trim().toLowerCase();
  });

const coreDivision =
  divisions.find((division) => {
    const info = getDivisionInfo(division.id, divisionMap);
    return info?.id === 'inti' || division.aliases?.some((a) => ['core', 'inti'].includes(a.toLowerCase()));
  }) ?? divisions[0] ?? null;

const coreMembers = coreDivision ? divisionMembers(coreDivision) : [];

const divisionSections: DivisionSection[] = divisions
  .filter((division) => division.id !== coreDivision?.id)
  .map((division) => {
    const list = divisionMembers(division);
    const coordinator = list.find((member) => /coordinator/i.test(member.role)) ?? null;
    return { division, coordinator, staff: list.filter((member) => member !== coordinator) };
  });

const leaderCount = coreMembers.length + divisionSections.filter((s) => s.coordinator).length;

const sectionItems = [
  { id: 'struktur', label: t('struct.navDotChart', locale) },
  { id: 'pembina', label: t('struct.navDotPembina', locale) },
  { id: 'inti', label: t('struct.navDotCore', locale) },
  ...divisionSections.map(({ division }) => ({ id: `divisi-${division.id}`, label: division.displayName })),
  { id: 'gabung', label: t('struct.navDotJoin', locale) },
];
---

<Layout
  title={`${t('nav.structure', locale)} - EIM Research Lab`}
  description={t('struct.metaDescription', locale)}
  homeSkin
  skipLink
>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={t('struct.sectionNavLabel', locale)} />
    <StructureHero
      memberCount={members.length}
      divisionCount={divisions.length}
      leaderCount={leaderCount}
    />
    <StructureChart
      core={coreMembers}
      divisionSections={divisionSections}
      locale={locale}
      startIndex={3}
    />
    <StructurePembina locale={locale} />
    <StructureCore members={coreMembers} locale={locale} />
    {divisionSections.map((section, index) => (
      <StructureDivision section={section} index={index + 3} locale={locale} />
    ))}
    <EimCTA site={siteData} />
  </main>
</Layout>
