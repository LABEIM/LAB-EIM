---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import '../styles/pages/structure-eim.css';
import EimSectionNav from '../components/home/EimSectionNav.astro';
import EimCTA from '../components/home/EimCTA.astro';
import StructureHero from '../components/structure/StructureHero.astro';
import StructureChart from '../components/structure/StructureChart.astro';
import StructureRoles from '../components/structure/StructureRoles.astro';
import { getCollection } from 'astro:content';
import { buildPositionIndex, countPeopleByGroup, groupPeople, parsePositions } from '../utils/position-mapper';
import { resolveCourses } from '../utils/course-helpers';
import { getLocaleFromUrl, getLocalizedJsonData } from '../utils/i18n';
import type { ChromeData, Lecturer, Member, RecruitmentConfig, StructurePageData } from '../utils/types';
import { getCurrentRecruitmentStage } from '../utils/recruitment';
import { sectionOn } from '../utils/page-content';

const locale = getLocaleFromUrl(Astro.url);
const page = getLocalizedJsonData<StructurePageData>('pages/structure', locale);
const membersData = getLocalizedJsonData<{ list: Member[] }>('members', locale);
const positionsData = getLocalizedJsonData<{ list: unknown }>('positions', locale);
const siteData = getLocalizedJsonData<any>('site', locale);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);
const lecturersData = getLocalizedJsonData<{ list: Lecturer[] }>('lecturers', locale);
const registrationConfig = getLocalizedJsonData<Partial<RecruitmentConfig>>('registration', locale);
const recruitmentStage = getCurrentRecruitmentStage(registrationConfig);

const positions = parsePositions(positionsData);
const positionIndex = buildPositionIndex(positions);
const members = membersData?.list ?? [];
const lecturers = lecturersData?.list ?? [];
const people = [...lecturers, ...members];

const courseEntries = await getCollection('courses');
const courses = resolveCourses(courseEntries, lecturers, members);

const sections = groupPeople(people, positions);
const groupCounts = countPeopleByGroup(people, positions);
const dosenCount = groupCounts.dosen;
// The member roster excludes dosen; lecturers are counted separately in the hero meta.
const memberCount = members.length;

// The dots read the same flags as the sections, so a hidden section drops its dot.
const sectionItems = [
  ...(sectionOn(page.chart) ? [{ id: 'struktur', label: page.navDots.chart }] : []),
  ...(sectionOn(page.roles)
    ? sections.map(({ position }) => ({ id: `pos-${position.id}`, label: position.label }))
    : []),
  ...(sectionOn(page.cta) ? [{ id: 'gabung', label: page.navDots.join }] : []),
];
---

<Layout title={page.meta.title} description={page.meta.description} homeSkin skipLink>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={page.sectionLabel} />
    <StructureHero
      content={page.hero}
      memberCount={memberCount}
      dosenCount={dosenCount}
      positionCount={positions.length}
    />
    {sectionOn(page.chart) && (
      <StructureChart
        content={page.chart}
        labels={page.groups}
        positions={positions}
        members={members}
        lecturers={lecturers}
        courses={courses}
      />
    )}
    {sectionOn(page.roles) &&
      sections.map((section, index) => (
        <StructureRoles
          content={page.roles}
          labels={page.groups}
          section={section}
          index={index}
          positionIndex={positionIndex}
        />
      ))}
    {sectionOn(page.cta) && (
      <EimCTA content={chrome.cta} contact={siteData.contact} stage={recruitmentStage} />
    )}
  </main>
</Layout>
