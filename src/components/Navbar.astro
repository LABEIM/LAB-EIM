---
import { Image } from 'astro:assets';
import logoImg from '../../public/image/eim/logo_EIM_crop.avif';
import { getLocaleFromUrl, getLocalizedPath, getLocalizedJsonData, t } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const siteData = await getLocalizedJsonData<any>('site', locale);

const pathname = Astro.url.pathname;
let baseCleanPath = pathname;
if (baseCleanPath === '/en' || baseCleanPath.startsWith('/en/')) {
  baseCleanPath = baseCleanPath.slice(3) || '/';
}
if (baseCleanPath.endsWith('/') && baseCleanPath.length > 1) {
  baseCleanPath = baseCleanPath.slice(0, -1);
}

const rawLinks = [
  { href: '/', key: 'nav.home' },
  { href: '/about', key: 'nav.about' },
  { href: '/structure', key: 'nav.structure' },
  { href: '/event', key: 'nav.event' },
  { href: '/news', key: 'nav.news' },
  { href: '/registration', key: 'nav.register' },
];

const links = rawLinks.map((link) => ({
  href: getLocalizedPath(link.href, locale),
  rawHref: link.href,
  label: t(link.key, locale),
}));

const isActive = (rawHref: string) => {
  if (rawHref === '/') {
    return baseCleanPath === '/';
  }
  return baseCleanPath.startsWith(rawHref);
};

const idPath = getLocalizedPath(pathname, 'id');
const enPath = getLocalizedPath(pathname, 'en');
---

<nav class="navbar" id="navbar">
  <div class="container">
    <a href={getLocalizedPath('/', locale)} class="logo-container">
      <div class="logo-icon">
        <Image src={logoImg} alt={`${siteData.name} Logo`} width={62} height={70} />
      </div>
      <div class="logo-text">
        <span class="text-gradient-dual">{siteData.name}</span>
        <span class="logo-sub">{siteData.subName}</span>
      </div>
    </a>

    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li class={isActive(link.rawHref) ? 'active' : ''}>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    {/* Language Switcher Pill */}
    <div class="lang-switcher" id="lang-switcher">
      <span class="lang-globe-icon" aria-hidden="true" title="Language / Bahasa">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
          <path d="M2 12h20"/>
        </svg>
      </span>
      <a
        href={idPath}
        data-lang="id"
        class={`lang-btn ${locale === 'id' ? 'active' : ''}`}
        title="Bahasa Indonesia"
      >
        ID
      </a>
      <a
        href={enPath}
        data-lang="en"
        class={`lang-btn ${locale === 'en' ? 'active' : ''}`}
        title="English"
      >
        EN
      </a>
    </div>

    <div class="nav-toggle" id="nav-toggle">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px;
    background: rgba(14, 85, 95, 0.05);
    border: 1px solid rgba(14, 85, 95, 0.12);
    border-radius: 999px;
    margin-left: 0.75rem;
    box-shadow: inset 0 1px 2px rgba(14, 85, 95, 0.04);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }
  .lang-switcher:hover {
    border-color: rgba(17, 180, 189, 0.4);
    box-shadow: 0 2px 10px rgba(17, 180, 189, 0.12);
    background: rgba(14, 85, 95, 0.07);
  }
  .lang-globe-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 6px;
    padding-right: 2px;
    color: var(--brand-dark-azure, #0E555F);
    opacity: 0.75;
  }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary, #4a5568);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    line-height: 1;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lang-btn:hover:not(.active) {
    color: var(--brand-dark-azure, #0E555F);
    background: rgba(14, 85, 95, 0.08);
  }
  .lang-btn.active {
    color: #ffffff;
    background: linear-gradient(135deg, var(--brand-dark-azure, #0E555F) 0%, var(--brand-cyan, #11B4BD) 100%);
    box-shadow: 0 2px 8px rgba(14, 85, 95, 0.25);
    font-weight: 700;
  }
</style>

<script>
  import { initNavbar } from '../scripts/components/navbar';
  initNavbar();

  // Handle language persistence on click
  document.addEventListener('DOMContentLoaded', () => {
    const langBtns = document.querySelectorAll('.lang-btn');
    langBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          try {
            localStorage.setItem('eim_preferred_lang', lang);
          } catch (err) {}
        }
      });
    });
  });
</script>
