                    <stop offset="1" stop-color="#6A45BE" stop-opacity="0" />
                  </radialGradient>
                </defs>
              </svg>
            </a>
          )}
          {siteData.socials.linkedin && (
            <a href={siteData.socials.linkedin} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="LinkedIn EIM Research Lab">
              <svg viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg">
                <path d="M44 40 L34.2754 40 L34.2754 25.9384 C34.2754 22.2578 32.7542 19.7452 29.4092 19.7452 C26.8507 19.7452 25.4278 21.4407 24.7655 23.0749 C24.5172 23.6614 24.556 24.4785 24.556 25.2955 L24.556 40 L14.9219 40 C14.9219 40 15.0461 15.0912 14.9219 12.827 L24.556 12.827 L24.556 17.0916 C25.1251 15.227 28.2037 12.5658 33.1164 12.5658 C39.2114 12.5658 44 16.4744 44 24.8908 L44 40 Z M5.17921 9.42819 L5.11712 9.42819 C2.0127 9.42819 0 7.35096 0 4.71794 C0 2.03368 2.0722 0 5.23871 0 C8.40263 0 10.3481 2.02856 10.4102 4.71025 C10.4102 7.34328 8.40263 9.42819 5.17921 9.42819 Z M1.10983 12.827 L9.6858 12.827 L9.6858 40 L1.10983 40 Z" fill="#007EBB" />
              </svg>
            </a>
          )}
          {siteData.socials.line && (
            <a href={siteData.socials.line} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="LINE Official Account">
              <svg viewBox="0 0 377.764 377.764" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" fill="#3ACE01" d="M77.315 0h223.133c42.523 0 77.315 34.792 77.315 77.315v223.133c0 42.523-34.792 77.315-77.315 77.315H77.315C34.792 377.764 0 342.972 0 300.448V77.315C0 34.792 34.792 0 77.315 0z" />
