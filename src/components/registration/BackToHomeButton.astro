---
import { getLocaleFromUrl, getLocalizedJsonData, getLocalizedPath } from '../../utils/i18n';
import type { ChromeData } from '../../utils/types';

interface Props {
  wrapperClass?: string;
  href?: string;
  label?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);

const {
  wrapperClass = "reg-btn-wrapper",
  href = getLocalizedPath('/', locale),
  label = chrome.ui.backToHome
} = Astro.props;
---

<div class={wrapperClass}>
  <a href={href} class="btn btn-secondary reg-btn-padded">
    <i class="fa-solid fa-house reg-btn-icon-left"></i>{label}
  </a>
</div>
