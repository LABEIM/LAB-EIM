---
import Layout from '../layouts/Layout.astro';
import registrationConfig from '../data/registration.json';
import resultsConfig from '../data/recruitment_results.json';
import divisions from '../data/divisions.json';

const studentYears = registrationConfig.studentYears || ["2022", "2023", "2024", "2025"];
const docLimits = registrationConfig.documentLimits || {
  ksmMb: 2,
  khsMb: 2,
  mlMb: 2,
  cvMb: 3,
  piMb: 2
};

const openDateStr = registrationConfig.openDate || "2026-07-01T00:00:00";
const deadlineStr = registrationConfig.deadline || "2026-07-25T23:59:59";
const extendedDeadlineStr = registrationConfig.extendedDeadline || "";
const selectionEndDateStr = registrationConfig.selectionEndDate || "2026-08-05T23:59:59";
const selectionResultsDateStr = registrationConfig.selectionResultsDate || "2026-08-06T00:00:00";
const technicalTestEndDateStr = registrationConfig.technicalTestEndDate || "2026-08-10T23:59:59";
const technicalTestResultsDateStr = registrationConfig.technicalTestResultsDate || "2026-08-11T00:00:00";
const interviewEndDateStr = registrationConfig.interviewEndDate || "2026-08-15T23:59:59";
const announcementDateStr = registrationConfig.announcementDate || "2026-08-17T00:00:00";

// Config objects with fallbacks
const upcomingCfg = registrationConfig.upcomingConfig || {
  title: "Recruitment Opening Soon!",
  subtitle: "Get your documents ready. Registration will officially open soon.",
  prepNotice: "Prepare the required files in advance so you can apply as soon as registration opens."
};

const extendedCfg = registrationConfig.extendedConfig || {
  bannerTitle: "Pendaftaran Diperpanjang! (Registration Extended)",
  bannerMessage: "Good news! The assistant registration deadline has been extended."
};

const selectionCfg = registrationConfig.selectionConfig || {
  title: "Document Screening In Progress",
  subtitle: "Our team is currently evaluating all submitted administrative documents.",
  message: "Thank you for registering! Document verification and administrative screening are underway.",
  estimatedAnnouncementDate: "06 August 2026"
};

const selectionResultsCfg = (registrationConfig as any).selectionResultsConfig || {
  title: "Pengumuman Seleksi Berkas (Document Screening Results)",
  subtitle: "Check if you passed document screening and qualify for the Technical Test.",
  newsUrl: "/news/pengumuman-rekrutmen-2026",
  documentUrl: ""
};

const technicalTestCfg = (registrationConfig as any).technicalTestConfig || {
  title: "Technical Test Phase In Progress",
  subtitle: "Practical skills assessment and technical challenge in progress.",
  message: "Please check your registered email for your technical test instructions and submission brief.",
  scheduleInfo: "07 - 10 August 2026",
  locationInfo: "EIM Research Lab / Online Submission"
};

const technicalTestResultsCfg = (registrationConfig as any).technicalTestResultsConfig || {
  title: "Pengumuman Tes Teknikal (Technical Test Results)",
  subtitle: "Check if you passed the Technical Test and qualify for the Interview phase.",
  newsUrl: "/news/pengumuman-rekrutmen-2026",
  documentUrl: ""
};

const interviewCfg = (registrationConfig as any).interviewConfig || {
  title: "Interview Phase In Progress",
  subtitle: "Candidate interview sessions in progress with EIM Research Lab team.",
  message: "Please check your registered email for your assigned interview time slot and Zoom call details.",
  scheduleInfo: "12 - 15 August 2026",
  locationInfo: "EIM Research Lab / Online Zoom Room"
};

const announcementCfg = registrationConfig.announcementConfig || {
  title: "Final Selection Announcement",
  subtitle: "Check your final selection status below. Congratulations to all accepted candidates!",
  newsUrl: "/news/pengumuman-rekrutmen-2026",
  documentUrl: ""
};

const closedCfg = registrationConfig.closedConfig || {
  title: "Recruitment Period Ended",
  subtitle: "Assistant recruitment for this batch is officially closed.",
  message: "Thank you to everyone who applied. Follow our social media for future recruitment cycles!",
  nextBatchInfo: "Next recruitment expected in early 2027."
};

// Helper for standard 5-step timeline steps
const getTimelineSteps = (activeStepIndex: number) => [
  { label: "1. Registration", status: activeStepIndex > 1 ? "completed" : activeStepIndex === 1 ? "active" : "upcoming" },
  { label: "2. Document Screening", status: activeStepIndex > 2 ? "completed" : activeStepIndex === 2 ? "active" : "upcoming" },
  { label: "3. Technical Test", status: activeStepIndex > 3 ? "completed" : activeStepIndex === 3 ? "active" : "upcoming" },
  { label: "4. Interview Phase", status: activeStepIndex > 4 ? "completed" : activeStepIndex === 4 ? "active" : "upcoming" },
  { label: "5. Final Announcement", status: activeStepIndex > 5 ? "completed" : activeStepIndex === 5 ? "active" : "upcoming" },
];

// Initial Server-Side Stage Determination
const nowTime = new Date().getTime();
const openTime = new Date(openDateStr).getTime();
const deadlineTime = new Date(deadlineStr).getTime();
const extendedTime = extendedDeadlineStr ? new Date(extendedDeadlineStr).getTime() : 0;
const selectionEndTime = new Date(selectionEndDateStr).getTime();
const selectionResultsTime = new Date(selectionResultsDateStr).getTime();
const technicalTestEndTime = new Date(technicalTestEndDateStr).getTime();
const technicalTestResultsTime = new Date(technicalTestResultsDateStr).getTime();
const interviewEndTime = new Date(interviewEndDateStr).getTime();
const announcementTime = new Date(announcementDateStr).getTime();

let initialStage = registrationConfig.status || "auto";

if (initialStage === "auto") {
  if (nowTime < openTime) {
    initialStage = "upcoming";
  } else if (nowTime < deadlineTime) {
    initialStage = "open";
  } else if (extendedTime > 0 && nowTime < extendedTime) {
    initialStage = "extended";
  } else if (nowTime < selectionEndTime) {
    initialStage = "selection";
  } else if (nowTime < selectionResultsTime) {
    initialStage = "selection_results";
  } else if (nowTime < technicalTestEndTime) {
    initialStage = "technical_test";
  } else if (nowTime < technicalTestResultsTime) {
    initialStage = "technical_test_results";
  } else if (nowTime < interviewEndTime) {
    initialStage = "interview";
  } else if (nowTime >= announcementTime) {
    initialStage = "announcement";
  } else {
    initialStage = "closed";
  }
}

// Group accepted candidates by division for final announcement view
const candidatesList = resultsConfig.candidates || [];
const acceptedCandidates = candidatesList.filter(c => (c as any).finalStatus === 'accepted' || (c as any).status === 'accepted');

const candidatesByDivision: Record<string, typeof candidatesList> = {};
acceptedCandidates.forEach(candidate => {
  if (!candidatesByDivision[candidate.division]) {
    candidatesByDivision[candidate.division] = [];
  }
  candidatesByDivision[candidate.division].push(candidate);
});
---

<Layout title={`${registrationConfig.heroTitle || 'Assistant Lab Registration'} - EIM Research Lab`}>
  <section class="page-header" style="padding-top: 150px; padding-bottom: 50px;">
    <div class="container">
      <div class="page-header-content">
        <div class="hero-tag"><span></span> {registrationConfig.heroTag || 'Assistant Recruitment'}</div>
        <h1 id="page-hero-title">{registrationConfig.heroTitle || 'Assistant Lab Registration'}</h1>
        <p class="hero-desc" id="page-hero-desc">{registrationConfig.heroDescription || 'Join us and become a part of EIM Research Lab.'}</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="registration">
    <div class="container">
      <div 
        class="registration-form-container glass-panel" 
        id="registration-container" 
        data-stage={initialStage}
        data-open-date={openDateStr}
        data-deadline={deadlineStr} 
        data-extended-deadline={extendedDeadlineStr}
        data-medhum-val={registrationConfig.medhumDivisionValue || "Medhum"}
        style="max-width: 850px; margin: 0 auto; border-top: 3px solid var(--accent-cyan);"
      >

        {/* 1. UPCOMING VIEW (OPENING SOON) */}
        <div id="view-upcoming" style={initialStage === 'upcoming' ? 'display: block;' : 'display: none;'}>
          <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-size: 2rem; margin-bottom: 10px;">{upcomingCfg.title}</h2>
            <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto;">{upcomingCfg.subtitle}</p>
          </div>

          <div class="registration-timer" id="upcoming-timer" style="margin-bottom: 35px;">
            <div class="timer-block">
              <div id="u-timer-days" style="font-size: 1.5rem; font-weight: bold; color: var(--accent-cyan);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Days</div>
            </div>
            <div class="timer-block">
              <div id="u-timer-hours" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Hours</div>
            </div>
            <div class="timer-block">
              <div id="u-timer-minutes" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Minutes</div>
            </div>
            <div class="timer-block">
              <div id="u-timer-seconds" style="font-size: 1.5rem; font-weight: bold; color: var(--accent-red);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Seconds</div>
            </div>
          </div>

          <div style="background: rgba(0, 240, 255, 0.05); border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 12px; padding: 25px; margin-bottom: 30px;">
            <h3 style="font-size: 1.2rem; color: var(--accent-cyan); margin-bottom: 12px;">
              <i class="fa-solid fa-list-check" style="margin-right: 8px;"></i> Document Checklist & Requirements
            </h3>
            <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 15px;">{upcomingCfg.prepNotice}</p>
            <ul style="color: var(--text-secondary); line-height: 1.8; list-style-type: none; padding-left: 0;">
              <li><i class="fa-solid fa-check" style="color: var(--accent-cyan); margin-right: 10px;"></i><strong>Kartu Studi Mahasiswa (KSM)</strong> - Max {docLimits.ksmMb}MB</li>
              <li><i class="fa-solid fa-check" style="color: var(--accent-cyan); margin-right: 10px;"></i><strong>Kartu Hasil Studi (KHS)</strong> - Max {docLimits.khsMb}MB</li>
              <li><i class="fa-solid fa-check" style="color: var(--accent-cyan); margin-right: 10px;"></i><strong>Motivation Letter (ML)</strong> - Max {docLimits.mlMb}MB</li>
              <li><i class="fa-solid fa-check" style="color: var(--accent-cyan); margin-right: 10px;"></i><strong>Curriculum Vitae (CV)</strong> - Max {docLimits.cvMb}MB</li>
              <li><i class="fa-solid fa-check" style="color: var(--accent-cyan); margin-right: 10px;"></i><strong>Pakta Integritas (PI)</strong> - Max {docLimits.piMb}MB</li>
              <li><i class="fa-solid fa-user-graduate" style="color: var(--accent-cyan); margin-right: 10px;"></i><strong>Eligible Student Years:</strong> {studentYears.join(", ")}</li>
            </ul>
          </div>

          <div style="text-align: center;">
            <a href="/" class="btn btn-secondary">
              <i class="fa-solid fa-house" style="margin-right: 8px;"></i> Back to Home
            </a>
          </div>
        </div>

        {/* 2. REGISTRATION OPEN & EXTENDED VIEWS */}
        <div id="view-open" style={(initialStage === 'open' || initialStage === 'extended') ? 'display: block;' : 'display: none;'}>
          
          {/* Extended Registration Banner */}
          <div 
            id="extended-banner" 
            style={`display: ${initialStage === 'extended' ? 'block' : 'none'}; background: linear-gradient(135deg, rgba(234, 179, 8, 0.12), rgba(249, 115, 22, 0.12)); border: 1px solid rgba(234, 179, 8, 0.4); border-radius: 12px; padding: 20px 24px; margin-bottom: 30px; text-align: center; box-shadow: 0 4px 20px rgba(234, 179, 8, 0.1);`}
          >
            <h3 style="color: #facc15; font-size: 1.3rem; margin-bottom: 6px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px;">
              <i class="fa-solid fa-bolt" style="color: #facc15;"></i> {extendedCfg.bannerTitle}
            </h3>
            <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5; margin: 0;">{extendedCfg.bannerMessage}</p>
          </div>

          <div class="registration-header" style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-size: 2rem; margin-bottom: 10px;">{registrationConfig.title}</h2>
            <p style="color: var(--text-secondary);">{registrationConfig.subtitle}</p>
          </div>

          {/* Status Alerts */}
          <div id="status-alert-error" style="display: none; background-color: rgba(255,0,0,0.1); color: #ff6b6b; padding: 12px; border-radius: 6px; margin-bottom: 20px; text-align: center; border: 1px solid rgba(255,107,107,0.3);"></div>
          <div id="status-alert-success" style="display: none; background-color: rgba(0,255,0,0.1); color: #20c997; padding: 15px; border-radius: 6px; margin-bottom: 20px; text-align: center; border: 1px solid rgba(32,201,151,0.3);"></div>

          {/* Countdown Timer */}
          <div class="registration-timer" id="registration-timer" style="margin-bottom: 30px;">
            <div class="timer-block">
              <div id="timer-days" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Days</div>
            </div>
            <div class="timer-block">
              <div id="timer-hours" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Hours</div>
            </div>
            <div class="timer-block">
              <div id="timer-minutes" style="font-size: 1.5rem; font-weight: bold; color: var(--text-primary);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Minutes</div>
            </div>
            <div class="timer-block">
              <div id="timer-seconds" style="font-size: 1.5rem; font-weight: bold; color: var(--accent-red);">0</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Seconds</div>
            </div>
          </div>

          {/* Registration Form */}
          <form id="pendaftaran-form">
            {/* Section 1: Data Diri */}
            <div class="form-section-title" style="margin-top: 20px; margin-bottom: 15px; font-size: 1.2rem; font-weight: bold; color: var(--accent-cyan); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
              <i class="fa-solid fa-user" style="margin-right: 8px;"></i> 1. Personal Identity
            </div>

            <div class="form-group">
              <label for="nama_lengkap">Full Name <span style="color: var(--accent-red);">*</span></label>
              <input type="text" class="form-control" id="nama_lengkap" placeholder="Your full name" required />
            </div>

            <div class="form-row" style="margin-top: 15px;">
              <div class="form-group">
                <label for="nim">Student ID (NIM) <span style="color: var(--accent-red);">*</span></label>
                <input type="text" class="form-control" id="nim" placeholder="Example: 1202210001" pattern="[0-9]+" required />
              </div>
              <div class="form-group">
                <label for="angkatan">Student Year (Angkatan) <span style="color: var(--accent-red);">*</span></label>
                <select class="form-control" id="angkatan" required>
                  <option value="" disabled selected>Select Year</option>
                  {studentYears.map(yr => (
                    <option value={yr}>{yr}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-row" style="margin-top: 15px;">
              <div class="form-group">
                <label for="email">Email Address <span style="color: var(--accent-red);">*</span></label>
                <input type="email" class="form-control" id="email" placeholder="name@domain.com" required />
              </div>
              <div class="form-group">
                <label for="nomor_telp">Phone / WhatsApp Number <span style="color: var(--accent-red);">*</span></label>
                <input type="tel" class="form-control" id="nomor_telp" placeholder="Example: 081234567890" pattern="[0-9]+" required />
              </div>
            </div>

            {/* Section 2: Pemilihan Divisi */}
            <div class="form-section-title" style="margin-top: 35px; margin-bottom: 15px; font-size: 1.2rem; font-weight: bold; color: var(--accent-cyan); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
              <i class="fa-solid fa-layer-group" style="margin-right: 8px;"></i> 2. Division Selection & Motivation
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="divisi_1">Chosen Division 1 (Primary Choice) <span style="color: var(--accent-red);">*</span></label>
                <select class="form-control" id="divisi_1" required>
                  <option value="" disabled selected>Select Division 1</option>
                  {divisions.map(div => (
                    <option value={div.registrationValue}>{div.registrationLabel}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="divisi_2">Chosen Division 2 (Secondary Choice) <span style="color: var(--accent-red);">*</span></label>
                <select class="form-control" id="divisi_2" required>
                  <option value="" disabled selected>Select Division 2</option>
                  {divisions.map(div => (
                    <option value={div.registrationValue}>{div.registrationLabel}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-group" style="margin-top: 15px;">
              <label for="alasan_divisi_1">Reason for Choosing Division 1 <span style="color: var(--accent-red);">*</span></label>
              <textarea class="form-control" id="alasan_divisi_1" rows="3" placeholder="Explain your motivation and skill background for Division 1..." required></textarea>
            </div>

            <div class="form-group" style="margin-top: 15px;">
              <label for="alasan_divisi_2">Reason for Choosing Division 2 <span style="color: var(--accent-red);">*</span></label>
              <textarea class="form-control" id="alasan_divisi_2" rows="3" placeholder="Explain your motivation and skill background for Division 2..." required></textarea>
            </div>

            {/* Dynamic Portfolio MedHum Link */}
            <div class="form-group" id="container-medhum-porto" style="display: none; margin-top: 15px; background: rgba(163, 7, 186, 0.08); padding: 15px; border-radius: 8px; border: 1px solid rgba(163, 7, 186, 0.3);">
              <label for="portofolio_medhum" style="color: #e879f9; font-weight: bold;">
                <i class="fa-solid fa-palette" style="margin-right: 6px;"></i> MedHum Portfolio Link <span style="color: var(--accent-red);">*</span>
              </label>
              <input type="url" class="form-control" id="portofolio_medhum" placeholder="https://behance.net/username or https://drive.google.com/..." />
              <small style="color: var(--text-secondary); display: block; margin-top: 5px;">Since you selected MedHum, please provide a public URL link to your design / video portfolio.</small>
            </div>

            <div class="form-group" style="margin-top: 15px;">
              <label for="bersedia_dipindah">Willing to be moved to another division if needed? <span style="color: var(--accent-red);">*</span></label>
              <select class="form-control" id="bersedia_dipindah" required>
                <option value="" disabled selected>Select Preference</option>
                <option value="Ya">Ya (Yes)</option>
                <option value="Tidak">Tidak (No)</option>
              </select>
            </div>

            {/* Section 3: Berkas Pendaftaran */}
            <div class="form-section-title" style="margin-top: 35px; margin-bottom: 15px; font-size: 1.2rem; font-weight: bold; color: var(--accent-cyan); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
              <i class="fa-solid fa-folder-open" style="margin-right: 8px;"></i> 3. Document Uploads (PDF / Images)
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="file_ksm">Kartu Studi Mahasiswa (KSM) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.ksmMb}MB)</span> <span style="color: var(--accent-red);">*</span></label>
                <input type="file" class="form-control" id="file_ksm" accept=".pdf,.png,.jpg,.jpeg" required />
              </div>
              <div class="form-group">
                <label for="file_khs">Kartu Hasil Studi (KHS) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.khsMb}MB)</span> <span style="color: var(--accent-red);">*</span></label>
                <input type="file" class="form-control" id="file_khs" accept=".pdf,.png,.jpg,.jpeg" required />
              </div>
            </div>

            <div class="form-row" style="margin-top: 15px;">
              <div class="form-group">
                <label for="file_ml">Motivation Letter (ML) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.mlMb}MB)</span> <span style="color: var(--accent-red);">*</span></label>
                <input type="file" class="form-control" id="file_ml" accept=".pdf,.png,.jpg,.jpeg" required />
              </div>
              <div class="form-group">
                <label for="file_cv">Curriculum Vitae (CV) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.cvMb}MB)</span> <span style="color: var(--accent-red);">*</span></label>
                <input type="file" class="form-control" id="file_cv" accept=".pdf,.png,.jpg,.jpeg" required />
              </div>
            </div>

            <div class="form-group" style="margin-top: 15px;">
              <label for="file_pi">Pakta Integritas (PI) <span style="font-size: 0.8rem; color: var(--text-secondary);">(Max {docLimits.piMb}MB)</span> <span style="color: var(--accent-red);">*</span></label>
              <input type="file" class="form-control" id="file_pi" accept=".pdf,.png,.jpg,.jpeg" required />
              <small style="color: var(--text-secondary); display: block; margin-top: 5px;">Upload signed Integrity Pact document.</small>
            </div>

            <div class="form-actions" style="justify-content: center; margin-top: 40px;">
              <button type="submit" id="submit-btn" class="btn btn-primary" style="width: 100%; max-width: 320px; padding: 14px; font-size: 1.1rem;">
                <span id="btn-text">Submit Registration <i class="fa-solid fa-paper-plane" style="margin-left: 8px;"></i></span>
              </button>
            </div>
          </form>
        </div>

        {/* 3. DOCUMENT SCREENING IN PROGRESS VIEW */}
        <div id="view-selection" style={initialStage === 'selection' ? 'display: block;' : 'display: none;'}>
          <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-size: 2rem; margin-bottom: 10px;">{selectionCfg.title}</h2>
            <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto;">{selectionCfg.subtitle}</p>
          </div>

          {/* 5-Step Timeline Indicator */}
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-bottom: 35px;">
            {getTimelineSteps(2).map((step) => (
              <div style={`background: ${step.status === 'active' ? 'rgba(0, 240, 255, 0.12)' : step.status === 'completed' ? 'rgba(32, 201, 151, 0.12)' : 'rgba(255, 255, 255, 0.03)'}; border: 1px solid ${step.status === 'active' ? 'var(--accent-cyan)' : step.status === 'completed' ? '#20c997' : 'var(--border-color)'}; border-radius: 10px; padding: 14px 8px; text-align: center;`}>
                <div style={`font-size: 1.1rem; font-weight: bold; margin-bottom: 4px; color: ${step.status === 'active' ? 'var(--accent-cyan)' : step.status === 'completed' ? '#20c997' : 'var(--text-muted)'};`}>
                  {step.status === 'completed' && <i class="fa-solid fa-circle-check"></i>}
                  {step.status === 'active' && <i class="fa-solid fa-spinner fa-spin"></i>}
                  {step.status === 'upcoming' && <i class="fa-solid fa-clock"></i>}
                </div>
                <div style={`font-size: 0.8rem; font-weight: 600; color: ${step.status === 'upcoming' ? 'var(--text-muted)' : 'var(--text-primary)'};`}>{step.label}</div>
              </div>
            ))}
          </div>

          <div style="background: var(--bg-card); border-radius: 12px; padding: 25px; border: 1px solid var(--border-color); margin-bottom: 30px; text-align: center;">
            <i class="fa-solid fa-clipboard-check" style="font-size: 2.5rem; color: var(--accent-cyan); margin-bottom: 15px;"></i>
