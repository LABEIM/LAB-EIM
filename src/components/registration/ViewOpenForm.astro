---
interface Props {
  initialStage: string;
  registrationConfig: any;
  extendedCfg: {
    bannerTitle: string;
    bannerMessage: string;
  };
  studentYears: string[];
  docLimits: {
    ksmMb: number;
    khsMb: number;
    mlMb: number;
    cvMb: number;
    piMb: number;
    totalMb?: number;
  };
  divisions: Array<{
    registrationValue: string;
    registrationLabel: string;
  }>;
  piTemplateUrl?: string;
  minReasonWords?: number;
}

const { initialStage, registrationConfig, extendedCfg, studentYears, docLimits, divisions, piTemplateUrl, minReasonWords = 30 } = Astro.props;
---

<div id="view-open" class={(initialStage === 'open' || initialStage === 'extended') ? '' : 'is-hidden'}>
  
  {/* Extended Registration Banner */}
  <div 
    id="extended-banner" 
    class={`extended-banner ${initialStage === 'extended' ? '' : 'is-hidden'}`}
  >
    <h3 class="extended-banner-title">
      <i class="fa-solid fa-bolt"></i> {extendedCfg.bannerTitle}
    </h3>
    <p class="extended-banner-desc">{extendedCfg.bannerMessage}</p>
  </div>

  <div class="registration-header">
    <h2>{registrationConfig.title}</h2>
    <p class="registration-hero-subtitle">{registrationConfig.subtitle}</p>
  </div>

  {/* Draft Restored Banner */}
  <div id="draft-restored-banner" class="draft-restored-banner is-hidden">
    <div class="draft-restored-content">
      <i class="fa-solid fa-floppy-disk draft-icon"></i>
      <span>Form draft restored from local storage (<strong id="draft-restored-time"></strong>).</span>
    </div>
    <button type="button" id="banner-clear-draft-btn" class="btn-clear-draft-link">
      <i class="fa-solid fa-trash-can"></i> Clear Draft
    </button>
  </div>

  {/* Status Alerts */}
  <div id="status-alert-error" class="status-alert-error"></div>
  <div id="status-alert-success" class="status-alert-success"></div>

  {/* Countdown Timer */}
  <div class="registration-timer reg-timer-mb" id="registration-timer">
    <div class="timer-block">
      <div id="timer-days" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Days</div>
    </div>
    <div class="timer-block">
      <div id="timer-hours" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Hours</div>
    </div>
    <div class="timer-block">
      <div id="timer-minutes" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Minutes</div>
    </div>
    <div class="timer-block">
      <div id="timer-seconds" class="reg-timer-val-red">0</div>
      <div class="reg-timer-label">Seconds</div>
    </div>
  </div>

  {/* Registration Form */}
  <form id="pendaftaran-form" data-max-total-mb={docLimits.totalMb || 15} data-min-words={minReasonWords}>
    {/* Anti-bot Honeypot Field (Hidden from legitimate users) */}
    <input type="text" id="website_hp" name="website_hp" class="reg-honeypot-input" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {/* Section 1: Data Diri */}
    <div class="form-section-heading">
      <i class="fa-solid fa-user reg-icon-mr-sm"></i> 1. Personal Identity
    </div>

    <div class="form-group">
      <label for="nama_lengkap">Full Name <span class="required-asterisk">*</span></label>
      <input type="text" class="form-control" id="nama_lengkap" placeholder="Your full name" required />
    </div>

    <div class="form-row reg-form-row-mt">
      <div class="form-group">
        <label for="nim">Student ID (NIM) <span class="required-asterisk">*</span></label>
        <input type="text" class="form-control" id="nim" placeholder="Example: 1202210001" pattern="[0-9]+" required />
      </div>
      <div class="form-group">
        <label for="angkatan">Student Year (Angkatan) <span class="required-asterisk">*</span></label>
        <select class="form-control" id="angkatan" required>
          <option value="" disabled selected>Select Year</option>
          {studentYears.map(yr => (
            <option value={yr}>{yr}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-row reg-form-row-mt">
      <div class="form-group">
        <label for="email">Email Address <span class="required-asterisk">*</span></label>
        <input type="email" class="form-control" id="email" placeholder="name@domain.com" required />
      </div>
      <div class="form-group">
        <label for="nomor_telp">Phone / WhatsApp Number <span class="required-asterisk">*</span></label>
        <input type="tel" class="form-control" id="nomor_telp" placeholder="Example: 081234567890" pattern="[0-9]+" required />
      </div>
    </div>

    {/* Section 2: Pemilihan Divisi */}
    <div class="form-section-heading">
      <i class="fa-solid fa-layer-group reg-icon-mr-sm"></i> 2. Division Selection & Motivation
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="divisi_1">Chosen Division 1 (Primary Choice) <span class="required-asterisk">*</span></label>
        <select class="form-control" id="divisi_1" required>
          <option value="" disabled selected>Select Division 1</option>
          {divisions.map(div => (
            <option value={div.registrationValue}>{div.registrationLabel}</option>
          ))}
        </select>
      </div>
      <div class="form-group">
        <label for="divisi_2">Chosen Division 2 (Secondary Choice) <span class="required-asterisk">*</span></label>
        <select class="form-control" id="divisi_2" required>
          <option value="" disabled selected>Select Division 2</option>
          {divisions.map(div => (
            <option value={div.registrationValue}>{div.registrationLabel}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-group reg-form-row-mt">
      <label for="alasan_divisi_1">Reason for Choosing Division 1 <span class="required-asterisk">*</span></label>
      <textarea class="form-control" id="alasan_divisi_1" rows="3" placeholder="Explain your motivation and skill background for Division 1..." required></textarea>
      <small class="reg-small-desc word-count-info" id="alasan_divisi_1_counter" data-min-words={minReasonWords}>
        Word count: <span class="word-count-val" id="alasan_divisi_1_count">0</span> / {minReasonWords} words minimum
      </small>
    </div>

    <div class="form-group reg-form-row-mt">
      <label for="alasan_divisi_2">Reason for Choosing Division 2 <span class="required-asterisk">*</span></label>
      <textarea class="form-control" id="alasan_divisi_2" rows="3" placeholder="Explain your motivation and skill background for Division 2..." required></textarea>
      <small class="reg-small-desc word-count-info" id="alasan_divisi_2_counter" data-min-words={minReasonWords}>
        Word count: <span class="word-count-val" id="alasan_divisi_2_count">0</span> / {minReasonWords} words minimum
      </small>
    </div>

    {/* Dynamic Portfolio Link */}
    <div class="form-group medhum-porto-container" id="container-medhum-porto">
      <label for="portofolio_medhum" class="medhum-porto-label">
        <i class="fa-solid fa-palette reg-icon-mr"></i> Division Portfolio Link <span class="required-asterisk">*</span>
      </label>
      <input type="url" class="form-control" id="portofolio_medhum" placeholder="https://behance.net/username or https://drive.google.com/..." />
      <small class="reg-small-desc">Since you selected a division that requires a portfolio, please provide a public URL link to your design, work, or project portfolio.</small>
    </div>

    <div class="form-group reg-form-row-mt">
      <label for="bersedia_dipindah">Willing to be moved to another division if needed? <span class="required-asterisk">*</span></label>
      <select class="form-control" id="bersedia_dipindah" required>
        <option value="" disabled selected>Select Preference</option>
        <option value="Ya">Ya (Yes)</option>
        <option value="Tidak">Tidak (No)</option>
      </select>
    </div>

    {/* Section 3: Berkas Pendaftaran */}
    <div class="form-section-heading">
      <i class="fa-solid fa-folder-open reg-icon-mr-sm"></i> 3. Document Uploads (PDF / Images)
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="file_ksm">Kartu Studi Mahasiswa (KSM) <span class="reg-file-label-small">(Max {docLimits.ksmMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_ksm" accept=".pdf,.png,.jpg,.jpeg" data-max-mb={docLimits.ksmMb} required />
      </div>
      <div class="form-group">
        <label for="file_khs">Kartu Hasil Studi (KHS) <span class="reg-file-label-small">(Max {docLimits.khsMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_khs" accept=".pdf,.png,.jpg,.jpeg" data-max-mb={docLimits.khsMb} required />
      </div>
    </div>

    <div class="form-row reg-form-row-mt">
      <div class="form-group">
        <label for="file_ml">Motivation Letter (ML) <span class="reg-file-label-small">(Max {docLimits.mlMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_ml" accept=".pdf,.png,.jpg,.jpeg" data-max-mb={docLimits.mlMb} required />
      </div>
      <div class="form-group">
        <label for="file_cv">Curriculum Vitae (CV) <span class="reg-file-label-small">(Max {docLimits.cvMb}MB)</span> <span class="required-asterisk">*</span></label>
        <input type="file" class="form-control" id="file_cv" accept=".pdf,.png,.jpg,.jpeg" data-max-mb={docLimits.cvMb} required />
      </div>
    </div>

    <div class="form-group reg-form-row-mt">
      <div class="reg-pi-label-row">
        <label for="file_pi" class="reg-mb-0">Pakta Integritas (PI) <span class="reg-file-label-small">(Max {docLimits.piMb}MB)</span> <span class="required-asterisk">*</span></label>
        {piTemplateUrl && (
          <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="reg-pi-link-inline">
            <i class="fa-solid fa-file-arrow-down"></i>
            <span>Download Template PI</span>
          </a>
        )}
      </div>
      <input type="file" class="form-control" id="file_pi" accept=".pdf,.png,.jpg,.jpeg" data-max-mb={docLimits.piMb} required />
      <small class="reg-small-desc">
        Upload signed Integrity Pact document.
        {piTemplateUrl && (
          <span>Don't have the template yet? <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="reg-pi-sublink">Download template here</a>.</span>
        )}
      </small>
    </div>

    <div class="form-actions form-actions-submit">
      <button type="submit" id="submit-btn" class="btn btn-primary btn-submit-registration">
        <span id="btn-text">Submit Registration <i class="fa-solid fa-paper-plane reg-icon-ml-xs"></i></span>
      </button>
      <button type="button" id="clear-draft-btn" class="btn btn-clear-draft is-hidden">
        <i class="fa-solid fa-rotate-left"></i> Clear Draft
      </button>
    </div>
  </form>

  <!-- Floating Draft Auto-Save Toast Notification -->
  <div id="draft-toast" class="draft-toast-container is-hidden">
    <i id="draft-toast-icon" class="fa-solid fa-cloud-arrow-up draft-toast-icon"></i>
    <span id="draft-toast-text">Draft auto-saved</span>
  </div>

  <!-- Clear Draft Confirmation Modal Overlay -->
  <div id="clear-draft-modal" class="progress-modal-overlay is-hidden">
    <div class="progress-modal-card reg-modal-card-sm">
      <div class="progress-modal-header">
        <div class="progress-modal-icon-wrapper reg-modal-icon-red">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h3 class="progress-modal-title">Clear Registration Draft?</h3>
        <p class="progress-modal-subtitle reg-modal-subtitle-mt">
          All saved text responses in this form will be permanently deleted and reset.
        </p>
      </div>

      <div class="reg-btn-group reg-form-row-mt">
        <button type="button" id="cancel-clear-draft-btn" class="btn btn-modal-cancel">Cancel</button>
        <button type="button" id="confirm-clear-draft-btn" class="btn btn-modal-confirm">Clear Draft</button>
      </div>
    </div>
  </div>

  <!-- Submission Progress Modal Overlay -->
  <div id="registration-progress-modal" class="progress-modal-overlay is-hidden">
    <div class="progress-modal-card">
      <div class="progress-modal-header">
        <div id="progress-modal-icon" class="progress-modal-icon-wrapper">
          <i class="fa-solid fa-cloud-arrow-up fa-bounce footer-icon-cyan"></i>
        </div>
        <h3 id="progress-modal-title" class="progress-modal-title">Submitting Registration</h3>
        <p id="progress-modal-subtitle" class="progress-modal-subtitle">Please stay on this page while we process your documents and transmit data.</p>
      </div>

      <!-- Progress Bar & Percentage -->
      <div class="progress-bar-container">
        <div class="progress-bar-header">
          <span id="submit-progress-detail" class="progress-detail-text">Validating form data...</span>
          <span id="submit-progress-percent" class="progress-percent-badge">0%</span>
        </div>
        <div class="progress-bar-track">
          <div id="submit-progress-bar" class="progress-bar-fill"></div>
        </div>
      </div>

      <!-- Stage Checklist -->
      <div class="progress-stages-list">
        <div id="stage-item-1" class="progress-stage-item stage-pending">
          <span id="stage-1-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-1-text" class="stage-label">1. Document & Field Validation</span>
        </div>
        <div id="stage-item-2" class="progress-stage-item stage-pending">
          <span id="stage-2-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-2-text" class="stage-label">2. Encoding Documents (Base64)</span>
        </div>
        <div id="stage-item-3" class="progress-stage-item stage-pending">
          <span id="stage-3-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-3-text" class="stage-label">3. Transmitting Data Payload</span>
        </div>
        <div id="stage-item-4" class="progress-stage-item stage-pending">
          <span id="stage-4-icon" class="stage-icon"><i class="fa-regular fa-circle"></i></span>
          <span id="stage-4-text" class="stage-label">4. Server Processing & Confirmation</span>
        </div>
      </div>

      <!-- Modal Action Buttons (Shown on completion or error) -->
      <div id="progress-modal-actions" class="progress-modal-actions is-hidden">
        <button type="button" id="modal-close-btn" class="btn btn-primary reg-modal-btn-w">Close</button>
      </div>
    </div>
  </div>
</div>


