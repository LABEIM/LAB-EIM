---
import Layout from '../layouts/Layout.astro';
import { getCurrentRecruitmentStage } from '../utils/recruitment';
import { parseDivisions } from '../utils/division-mapper';
import { getRegistrationPageConfigs } from '../utils/registration-config';
import { getLocaleFromUrl, getLocalizedJsonData, t } from '../utils/i18n';

import ViewUpcoming from '../components/registration/ViewUpcoming.astro';
import ViewOpenForm from '../components/registration/ViewOpenForm.astro';
import ViewScreening from '../components/registration/ViewScreening.astro';
import ViewScreeningResults from '../components/registration/ViewScreeningResults.astro';
import ViewTechnicalTest from '../components/registration/ViewTechnicalTest.astro';
import ViewTechnicalTestResults from '../components/registration/ViewTechnicalTestResults.astro';
import ViewInterview from '../components/registration/ViewInterview.astro';
import ViewAnnouncement from '../components/registration/ViewAnnouncement.astro';
import ViewClosed from '../components/registration/ViewClosed.astro';
import ViewFallback from '../components/registration/ViewFallback.astro';
import ContactPersonBox from '../components/registration/ContactPersonBox.astro';

const locale = getLocaleFromUrl(Astro.url);
const registrationConfig = await getLocalizedJsonData<any>('registration', locale);
const resultsConfig = await getLocalizedJsonData<any>('recruitment_results', locale);
const divisionsData = await getLocalizedJsonData<any>('divisions', locale);

const divisions = parseDivisions(divisionsData);

const {
  studentYears,
  docLimits,
  piTemplateUrl,
  minReasonWords,
  openDateStr,
  deadlineStr,
  extendedDeadlineStr,
  contactPersons,
  upcomingCfg,
  extendedCfg,
  selectionCfg,
  selectionResultsCfg,
  technicalTestCfg,
  technicalTestResultsCfg,
  interviewCfg,
  announcementCfg,
  closedCfg,
  fallbackCfg,
} = getRegistrationPageConfigs(registrationConfig);

// Initial Server-Side Stage Determination
const initialStage = getCurrentRecruitmentStage(registrationConfig);

// Group accepted candidates by division for final announcement view
const candidatesList = resultsConfig.candidates || [];
const acceptedCandidates = candidatesList.filter((c: any) => c.finalStatus === 'accepted' || c.status === 'accepted');

const candidatesByDivision: Record<string, typeof candidatesList> = {};
acceptedCandidates.forEach((candidate: any) => {
  const divisionKey = candidate.division || 'General';
  if (!candidatesByDivision[divisionKey]) {
    candidatesByDivision[divisionKey] = [];
  }
  candidatesByDivision[divisionKey].push(candidate);
});
---

<Layout title={`${registrationConfig.heroTitle || t('reg.title', locale)} - EIM Research Lab`}>
  <section class="page-header registration-page-header">
    <div class="container">
      <div class="page-header-content">
        <div class="hero-tag"><span></span> {registrationConfig.heroTag || 'Assistant Recruitment'}</div>
        <h1 id="page-hero-title">{registrationConfig.heroTitle || t('reg.title', locale)}</h1>
        <p class="hero-desc" id="page-hero-desc">{registrationConfig.heroDescription || 'Join us and become a part of EIM Research Lab.'}</p>
      </div>
    </div>
  </section>

  <section class="section-padding" id="registration">
    <div class="container">
      <div 
        class="registration-form-container glass-panel" 
        id="registration-container" 
        data-stage={initialStage}
        data-open-date={openDateStr}
        data-deadline={deadlineStr} 
        data-extended-deadline={extendedDeadlineStr}
        data-portfolio-trigger-vals={registrationConfig.portfolioDivisionTriggerValues || registrationConfig.medhumDivisionValue || "Medhum"}
        data-min-reason-words={minReasonWords}
        data-script-url={import.meta.env.PUBLIC_GOOGLE_SHEET_SCRIPT_URL}
        data-secret-token={import.meta.env.PUBLIC_RECRUITMENT_SECRET}
      >
        <ViewUpcoming initialStage={initialStage} upcomingCfg={upcomingCfg} docLimits={docLimits} studentYears={studentYears} piTemplateUrl={piTemplateUrl} />
        <ViewOpenForm initialStage={initialStage} registrationConfig={registrationConfig} extendedCfg={extendedCfg} studentYears={studentYears} docLimits={docLimits} divisions={divisions} piTemplateUrl={piTemplateUrl} minReasonWords={minReasonWords} />
        <ViewScreening initialStage={initialStage} selectionCfg={selectionCfg} />
        <ViewScreeningResults initialStage={initialStage} selectionResultsCfg={selectionResultsCfg} />
        <ViewTechnicalTest initialStage={initialStage} technicalTestCfg={technicalTestCfg} />
        <ViewTechnicalTestResults initialStage={initialStage} technicalTestResultsCfg={technicalTestResultsCfg} />
        <ViewInterview initialStage={initialStage} interviewCfg={interviewCfg} />
        <ViewAnnouncement initialStage={initialStage} announcementCfg={announcementCfg} acceptedCandidates={acceptedCandidates} candidatesByDivision={candidatesByDivision} />
        <ViewClosed initialStage={initialStage} closedCfg={closedCfg} />
        <ViewFallback initialStage={initialStage} fallbackCfg={fallbackCfg} piTemplateUrl={piTemplateUrl} />
        {initialStage !== 'closed' && (
          <ContactPersonBox contactPersons={contactPersons} />
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initRegistrationScript } from '../scripts/registration';
  initRegistrationScript();
</script>
