---
import TimelineSteps from './TimelineSteps.astro';
import StageInfoPanel from './StageInfoPanel.astro';
import BackToHomeButton from './BackToHomeButton.astro';

interface Props {
  initialStage: string;
  interviewCfg: {
    title: string;
    subtitle: string;
    message: string;
    scheduleInfo?: string;
    locationInfo?: string;
  };
}

const { initialStage, interviewCfg } = Astro.props;
---

<div id="view-interview" class={initialStage === 'interview' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{interviewCfg.title}</h2>
    <p class="registration-hero-subtitle">{interviewCfg.subtitle}</p>
  </div>

  <TimelineSteps activeStepIndex={4} />

  <StageInfoPanel
    iconClass="fa-comments"
    message={interviewCfg.message}
    scheduleInfo={interviewCfg.scheduleInfo}
    locationInfo={interviewCfg.locationInfo}
    locationIconClass="fa-video"
  />

  <BackToHomeButton />
</div>
