---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import { getCurrentRecruitmentStage } from '../utils/recruitment';
import { parseDivisions, toDivisionPanels } from '../utils/division-mapper';
import { STAGE_LABELS } from '../utils/constants';
import type { AboutData, Member } from '../utils/types';
import EventPosterModal from '../components/events/EventPosterModal.astro';
import EimHero from '../components/home/EimHero.astro';
import EimReveal from '../components/home/EimReveal.astro';
import EimFocus from '../components/home/EimFocus.astro';
import EimVisiMisi from '../components/home/EimVisiMisi.astro';
import EimDivisions from '../components/home/EimDivisions.astro';
import EimNews from '../components/home/EimNews.astro';
import EimEvents from '../components/home/EimEvents.astro';
import {
  getLocaleFromUrl,
  getLocalizedJsonData,
  getCollectionEntriesForLocale,
  t
} from '../utils/i18n';
import { filterAuditContent } from '../utils/content-helpers';

const locale = getLocaleFromUrl(Astro.url);
const divisionsData = await getLocalizedJsonData<any>('divisions', locale);
const registrationConfig = await getLocalizedJsonData<any>('registration', locale);
const about = await getLocalizedJsonData<AboutData>('about', locale);
const membersData = await getLocalizedJsonData<{ list: Member[] }>('members', locale);

const divisions = parseDivisions(divisionsData);
const members = membersData?.list ?? [];
const divisionPanels = toDivisionPanels(divisions, members);

// Fetch and filter news for active locale
const rawNews = await getCollection('news');
const localizedNews = getCollectionEntriesForLocale(rawNews, locale);

const latestNews = filterAuditContent(localizedNews)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) {
      return a.data.featured ? -1 : 1;
    }
    return new Date(b.data.news_date).getTime() - new Date(a.data.news_date).getTime();
  })
  .slice(0, 3);

// Events: upcoming first, then most recent — the section shows the next two as large poster tiles.
const rawEvents = await getCollection('events');
const events = filterAuditContent(rawEvents)
  .slice()
  .sort((a, b) => {
    const aUpcoming = a.data.status === 'upcoming' ? 0 : 1;
    const bUpcoming = b.data.status === 'upcoming' ? 0 : 1;
    if (aUpcoming !== bUpcoming) return aUpcoming - bUpcoming;
    return new Date(b.data.event_date).getTime() - new Date(a.data.event_date).getTime();
  });

const upcomingEvents = events.filter((event) => event.data.status === 'upcoming');

// Hero CTA: server-rendered Indonesian label; initHomeCTA keeps it fresh at runtime.
const currentStage = getCurrentRecruitmentStage(registrationConfig);
const stageEntry =
  currentStage === 'closed'
    ? STAGE_LABELS.closed
    : STAGE_LABELS[currentStage] ?? STAGE_LABELS.selection;
const primaryLabel = stageEntry?.label ?? 'Gabung EIM';
const primaryHref = stageEntry?.href ?? '/registration';
---

<Layout title={`EIM Research Lab - ${t('home.heroTag', locale)}`} homeSkin>
  <EventPosterModal upcomingEvents={upcomingEvents} locale={locale} />
  <main id="main-content">
    <EimHero primaryLabel={primaryLabel} primaryHref={primaryHref} />
    <EimReveal />
    <EimFocus />
    <EimVisiMisi about={about} />
    <EimDivisions panels={divisionPanels} />
    <EimEvents events={events} locale={locale} />
    <EimNews news={latestNews} locale={locale} />
  </main>
</Layout>

<script>
  import { initGlobalStageSync } from '../scripts/global-stage-sync';
  import { initHomeCTA } from '../scripts/home-eim';

  const stage = initGlobalStageSync();
  initHomeCTA(stage);
</script>
