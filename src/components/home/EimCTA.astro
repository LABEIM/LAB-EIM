---
import { getLocaleFromUrl, getLocalizedJsonData } from '../../utils/i18n';
import { resolveStageCta } from '../../utils/constants';
import type { ChromeData } from '../../utils/types';

interface Props {
  content: ChromeData['cta'];
  contact: { location: string; email: string };
  stage: string;
}

const { content, contact, stage } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const chrome = getLocalizedJsonData<ChromeData>('chrome', locale);
const primaryCta = resolveStageCta(stage);
const joinIsPrimary = primaryCta.href === '/registration';
---

<section id="gabung" class="eim-cta" aria-labelledby="eim-cta-title">
  <div class="mx-auto grid max-w-[1200px] items-end gap-10 px-[clamp(1.25rem,4vw,4rem)] py-[clamp(4.5rem,10vh,8.75rem)] lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)]">
    <div>
      <h2 id="eim-cta-title" class="text-balance text-background font-display text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.02] tracking-[-0.01em]">
        {content.title}
      </h2>
      <p class="mt-5 max-w-[52ch] text-[15px] leading-[1.6] text-surface-strong">{content.description}</p>
    </div>
    <div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          class="eim-cta-primary"
          href={primaryCta.href}
          data-stage-primary
          data-contact-label={content.contactLabel}>{primaryCta.href === '/contact' ? content.contactLabel : primaryCta.label}</a>
        <a class="eim-cta-secondary" href="/registration" data-stage-secondary hidden={joinIsPrimary}>
          {chrome.nav.joinUs} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="mt-10 border-t border-white/15 pt-4 font-mono text-xs uppercase tracking-[0.08em] text-surface-strong">
        <p>{contact.location}</p>
        <a class="mt-2 inline-block text-brand-bright underline underline-offset-4" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
    </div>
  </div>
</section>
