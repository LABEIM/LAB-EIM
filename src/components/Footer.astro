---
import { getLocaleFromUrl, getLocalizedPath, getLocalizedJsonData, t } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const siteData = await getLocalizedJsonData<any>('site', locale);
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', key: 'nav.home' },
  { href: '/about', key: 'nav.about' },
  { href: '/structure', key: 'nav.structure' },
  { href: '/event', key: 'nav.event' },
  { href: '/news', key: 'nav.news' },
  { href: '/registration', key: 'nav.register' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a href={getLocalizedPath('/', locale)} class="logo-container">
          <div class="logo-icon logo-icon-sm">
            <img src={siteData.logo} alt={`${siteData.name} Logo`} width="30" height="30" />
          </div>
          <div class="logo-text">
            <span class="text-gradient-dual logo-text-sm">{siteData.name}</span>
            <span class="logo-sub logo-sub-sm">{siteData.subName}</span>
          </div>
        </a>
        <p>{siteData.fullName} — {t('footer.description', locale)}</p>
      </div>

      <div>
        <h4 class="footer-title">{t('footer.quickLinks', locale)}</h4>
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={getLocalizedPath(link.href, locale)}>{t(link.key, locale)}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="footer-title">{t('footer.contact', locale)}</h4>
        <ul class="footer-links footer-contact-list">
          <li><i class="fa-solid fa-location-dot footer-icon-red"></i> {siteData.contact.location}</li>
          <li><i class="fa-solid fa-university footer-icon-red"></i> {siteData.contact.university}</li>
          <li><i class="fa-solid fa-envelope footer-icon-cyan"></i> {siteData.contact.email}</li>
        </ul>
        <h4 class="footer-title footer-social-title">Social Media</h4>
        <div class="footer-connect-list">
          {siteData.socials.instagram && (
            <a href={siteData.socials.instagram} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="Instagram @eimresearchlab">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="2" width="28" height="28" rx="6" fill="url(#paint0_radial_87_7153)" />
                <rect x="2" y="2" width="28" height="28" rx="6" fill="url(#paint1_radial_87_7153)" />
                <rect x="2" y="2" width="28" height="28" rx="6" fill="url(#paint2_radial_87_7153)" />
                <path d="M23 10.5C23 11.3284 22.3284 12 21.5 12C20.6716 12 20 11.3284 20 10.5C20 9.67157 20.6716 9 21.5 9C22.3284 9 23 9.67157 23 10.5Z" fill="white" />
