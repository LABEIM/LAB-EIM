---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home-eim.css';
import '../../styles/pages/kegiatan-eim.css';
import KegiatanRecapHero from '../../components/kegiatan/KegiatanRecapHero.astro';
import KegiatanStory from '../../components/kegiatan/KegiatanStory.astro';
import KegiatanGallery from '../../components/kegiatan/KegiatanGallery.astro';
import KegiatanRelated from '../../components/kegiatan/KegiatanRelated.astro';
import {
  getCleanSlug,
  getCollectionEntriesForLocale,
  getLocaleFromUrl,
  t,
} from '../../utils/i18n';
import { filterAuditContent } from '../../utils/content-helpers';
import {
  compareEventDates,
  getEventStoryGallery,
} from '../../utils/event-helpers';
import type { EventEntry } from '../../utils/event-helpers';

export async function getStaticPaths() {
  const events = await getCollection('events');
  // Intentionally includes audit content: CI benchmarks this route.
  return events.map((event) => ({
    params: { id: getCleanSlug(event.id) },
    props: { event },
  }));
}

interface Props {
  event: EventEntry;
}

const locale = getLocaleFromUrl(Astro.url);
const { event } = Astro.props;
const { Content } = await render(event);

const all = filterAuditContent(getCollectionEntriesForLocale(await getCollection('events'), locale));
// Sort once, then keep same-category entries first (filters preserve order).
const pool = all
  .filter((item) => item.id !== event.id)
  .sort((a, b) => compareEventDates(a, b, 'desc'));
const related = [
  ...pool.filter((item) => item.data.category === event.data.category),
  ...pool.filter((item) => item.data.category !== event.data.category),
].slice(0, 3);
---

<Layout
  title={`${event.data.title} · EIM Research Lab`}
  description={event.data.description}
  homeSkin
  skipLink
>
  <main id="main-content" tabindex="-1">
    <KegiatanRecapHero event={event} locale={locale} />
    <KegiatanStory event={event}>
      <Content />
    </KegiatanStory>
    <KegiatanGallery event={event} locale={locale} />
    {!event.body?.trim() && getEventStoryGallery(event).length === 0 && (
      <p class="kegiatan-recap-empty">{t('events.recapEmpty', locale)}</p>
    )}
    <KegiatanRelated events={related} locale={locale} />
    <div class="kegiatan-recap-end">
      <a class="kegiatan-back" href="/event">{t('events.backToIndex', locale)}</a>
    </div>
  </main>
</Layout>

<script>
  import { initShareButtons } from '../../scripts/share';
  initShareButtons('Kegiatan');
</script>
