---
/**
 * -----------------------------------------------------------------------------------
 * POSTER & PRODUCTION BACKWARDS-COMPATIBILITY ROUTE HANDLER: /registration
 * -----------------------------------------------------------------------------------
 * NOTICE FOR LAB STAFF:
 * This route exists to preserve 100% backwards compatibility for existing production links
 * and physical printed posters containing the URL: https://eimlab.org/registration/
 *
 * Current behavior: Redirects visitors scanning/clicking poster links directly to the
 * dedicated recruitment route: /open-recruitment (or /forms/[slug] if ?event=slug is passed).
 *
 * REMINDER WHEN REGISTRATION BATCH CLOSES:
 * Once the current recruitment batch closes or poster designs are updated for future cycles,
 * you can deactivate or remove this redirect block below to customize this route.
 * -----------------------------------------------------------------------------------
 */

import { getLocaleFromUrl, getLocalizedPath } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const urlEventId = Astro.url.searchParams.get('event');
const searchString = Astro.url.search || '';

const redirectPath = urlEventId
  ? getLocalizedPath(`/forms/${encodeURIComponent(urlEventId)}${searchString}`, locale)
  : getLocalizedPath(`/open-recruitment${searchString}`, locale);

if (redirectPath) {
  return Astro.redirect(redirectPath, 302);
}
