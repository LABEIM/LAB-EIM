---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home-eim.css';
import { getLocaleFromUrl, getLocalizedJsonData, t } from '../utils/i18n';
import { countPeopleByGroup, groupPeople, parsePositions } from '../utils/position-mapper';
import type { AboutData, Lecturer, Member } from '../utils/types';
import AboutHero from '../components/about/AboutHero.astro';
import AboutProfile from '../components/about/AboutProfile.astro';
import AboutStats from '../components/about/AboutStats.astro';
import EimVisiMisi from '../components/home/EimVisiMisi.astro';
import AboutTeam from '../components/about/AboutTeam.astro';
import EimCTA from '../components/home/EimCTA.astro';
import EimSectionNav from '../components/home/EimSectionNav.astro';

const locale = getLocaleFromUrl(Astro.url);
const aboutData = getLocalizedJsonData<AboutData>('about', locale);
const siteData = getLocalizedJsonData<any>('site', locale);
const membersData = getLocalizedJsonData<{ list: Member[] }>('members', locale);
const lecturersData = getLocalizedJsonData<{ list: Lecturer[] }>('lecturers', locale);
const positionsData = getLocalizedJsonData<{ list: unknown }>('positions', locale);

const positions = parsePositions(positionsData);
const members: Member[] = membersData?.list ?? [];
const lecturers: Lecturer[] = lecturersData?.list ?? [];
const people = [...lecturers, ...members];
const sections = groupPeople(people, positions);
const groupCounts = countPeopleByGroup(people, positions);
const courses = await getCollection('courses');

const sectionItems = [
  { id: 'profil', label: t('about.navDotProfile', locale) },
  { id: 'angka', label: t('about.navDotStats', locale) },
  { id: 'visi-misi', label: t('home.navDotVision', locale) },
  { id: 'koordinator', label: t('about.navDotTeam', locale) },
  { id: 'gabung', label: t('about.navDotCta', locale) },
];
---

<Layout title={`${t('nav.about', locale)} · EIM Research Lab`} description={aboutData.description} homeSkin skipLink>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={t('about.sectionNavLabel', locale)} />
    <AboutHero />
    <AboutProfile about={aboutData} site={siteData} />
    <AboutStats
      membersCount={groupCounts.asisten + groupCounts.mahasiswa}
      courseCount={courses.length}
      focusCount={4}
    />
    <EimVisiMisi about={aboutData} />
    <AboutTeam sections={sections} />
    <EimCTA site={siteData} />
  </main>
</Layout>
