            </a>
          )}
          {siteData.socials.youtube && (
            <a href={siteData.socials.youtube} target="_blank" rel="noopener noreferrer" class="footer-connect-btn" title="YouTube EIM Research Lab">
              <svg viewBox="0 0 48 34" xmlns="http://www.w3.org/2000/svg">
                <path d="M19.044 23.27 19.0425 9.688 32.0115 16.502 19.044 23.27 Z M47.52 7.334 C47.52 7.334 47.0505 4.003 45.612 2.536 C43.7865 0.61 41.7405 0.601 40.803 0.489 C34.086 0 24.0105 0 24.0105 0 L23.9895 0 C23.9895 0 13.914 0 7.197 0.489 C6.258 0.601 4.2135 0.61 2.3865 2.536 C0.948 4.003 0.48 7.334 0.48 7.334 C0.48 7.334 0 11.247 0 15.158 L0 18.826 C0 22.738 0.48 26.649 0.48 26.649 C0.48 26.649 0.948 29.98 2.3865 31.447 C4.2135 33.373 6.612 33.313 7.68 33.514 C11.52 33.885 24 34 24 34 C24 34 34.086 33.985 40.803 33.495 C41.7405 33.382 43.7865 33.373 45.612 31.447 C47.0505 29.98 47.52 26.649 47.52 26.649 C47.52 26.649 48 22.738 48 18.826 L48 15.158 C48 11.247 47.52 7.334 47.52 7.334 Z" fill="#CE1312" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} {siteData.fullName}. {t('footer.rights', locale)}</p>
      <p>Designed with <i class="fa-solid fa-heart footer-heart-icon"></i> in Telkom University</p>
    </div>
  </div>
</footer>
