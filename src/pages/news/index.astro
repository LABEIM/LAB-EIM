---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home-eim.css';
import '../../styles/pages/news-eim.css';
import EimSectionNav from '../../components/home/EimSectionNav.astro';
import FilterControlBar from '../../components/common/FilterControlBar.astro';
import Pagination from '../../components/common/Pagination.astro';
import { getCleanSlug, getCollectionEntriesForLocale, getLocaleFromUrl, getLocalizedPath, t } from '../../utils/i18n';
import { filterAuditContent } from '../../utils/content-helpers';
import { calculateReadingTime } from '../../utils/news-helpers';
import { formatGlobalDate, parseGlobalDateStr } from '../../utils/date';
import { DEFAULT_COVER_IMAGE } from '../../utils/constants';

const locale = getLocaleFromUrl(Astro.url);

const rawNews = await getCollection('news');
const news = filterAuditContent(getCollectionEntriesForLocale(rawNews, locale)).sort((a, b) => {
  const timeA = parseGlobalDateStr(a.data.news_date);
  const timeB = parseGlobalDateStr(b.data.news_date);
  return timeA === timeB ? 0 : timeB - timeA;
});

const categories = [...new Set(news.map((item) => item.data.category).filter(Boolean))].sort();

const latestYear =
  news
    .map((item) => parseGlobalDateStr(item.data.news_date))
    .filter(Boolean)
    .map((ms) => String(new Date(ms).getUTCFullYear()))
    .sort((a, b) => b.localeCompare(a))[0] ?? null;

const titleLines = t('news.heroTitle', locale).split('\n');
const sectionItems = [
  { id: 'artikel', label: t('news.heroEyebrow', locale) },
  { id: 'daftar', label: t('news.navDotList', locale) },
];
---

<Layout title={`${t('news.title', locale)} · EIM Lab`} description={t('news.metaDescription', locale)} homeSkin skipLink>
  <main id="main-content" tabindex="-1">
    <EimSectionNav items={sectionItems} label={t('news.sectionNavLabel', locale)} />

    <section id="artikel" class="eim-hero eim-subhero" aria-labelledby="news-hero-title">
      <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>
      <div class="eim-hero-inner">
        <p class="eim-eyebrow">{t('news.heroEyebrow', locale)}</p>
        <h1 id="news-hero-title" class="eim-hero-title">
          {titleLines.map((line) => <span class="eim-hero-title-line">{line}</span>)}
        </h1>
        <p class="eim-hero-desc">{t('news.heroDesc', locale)}</p>
        <div class="eim-hero-actions">
          <a class="eim-hero-cta" href="#daftar">{t('news.heroPrimary', locale)}</a>
          <a class="eim-hero-secondary" href="/event">
            {t('news.heroSecondary', locale)} <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="eim-subhero-meta">
          {news.length === 0
            ? t('news.heroMetaEmpty', locale)
            : t('news.heroMeta', locale, {
                articles: String(news.length),
                categories: String(categories.length),
                year: latestYear ?? '—',
              })}
        </p>
      </div>
    </section>

    <section id="daftar" class="py-[clamp(4.5rem,10vh,8.75rem)]" aria-labelledby="news-list-title">
      <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">
              01 — {t('news.listEyebrow', locale)}
            </p>
            <h2
              id="news-list-title"
              class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
            >
              {t('news.listTitle', locale)}
            </h2>
          </div>
          <p class="e-reveal max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink lg:justify-self-end">
            {t('news.listIntro', locale)}
          </p>
        </div>

        {news.length === 0 ? (
          <div class="news-empty e-reveal mt-[clamp(2.5rem,6vh,4rem)]">
            <p class="news-empty-title">{t('news.listEmptyTitle', locale)}</p>
            <p class="news-empty-desc">{t('news.listEmptyDesc', locale)}</p>
            <div class="news-empty-actions">
              <a class="eim-hero-cta" href="/event">{t('news.heroSecondary', locale)}</a>
              <a class="eim-hero-secondary" href="/contact">
                {t('news.contact', locale)} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ) : (
          <div class="eim-list-filter">
            <FilterControlBar
              categories={categories}
              searchPlaceholder={t('news.searchPlaceholder', locale)}
              totalCount={news.length}
            />

            <div id="news-list-empty" class="news-list-empty" style="display: none;">
              <p class="news-empty-title">{t('news.listNoMatchTitle', locale)}</p>
              <p class="news-empty-desc">{t('news.listNoMatchDesc', locale)}</p>
            </div>

            <ul id="news-list-grid" class="news-list-grid e-reveal-group">
              {news.map((item, index) => {
                const cover = item.data.image?.[0] || DEFAULT_COVER_IMAGE;
                const excerptText = item.data.excerpt || item.body || '';
                const tagsText = (item.data.tags || []).join(' ');
                const searchText = `${item.data.title} ${item.data.category} ${item.data.author || ''} ${excerptText} ${tagsText}`.toLowerCase();
                return (
                  <li
                    class="news-list-item grid-card-item"
                    style={`--i:${index}`}
                    data-title={item.data.title}
                    data-category={item.data.category}
                    data-date={item.data.news_date}
                    data-author={item.data.author}
                    data-search-text={searchText}
                    data-audit={item.data.audit ? 'true' : undefined}
                  >
                    <a class="news-list-card" href={getLocalizedPath(`/news/${getCleanSlug(item.id)}`, locale)}>
                      <span class="news-list-media">
                        <img src={cover} alt="" width="800" height="500" loading="lazy" decoding="async" />
                        {item.data.featured && (
                          <span class="news-list-featured">{t('news.featured', locale)}</span>
                        )}
                      </span>
                      <span class="news-list-meta">
                        <time datetime={item.data.news_date}>{formatGlobalDate(item.data.news_date)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{item.data.category}</span>
                      </span>
                      <h3 class="news-list-title">{item.data.title}</h3>
                      <span class="news-list-excerpt">{excerptText}</span>
                      <span class="news-list-footer">
                        <span>{item.data.author}</span>
                        <span>{calculateReadingTime(item.body)}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>

            <Pagination />
          </div>
        )}
      </div>
    </section>

  </main>
</Layout>

<script>
  import { initTopologyField } from '../../scripts/topology-field';
  import { initContentFilter } from '../../scripts/content-filter';

  initTopologyField();
  initContentFilter({
    gridId: 'news-list-grid',
    cardClass: 'grid-card-item',
    itemsPerPage: 6,
    emptyStateId: 'news-list-empty',
    itemName: 'Artikel',
  });
</script>
