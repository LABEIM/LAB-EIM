---
import { getLocaleFromUrl, t } from '../../utils/i18n';

interface Props {
  title: string;
  inputId: string;
  buttonId: string;
  resultBoxId: string;
  buttonLabel?: string;
  containerClass?: string;
}

const locale = getLocaleFromUrl(Astro.url);

const {
  title,
  inputId,
  buttonId,
  resultBoxId,
  buttonLabel = t('btn.search', locale),
  containerClass = ""
} = Astro.props;
---

<div class={`search-lookup-box ${containerClass}`.trim()}>
  <h3 class="search-lookup-title">
    <i class="fa-solid fa-magnifying-glass reg-icon-mr-sm"></i> {title}
  </h3>
  <div class="search-lookup-form">
    <input type="text" id={inputId} class="form-control reg-input-bg" placeholder={t('reg.resultsPlaceholder', locale)} />
    <button id={buttonId} class="btn btn-primary reg-btn-search">
      {buttonLabel} <i class="fa-solid fa-search reg-icon-ml-xs"></i>
    </button>
  </div>
  <div id={resultBoxId} class="search-result-display"></div>
</div>
