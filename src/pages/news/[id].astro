---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home-eim.css';
import '../../styles/pages/news-eim.css';
import { getLocaleFromUrl, getCleanSlug, getLocalizedPath, getCollectionEntriesForLocale, t } from '../../utils/i18n';
import { calculateReadingTime, getRelatedNews } from '../../utils/news-helpers';
import { filterAuditContent } from '../../utils/content-helpers';
import { formatGlobalDate } from '../../utils/date';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item: any) => {
    const slug = getCleanSlug(item.id);
    return {
      params: { id: slug },
      props: { item },
    };
  });
}

const locale = getLocaleFromUrl(Astro.url);
const { item } = Astro.props;
const images = item.data.image || [];
const tags = item.data.tags || [];
const { Content } = await render(item);

const rawAllNews = await getCollection('news');
const allNews = filterAuditContent(getCollectionEntriesForLocale(rawAllNews, locale));
const relatedNews = getRelatedNews(item.id, allNews, 3);

const formattedDate = formatGlobalDate(item.data.news_date);
const readTime = calculateReadingTime(item.body);
const metaDesc = item.data.excerpt || `${item.data.title} - EIM Research Lab`;
const newsIndexHref = getLocalizedPath('/news', locale);
---

<Layout title={`${item.data.title} - EIM Research Lab`} description={metaDesc} homeSkin skipLink>
  <main id="main-content" tabindex="-1">
    <section class="article-detail-hero" aria-labelledby="article-title">
      <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
        <div class="article-detail-top">
          <a class="article-back" href={newsIndexHref}>
            <span aria-hidden="true">←</span> {t('news.backToList', locale)}
          </a>
          <button type="button" class="article-share share-btn">{t('news.share', locale)}</button>
        </div>

        <div class="article-eyebrow e-reveal">
          {item.data.featured && <span class="article-featured">{t('news.featured', locale)}</span>}
          <span>{item.data.category}</span>
          <span aria-hidden="true">·</span>
          <time datetime={item.data.news_date}>{formattedDate}</time>
        </div>

        <h1 id="article-title" class="article-title e-reveal">{item.data.title}</h1>

        {item.data.excerpt && <p class="article-standfirst e-reveal">{item.data.excerpt}</p>}

        <p class="article-meta e-reveal">
          <span>{t('news.author', locale)}: {item.data.author}</span>
          <span aria-hidden="true">·</span>
          <span>{readTime}</span>
        </p>

        {images.length > 0 && (
          <div class="article-cover e-reveal">
            <Image
              src={images[0]}
              alt=""
              width={1600}
              height={900}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )}
      </div>
    </section>

    <article class="article-story">
      <div class="article-story-inner">
        <div class="eim-prose">
          <Content />
        </div>

        {tags.length > 0 && (
          <div class="article-tags">
            <span class="article-tags-label">{t('news.topics', locale)}</span>
            <ul class="article-tag-list">
              {tags.map((tag: string) => <li class="article-tag">#{tag}</li>)}
            </ul>
          </div>
        )}
      </div>
    </article>

    {relatedNews.length > 0 && (
      <section class="article-related" aria-labelledby="article-related-title">
        <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
          <p class="e-reveal font-mono text-xs uppercase tracking-[0.08em] text-brand">
            {t('news.relatedEyebrow', locale)}
          </p>
          <h2
            id="article-related-title"
            class="e-reveal mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] tracking-[-0.01em]"
          >
            {t('news.relatedTitle', locale)}
          </h2>
          <p class="e-reveal mt-4 max-w-[52ch] text-[15px] leading-[1.55] text-muted-ink">
            {t('news.relatedIntro', locale)}
          </p>

          <ul class="article-related-list e-reveal-group">
            {relatedNews.map((related, index) => (
              <li class="article-related-row" style={`--i:${index}`}>
                <a href={getLocalizedPath(`/news/${getCleanSlug(related.id)}`, locale)}>
                  <span class="article-related-meta">
                    <time datetime={related.data.news_date}>{formatGlobalDate(related.data.news_date)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{related.data.category}</span>
                  </span>
                  <h3 class="article-related-title">{related.data.title}</h3>
                  <span class="article-related-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <div class="article-end">
      <a class="article-back" href={newsIndexHref}>
        <span aria-hidden="true">←</span> {t('news.backToIndex', locale)}
      </a>
    </div>
  </main>
</Layout>

<script>
  import { initShareButtons } from '../../scripts/share';
  initShareButtons('Berita');
</script>
