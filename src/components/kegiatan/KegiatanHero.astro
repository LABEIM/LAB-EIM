---
import type { EventsPageData } from '../../utils/types';

interface Props {
  content: EventsPageData['hero'];
  totalCount: number;
  categoryCount: number;
  latestYear: string | null;
  showPrimary?: boolean;
}

const { content, totalCount, categoryCount, latestYear, showPrimary = true } = Astro.props;
const meta = (content.meta ?? '')
  .replaceAll('{events}', String(totalCount))
  .replaceAll('{categories}', String(categoryCount))
  .replaceAll('{year}', latestYear ?? '—');
---

<section id="kegiatan" class="eim-hero eim-subhero" aria-labelledby="kegiatan-hero-title">
  <canvas class="eim-hero-canvas" aria-hidden="true"></canvas>
  <div class="eim-hero-inner">
    <p class="eim-eyebrow">{content.eyebrow}</p>
    <h1 id="kegiatan-hero-title" class="eim-hero-title">
      {content.lines.map((line, index) => (
        <>
          <span class="eim-hero-title-line">{line}</span>{index < content.lines.length - 1 ? ' ' : ''}
        </>
      ))}
    </h1>
    <p class="eim-hero-desc">{content.description}</p>
    <div class="eim-hero-actions">
      {showPrimary && <a class="eim-hero-cta" href="#daftar">{content.primaryLabel}</a>}
      <a class="eim-hero-secondary" href="/news">
        {content.secondaryLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="eim-subhero-meta">
      {totalCount === 0 ? content.metaEmpty : meta}
    </p>
  </div>
</section>

<script>
  import { initTopologyField } from '../../scripts/topology-field';
  initTopologyField();
</script>
