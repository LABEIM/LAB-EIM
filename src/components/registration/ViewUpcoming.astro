---
import BackToHomeButton from './BackToHomeButton.astro';

interface Props {
  initialStage: string;
  upcomingCfg: {
    title: string;
    subtitle: string;
    prepNotice: string;
  };
  docLimits: {
    ksmMb: number;
    khsMb: number;
    mlMb: number;
    cvMb: number;
    piMb: number;
    totalMb?: number;
  };
  studentYears: string[];
  piTemplateUrl?: string;
}

const { initialStage, upcomingCfg, docLimits, studentYears, piTemplateUrl } = Astro.props;
---

<div id="view-upcoming" class={initialStage === 'upcoming' ? '' : 'is-hidden'}>
  <div class="registration-header">
    <h2>{upcomingCfg.title}</h2>
    <p class="hero-desc registration-hero-subtitle">{upcomingCfg.subtitle}</p>
  </div>

  <div class="registration-timer reg-timer-mb" id="upcoming-timer">
    <div class="timer-block">
      <div id="u-timer-days" class="reg-timer-days">0</div>
      <div class="reg-timer-label">Days</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-hours" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Hours</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-minutes" class="reg-timer-val">0</div>
      <div class="reg-timer-label">Minutes</div>
    </div>
    <div class="timer-block">
      <div id="u-timer-seconds" class="reg-timer-val-red">0</div>
      <div class="reg-timer-label">Seconds</div>
    </div>
  </div>

  <div class="checklist-box">
    <h3 class="checklist-title">
      <i class="fa-solid fa-list-check reg-icon-mr-sm"></i> Document Checklist & Requirements
    </h3>
    <p class="reg-checklist-notice">{upcomingCfg.prepNotice}</p>
    <ul class="checklist-list">
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>Kartu Studi Mahasiswa (KSM)</strong> - Max {docLimits.ksmMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>Kartu Hasil Studi (KHS)</strong> - Max {docLimits.khsMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>Motivation Letter (ML)</strong> - Max {docLimits.mlMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>Curriculum Vitae (CV)</strong> - Max {docLimits.cvMb}MB</span>
      </li>
      <li>
        <i class="fa-solid fa-check reg-checklist-icon"></i>
        <span><strong>Pakta Integritas (PI)</strong> - Max {docLimits.piMb}MB</span>
        {piTemplateUrl && (
          <a href={piTemplateUrl} target="_blank" rel="noopener noreferrer" class="checklist-download-btn">
            <i class="fa-solid fa-file-arrow-down"></i>
            <span>Download Template</span>
          </a>
        )}
      </li>
      <li>
        <i class="fa-solid fa-user-graduate reg-checklist-icon"></i>
        <span><strong>Eligible Student Years:</strong> {studentYears.join(", ")}</span>
      </li>
    </ul>
  </div>

  <BackToHomeButton />
</div>


