---
interface Props {
  id?: string;
  label: string;
  stats: { label: string; value: number }[];
}

const { id, label, stats } = Astro.props;
---

<section id={id} aria-label={label} class="pb-[clamp(3rem,7vh,5rem)]">
  <div class="mx-auto max-w-[1200px] px-[clamp(1.25rem,4vw,4rem)]">
    <dl class="e-reveal grid grid-cols-1 border-y border-line sm:grid-cols-3">
      {stats.map((stat) => (
        <div class="flex flex-col-reverse items-center gap-3 border-b border-line py-10 text-center last:border-b-0 sm:border-b-0 sm:border-r sm:px-4 sm:last:border-r-0 lg:px-8">
          <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-ink lg:text-xs">{stat.label}</dt>
          <dd class="font-display text-[clamp(3.5rem,7vw,6rem)] leading-none">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
