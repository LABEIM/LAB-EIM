---
import Layout from '../layouts/Layout.astro';
import { getLocaleFromUrl, getLocalizedJsonData } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const siteData = await getLocalizedJsonData<any>('site', locale);
const contactPageData = await getLocalizedJsonData<any>('contact', locale);

const contactInfo = siteData.contact || {};
const socials = siteData.socials || {};

const title = contactPageData.title || 'Hubungi Kami';
const heroDescription = contactPageData.heroDescription || 'Laboratorium Riset Enterprise Infrastructure Management Telkom University siap melayani pertanyaan, kolaborasi riset, dan informasi kegiatan.';
const locationTitle = contactPageData.locationTitle || 'Lokasi Laboratorium';
const locationText = contactPageData.location || contactInfo.location || 'Gedung TULT Lantai 8, Ruang TULT.08.09';
const universityText = contactPageData.university || contactInfo.university || 'Telkom University, Bandung, Indonesia';
const mapsUrl = contactPageData.mapsUrl || 'https://maps.google.com/?q=Telkom+University+Bandung';
const mapsEmbedUrl = contactPageData.mapsEmbedUrl || 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.3074993116813!2d107.63168547587637!3d-6.973007068278278!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68e9ad770c0c75%3A0xb35183efb1c099c2!2sTelkom%20University%20Landmark%20Tower%20(TULT)!5e0!3m2!1sid!2sid!4v1710000000000!5m2!1sid!2sid';
const emailTitle = contactPageData.emailTitle || 'Email Resmi';
const emailText = contactPageData.email || contactInfo.email || 'eimlab@telkomuniversity.ac.id';
const hoursTitle = contactPageData.hoursTitle || 'Jam Operasional Lab';
const hoursText = contactPageData.hoursText || 'Senin - Jumat: 08.00 - 17.00 WIB';
const hoursSubtext = contactPageData.hoursSubtext || 'Kunjungan offline dapat disesuaikan dengan janji perizinan atau jadwal kegiatan laboratorium.';
const mapSectionTitle = contactPageData.mapSectionTitle || 'Peta Lokasi Laboratorium';
const mapSectionSubtitle = contactPageData.mapSectionSubtitle || 'Temukan lokasi Gedung Telkom University Landmark Tower (TULT) di kampus Telkom University Bandung.';

const pageTitle = `${title} - ${siteData.fullName || 'EIM Research Lab'}`;
const pageDescription = `${locationText}, ${mapSectionTitle.toLowerCase()}, dan saluran komunikasi Enterprise Infrastructure Management (EIM) Research Lab Telkom University.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="page-header">
    <div class="container">
      <div class="page-header-content">
        <h1>{title}</h1>
        <p class="hero-desc">
          {heroDescription}
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      {/* Contact Direct Cards Grid */}
      <div class="contact-grid">
        {/* Location Card */}
        <div class="contact-card">
          <div class="contact-icon-wrapper">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <h3 class="contact-card-title">{locationTitle}</h3>
          <p class="contact-card-text">
            {locationText}<br />
            {universityText}
          </p>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-card-link"
          >
            <span>Buka di Google Maps</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        {/* Email Card */}
        <div class="contact-card">
          <div class="contact-icon-wrapper">
            <i class="fa-solid fa-paper-plane"></i>
          </div>
          <h3 class="contact-card-title">{emailTitle}</h3>
          <p class="contact-card-text">
            Untuk keperluan riset, kerja sama, atau pertanyaan umum, kirimkan surat elektronik ke email resmi kami:
            <br />
            <strong style="color: var(--text-primary); margin-top: 8px; display: inline-block;">
              {emailText}
            </strong>
          </p>
          <a
            href={`mailto:${emailText}`}
            class="contact-card-link"
          >
            <span>Kirim Pesan Email</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        {/* Lab Working Hours / Operational Info */}
        <div class="contact-card">
          <div class="contact-icon-wrapper">
            <i class="fa-solid fa-clock"></i>
          </div>
          <h3 class="contact-card-title">{hoursTitle}</h3>
          <p class="contact-card-text">
            {hoursText}<br />
            {hoursSubtext}
          </p>
          <a href="#map-location" class="contact-card-link">
            <span>Lihat Peta Lokasi</span>
            <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
      </div>

      {/* Embedded Google Maps Section */}
      <div id="map-location" class="map-container">
        <h2 class="map-title">{mapSectionTitle}</h2>
        <p class="map-subtitle">
          {mapSectionSubtitle}
        </p>
        <div class="map-wrapper">
          <iframe
            src={mapsEmbedUrl}
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokasi Telkom University Landmark Tower"
          ></iframe>
        </div>
      </div>

      {/* Social Media Hub */}
      <div class="socials-hub-container">
        <h2 class="socials-hub-title">Media Sosial Resmi</h2>
        <p class="socials-hub-subtitle">
          Ikuti perkembangan kegiatan riset, pelatihan, dan pengumuman rekrutmen terbaru di media sosial EIM.
        </p>

        <div class="socials-grid">
          {socials.instagram && (
            <a href={socials.instagram} target="_blank" rel="noopener noreferrer" class="social-item-card">
              <div class="social-icon instagram">
                <i class="fa-brands fa-instagram"></i>
              </div>
              <div class="social-info">
                <span class="social-name">Instagram</span>
                <span class="social-handle">@eimresearchlab</span>
              </div>
            </a>
          )}

          {socials.linkedin && (
            <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class="social-item-card">
              <div class="social-icon linkedin">
                <i class="fa-brands fa-linkedin-in"></i>
              </div>
              <div class="social-info">
                <span class="social-name">LinkedIn</span>
                <span class="social-handle">EIM Research Lab</span>
              </div>
            </a>
          )}

          {socials.github && (
            <a href={socials.github} target="_blank" rel="noopener noreferrer" class="social-item-card">
              <div class="social-icon github">
                <i class="fa-brands fa-github"></i>
              </div>
              <div class="social-info">
                <span class="social-name">GitHub</span>
                <span class="social-handle">@eimresearchlab</span>
              </div>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
