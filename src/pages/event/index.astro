---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/cards/EventCard.astro';
import { getLocaleFromUrl, getCollectionEntriesForLocale, t } from '../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const rawEvents = await getCollection('events');
const events = getCollectionEntriesForLocale(rawEvents, locale);

const sortedEvents = events.sort((a, b) => {
  const timeA = new Date(a.data.event_date).getTime();
  const timeB = new Date(b.data.event_date).getTime();
  return isNaN(timeA) || isNaN(timeB) ? 0 : timeB - timeA;
});
---

<Layout title={`${t('events.title', locale)} - EIM Research Lab`}>
  <section class="page-header event-page-header">
    <div class="container">
      <div class="page-header-content">
        <h1>{t('events.title', locale)}</h1>
        <p class="event-page-subtitle">{t('events.subtitle', locale)}</p>
      </div>
    </div>
  </section>

  <section class="section-padding event-section-main">
    <div class="container">
      {sortedEvents.length === 0 ? (
        <div class="news-empty-state empty-state-box">
          <i class="fa-regular fa-folder-open empty-state-icon"></i>
          <h3>No Events Yet</h3>
          <p>No events or agendas have been published yet.</p>
        </div>
      ) : (
        <div class="news-grid" id="events-grid">
          {sortedEvents.map(event => (
            <EventCard event={event} />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
